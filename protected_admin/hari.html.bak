                                    <button type="button" onclick="saveMusicOnly('maintenance')" class="bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-widest text-white shadow-md shadow-emerald-600/20 flex items-center gap-1">
                                        <i data-lucide="save" class="w-3 h-3"></i>

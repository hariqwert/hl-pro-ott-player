                                        </div>
                                        <div class="grid grid-cols-3 gap-1 p-1 bg-black/60 rounded-xl border border-white/5 text-[9px] font-bold">
                                            <button type="button" onclick="setAdminSearchSource('saavn', 'maintenance')" id="btn_src_maintenance_saavn" class="flex-1 py-1.5 rounded-lg text-white bg-pink-600 font-bold transition-all">JioSaavn</button>

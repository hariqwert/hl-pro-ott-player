                                        <button type="button" onclick="searchAdminMusic('maintenance')" class="bg-pink-600 hover:bg-pink-500 px-4 rounded-xl font-bold text-xs text-white transition-all flex items-center gap-1.5 shadow-md shadow-pink-600/20">
                                            <i data-lucide="search" class="w-3.5 h-3.5"></i>
                                            <span>Search</span>
                                        </button>
                                    </div>
                                    <div id="maintenanceQuickTags" class="flex flex-wrap gap-1.5 pt-0.5">
                                        <button type="button" onclick="clickAdminTag('Lofi Chill', 'maintenance')" class="px-2.5 py-0.5 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-400 hover:text-white transition-all border border-white/5">Lofi Chill</button>
                                        <button type="button" onclick="clickAdminTag('Synthwave Relax', 'maintenance')" class="px-2.5 py-0.5 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-400 hover:text-white transition-all border border-white/5">Synthwave</button>
                                        <button type="button" onclick="clickAdminTag('Cyberpunk Ambient', 'maintenance')" class="px-2.5 py-0.5 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-400 hover:text-white transition-all border border-white/5">Cyberpunk</button>
                                        <button type="button" onclick="clickAdminTag('Arijit Singh', 'maintenance')" class="px-2.5 py-0.5 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-400 hover:text-white transition-all border border-white/5">Arijit Singh</button>
                                        <button type="button" onclick="clickAdminTag('Top Hits', 'maintenance')" class="px-2.5 py-0.5 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-400 hover:text-white transition-all border border-white/5">Top Hits</button>
                                    </div>
                                </div>

                                <!-- Maintenance Audio Preview Deck -->
                                <div class="p-3.5 rounded-xl bg-black/50 border border-white/5 space-y-3">
                                    <div class="flex items-center gap-3">
                                        <button type="button" id="adminPlayBtn" onclick="toggleAdminMusic('maintenance')" class="w-9 h-9 rounded-full bg-pink-500 hover:bg-pink-400 text-black flex items-center justify-center transition-all cursor-pointer shadow-lg shadow-pink-500/20 flex-shrink-0">
                                            <i data-lucide="play" class="w-4 h-4 fill-black text-black" id="adminPlayIcon"></i>
                                            <i data-lucide="pause" class="w-4 h-4 hidden text-black" id="adminPauseIcon"></i>
                                        </button>
                                        <div class="flex-1 overflow-hidden">
                                            <div id="adminMusicTitle" class="text-xs font-bold text-slate-100 truncate">No Track Loaded</div>
                                            <div id="adminMusicArtist" class="text-[10px] text-slate-400 truncate">Search songs or choose a playlist track</div>
                                        </div>
                                        <!-- Volume Hub -->
                                        <div class="flex items-center gap-2 bg-zinc-900/80 px-2.5 py-1.5 rounded-xl border border-white/5 flex-shrink-0">
                                            <button type="button" onclick="toggleAdminMute('admin')" class="text-slate-400 hover:text-white transition-colors">
                                                <i data-lucide="volume-2" class="w-3.5 h-3.5" id="adminVolIcon"></i>
                                            </button>
                                            <input type="range" id="adminVolSlider" min="0" max="1" step="0.05" value="1" oninput="setAdminVolume(this.value, 'admin')" class="w-14 accent-pink-500 h-1 rounded-full cursor-pointer bg-white/10">
                                        </div>
                                    </div>

                                    <!-- Progress Timeline Seeker Bar -->
                                    <div class="flex items-center gap-2">
                                        <span id="adminCurTime" class="text-[9px] font-mono text-slate-500 font-bold w-7 text-left">0:00</span>
                                        <div class="flex-1 h-1.5 bg-white/10 rounded-full cursor-pointer relative overflow-hidden" onclick="seekAdminAudio(event, 'admin')">
                                            <div id="adminProgressBar" class="h-full bg-gradient-to-r from-pink-500 to-indigo-500 rounded-full w-0 transition-all duration-100"></div>
                                        </div>
                                        <span id="adminTotDur" class="text-[9px] font-mono text-slate-500 font-bold w-7 text-right">0:00</span>
                                    </div>

                                    <!-- Visualizer Canvas -->
                                    <div class="relative h-12 w-full bg-black/60 rounded-xl overflow-hidden border border-white/5">
                                        <canvas id="adminVisualizer" class="absolute inset-0 w-full h-full"></canvas>
                                    </div>

                                    <!-- Search Results Dropdown / Container -->
                                    <div id="adminMusicResults" class="max-h-36 overflow-y-auto space-y-1 custom-scrollbar hidden bg-zinc-950/90 p-2 rounded-xl border border-white/10 text-xs text-slate-300"></div>

                                    <!-- Saved Playlist Queue -->
                                    <div class="space-y-2 pt-2 border-t border-white/5">
                                        <div class="flex items-center justify-between">
                                            <span class="text-[9px] font-black text-slate-300 uppercase tracking-widest block flex items-center gap-1.5">
                                                <i data-lucide="list-music" class="w-3.5 h-3.5 text-pink-400"></i>
                                                <span>Saved Maintenance Playlist Queue</span>
                                            </span>
                                            <span id="adminPlaylistCountBadge" class="text-[8px] text-pink-400 font-mono bg-pink-500/10 px-2 py-0.5 rounded border border-pink-500/20 font-bold">0 Tracks</span>
                                        </div>
                                        <div id="adminSavedPlaylist" class="max-h-36 overflow-y-auto space-y-1 custom-scrollbar bg-zinc-950/70 p-2 rounded-xl border border-white/5">
                                            <div class="text-slate-500 text-center py-2 text-[10px]">No saved tracks in queue. Search and click + to add tracks.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- MAINTENANCE 503 FULLSCREEN VIDEO BROADCAST STUDIO -->
                            <div class="mt-6 pt-6 border-t border-gray-800 space-y-4">
                                <div class="flex items-center justify-between flex-wrap gap-2">
                                    <div class="flex items-center gap-2.5">
                                        <div class="p-2 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400">
                                            <i data-lucide="tv-2" class="w-4 h-4"></i>
                                        </div>
                                        <div>
                                            <label class="text-xs font-black text-white block flex items-center gap-2">
                                                <span>Auto Video Broadcast (Full Screen)</span>
                                                <span class="px-1.5 py-0.5 rounded bg-red-500/20 border border-red-500/40 text-red-300 text-[8px] font-mono font-bold uppercase animate-pulse">AUTO-PLAY</span>
                                            </label>
                                            <span class="text-[10px] text-gray-400">Plays video, M3U stream, YouTube, Twitter/X, Facebook, local video, or website full screen automatically during maintenance</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <button type="button" onclick="startLiveVideoBroadcastNow()" class="bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 px-3.5 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-widest text-white shadow-lg shadow-red-600/30 flex items-center gap-1.5 cursor-pointer transition-all hover:scale-105 active:scale-95" title="Instantly start or update live video broadcast across all viewers without reloading">
                                            <span class="relative flex h-2 w-2">
                                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-80"></span>
                                                <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
                                            </span>
                                            <span>Go Live Now</span>
                                        </button>
                                        <button type="button" onclick="saveVideoBroadcastOnly()" class="bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-widest text-slate-200 hover:text-white shadow-md flex items-center gap-1 cursor-pointer">
                                            <i data-lucide="save" class="w-3 h-3"></i>
                                            <span>Save Video</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Master Toggle for Video Broadcast -->
                                <div class="flex items-center justify-between p-3.5 rounded-xl bg-gray-900/50 border border-gray-800">
                                    <div class="flex items-center gap-3">
                                        <div class="p-2 rounded-lg bg-red-500/10 text-red-400">
                                            <i data-lucide="video" class="w-4 h-4"></i>
                                        </div>
                                        <div>
                                            <p class="font-bold text-xs text-white">Enable Fullscreen Video Playback</p>
                                            <p class="text-[10px] text-gray-400">Opens full-screen video player automatically on page load with close & minimize controls.</p>
                                        </div>
                                    </div>
                                    <label class="relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" id="maintenanceVideoEnabledToggle" class="sr-only peer">
                                        <div class="w-11 h-6 bg-gray-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-gray-300 after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-500"></div>
                                    </label>
                                </div>

                                <!-- Video Source Type & URL Configuration -->
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                    <div>
                                        <div class="flex items-center justify-between">
                                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Stream / Media Type</label>
                                        </div>
                                        <select id="maintenanceVideoType" onchange="handleVideoTypeChange()" class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-xs text-white outline-none mt-1 transition-all">
                                            <option value="auto">Auto Detect (Smart Resolver)</option>
                                            <option value="youtube">YouTube (Video / Live / Short)</option>
                                            <option value="twitter">Twitter / X Post Video</option>
                                            <option value="facebook">Facebook Video / Live</option>
                                            <option value="m3u">M3U / M3U8 Live Stream (HLS)</option>
                                            <option value="webrtc">WebRTC Live Broadcast (Camera/Mic)</option>
                                            <option value="direct">Direct Video (MP4 / WEBM / MKV / MOV)</option>
                                            <option value="website">Embedded Website / Webpage</option>
                                        </select>
                                        <button type="button" onclick="selectWebRTCBroadcast()" class="w-full mt-2 py-2 px-3 rounded-xl bg-blue-600/20 hover:bg-blue-600/40 text-blue-300 border border-blue-500/30 text-xs font-bold flex items-center justify-center gap-2 transition-all">
                                            <i data-lucide="radio" class="w-4 h-4 text-blue-400"></i>
                                            <span>WebRTC Live Studio</span>
                                        </button>
                                    </div>
                                    <div class="md:col-span-2">
                                        <div id="standardUrlInputBlock">
                                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Video Stream URL / Embed Link</label>
                                            <div class="flex gap-2 mt-1">
                                                <input type="text" id="maintenanceVideoUrl" placeholder="https://www.youtube.com/watch?v=... or .m3u8, .mp4, x.com, facebook.com URL"
                                                    class="flex-1 bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-xs text-white outline-none transition-all font-mono"
                                                    oninput="handleVideoUrlInput(this.value)">
                                                <button type="button" onclick="previewAdminBroadcastVideo()" class="bg-red-500/20 hover:bg-red-500 text-red-300 hover:text-white px-3.5 rounded-xl font-bold text-xs transition-all flex items-center gap-1 border border-red-500/30 shrink-0" title="Preview Stream">
                                                    <i data-lucide="play" class="w-3.5 h-3.5"></i>
                                                    <span>Preview</span>
                                                </button>
                                            </div>
                                        </div>
                                        
                                        <!-- WebRTC Specialized UI -->
                                        <div id="webrtcStudioBlock" class="hidden mt-1">
                                            <div class="border border-blue-500/40 bg-gradient-to-br from-blue-950/50 via-gray-900 to-black rounded-2xl p-4 shadow-xl space-y-3.5">
                                                <!-- Header & Studio Controls -->
                                                <div class="flex flex-wrap items-center justify-between border-b border-blue-500/20 pb-3 gap-2">
                                                    <div class="flex items-center gap-2.5">
                                                        <span class="w-3 h-3 rounded-full bg-blue-500 animate-pulse shadow-lg shadow-blue-500/50"></span>
                                                        <div>
                                                            <h4 class="text-white font-bold text-sm tracking-wide flex items-center gap-2">
                                                                WebRTC Live Broadcast Studio
                                                                <span id="webrtcInlineStatusBadge" class="text-[9px] uppercase px-2 py-0.5 rounded-full font-bold bg-yellow-500/20 text-yellow-300 border border-yellow-500/30">Ready to Go Live</span>
                                                            </h4>
                                                            <p class="text-[11px] text-blue-200/70">Ultra-low latency HD camera, microphone, and screen transmission to maintenance visitors.</p>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <button type="button" onclick="detectWebRTCDevices(false, true)" class="px-2.5 py-1.5 rounded-xl bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white text-xs font-semibold transition-all border border-gray-700 flex items-center gap-1.5" title="Re-scan connected cameras and microphones">
                                                            <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-blue-400"></i>
                                                            <span class="hidden sm:inline">Scan Hardware</span>
                                                        </button>
                                                        <button type="button" onclick="window.openWebRTCStudio()" class="px-3 py-1.5 rounded-xl bg-blue-600/30 hover:bg-blue-600/50 text-blue-300 hover:text-white text-xs font-bold transition-all border border-blue-500/40 flex items-center gap-1.5" title="Expand Full Studio">
                                                            <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
                                                            <span class="hidden sm:inline">Fullscreen Studio</span>
                                                        </button>
                                                        <button type="button" onclick="document.getElementById('maintenanceVideoType').value='auto'; handleVideoTypeChange();" class="px-2.5 py-1.5 rounded-xl bg-gray-800 hover:bg-gray-700 text-gray-400 hover:text-white text-xs font-medium transition-all" title="Return to URL input">
                                                            Switch to URL
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- Hardware Detection Diagnostic Bar -->
                                                <div class="p-2.5 rounded-xl bg-black/60 border border-blue-500/20 flex flex-wrap items-center justify-between gap-2 text-xs">
                                                    <div class="flex items-center gap-3">
                                                        <!-- Camera Detection Badge -->
                                                        <div class="flex items-center gap-1.5">
                                                            <span class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Camera:</span>
                                                            <span id="webrtcInlineCamDetectBadge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                                                <span id="webrtcInlineCamDetectName">Detecting Camera...</span>
                                                            </span>
                                                        </div>
                                                        <!-- Mic Detection Badge -->
                                                        <div class="flex items-center gap-1.5">
                                                            <span class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Microphone:</span>
                                                            <span id="webrtcInlineMicDetectBadge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                                                <span id="webrtcInlineMicDetectName">Detecting Mic...</span>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <!-- Live Quality Selector -->
                                                    <div class="flex items-center gap-2">
                                                        <label class="text-[10px] text-gray-400 font-bold uppercase">Quality:</label>
                                                        <select id="webrtcInlineQualitySelect" onchange="changeWebRTCQuality(this.value)" class="bg-gray-900 border border-blue-500/40 text-blue-200 text-xs rounded-lg px-2 py-1 font-medium focus:ring-1 focus:ring-blue-500 outline-none">
                                                            <option value="720p" selected>720p HD (Optimal • 2.2 Mbps)</option>
                                                            <option value="1080p">1080p FHD (Crystal • 3.5 Mbps)</option>
                                                            <option value="480p">480p SD (Smooth • 1.0 Mbps)</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <!-- Live Stage & Controls Grid -->
                                                <div class="grid grid-cols-1 lg:grid-cols-12 gap-3.5">
                                                    <!-- Video Preview Screen -->
                                                    <div class="lg:col-span-7 xl:col-span-8 bg-black rounded-2xl overflow-hidden relative aspect-video flex items-center justify-center border border-blue-500/30 shadow-inner group">
                                                        <video id="webrtcInlineVideo" autoplay muted playsinline class="w-full h-full object-cover hidden"></video>
                                                        
                                                        <div id="webrtcInlinePlaceholder" class="text-center p-4">
                                                            <div class="w-12 h-12 rounded-full bg-blue-500/10 border border-blue-500/20 flex items-center justify-center mx-auto mb-2 text-blue-400">
                                                                <i data-lucide="video" class="w-6 h-6"></i>
                                                            </div>
                                                            <p class="text-white text-xs font-bold">Camera & Mic Ready to Connect</p>
                                                            <p class="text-gray-400 text-[10px] mt-0.5">Click below to initialize camera preview and audio meter</p>
                                                            <button type="button" onclick="initWebRTCDevices()" class="mt-2.5 px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-[11px] font-bold transition-all shadow-md flex items-center gap-1.5 mx-auto">
                                                                <i data-lucide="camera" class="w-3.5 h-3.5"></i>
                                                                <span>Connect Hardware</span>
                                                            </button>
                                                        </div>

                                                        <!-- Preview HUD Top Badges -->
                                                        <div class="absolute top-2 left-2 flex items-center gap-1.5 pointer-events-none">
                                                            <span id="webrtcInlineResBadge" class="hidden px-2 py-0.5 rounded-md bg-black/75 backdrop-blur-sm border border-white/20 text-[10px] font-mono text-emerald-400 font-bold">
                                                                1280x720 • 30fps
                                                            </span>
                                                            <span id="webrtcInlineShareBadge" class="hidden px-2 py-0.5 rounded-md bg-purple-600/90 backdrop-blur-sm border border-purple-400/40 text-[10px] font-bold text-white uppercase">
                                                                🖥️ SCREEN SHARE
                                                            </span>
                                                        </div>

                                                        <!-- Overlay stream controls -->
                                                        <div class="absolute bottom-2.5 left-0 w-full flex flex-wrap justify-center items-center gap-1.5 px-2">
                                                            <button type="button" id="btnToggleInlineCam" onclick="window.toggleWebrtcCam()" class="px-2.5 py-1.5 rounded-lg bg-black/80 hover:bg-black text-white text-xs font-medium flex items-center gap-1.5 border border-white/20 backdrop-blur-sm transition-all" title="Toggle Camera">
                                                                <i id="iconInlineCam" data-lucide="video" class="w-3.5 h-3.5 text-blue-400"></i>
                                                                <span>Cam</span>
                                                            </button>
                                                            <button type="button" id="btnToggleInlineMic" onclick="window.toggleWebrtcMic()" class="px-2.5 py-1.5 rounded-lg bg-black/80 hover:bg-black text-white text-xs font-medium flex items-center gap-1.5 border border-white/20 backdrop-blur-sm transition-all" title="Toggle Microphone">
                                                                <i id="iconInlineMic" data-lucide="mic" class="w-3.5 h-3.5 text-blue-400"></i>
                                                                <span>Mic</span>
                                                            </button>
                                                            <button type="button" id="btnToggleInlineShare" onclick="window.toggleWebRTCScreenShare()" class="px-2.5 py-1.5 rounded-lg bg-black/80 hover:bg-purple-900/60 text-white text-xs font-medium flex items-center gap-1.5 border border-white/20 backdrop-blur-sm transition-all" title="Share Screen or App Window">
                                                                <i id="iconInlineShare" data-lucide="monitor" class="w-3.5 h-3.5 text-purple-400"></i>
                                                                <span>Share Screen</span>
                                                            </button>
                                                            <button type="button" id="btnToggleInlineMirror" onclick="window.toggleWebRTCMirror()" class="px-2.5 py-1.5 rounded-lg bg-black/80 hover:bg-black text-gray-300 hover:text-white text-xs font-medium flex items-center gap-1 border border-white/20 backdrop-blur-sm transition-all" title="Mirror Camera Preview">
                                                                <i data-lucide="flip-horizontal" class="w-3.5 h-3.5 text-blue-400"></i>
                                                                <span class="hidden sm:inline">Mirror</span>
                                                            </button>
                                                        </div>
                                                    </div>

                                                    <!-- Quick Control Dashboard -->
                                                    <div class="lg:col-span-5 xl:col-span-4 flex flex-col justify-between space-y-2.5 bg-black/50 border border-white/10 rounded-2xl p-3.5">
                                                        <div class="space-y-2.5">
                                                            <!-- Camera Selection -->
                                                            <div>
                                                                <label class="flex justify-between items-center text-[10px] text-gray-400 uppercase font-bold tracking-wider mb-1">
                                                                    <span>Select Camera</span>
                                                                    <span id="webrtcInlineCamCount" class="text-[9px] text-blue-400 lowercase font-normal">1 detected</span>
                                                                </label>
                                                                <select id="webrtcInlineVideoSource" onchange="switchWebRTCCamera(this.value)" class="w-full bg-gray-900 border border-gray-700 rounded-lg p-2 text-xs text-white focus:border-blue-500 outline-none">
                                                                    <option value="">Default Camera</option>
                                                                </select>
                                                            </div>

                                                            <!-- Microphone Selection & Live Audio VU Meter -->
                                                            <div>
                                                                <label class="flex justify-between items-center text-[10px] text-gray-400 uppercase font-bold tracking-wider mb-1">
                                                                    <span>Select Microphone</span>
                                                                    <span id="webrtcInlineMicCount" class="text-[9px] text-blue-400 lowercase font-normal">1 detected</span>
                                                                </label>
                                                                <select id="webrtcInlineAudioSource" onchange="switchWebRTCMic(this.value)" class="w-full bg-gray-900 border border-gray-700 rounded-lg p-2 text-xs text-white focus:border-blue-500 outline-none">
                                                                    <option value="">Default Microphone</option>
                                                                </select>
                                                                
                                                                <!-- Live VU Meter (Mic Voice Detection Bar) -->
                                                                <div class="mt-1.5 p-2 rounded-lg bg-gray-900/80 border border-gray-800 space-y-1">
                                                                    <div class="flex justify-between items-center text-[10px]">
                                                                        <span class="text-gray-400 flex items-center gap-1">
                                                                            <i data-lucide="volume-2" class="w-3 h-3 text-emerald-400"></i>
                                                                            <span>Mic Input Level:</span>
                                                                        </span>
                                                                        <span id="webrtcInlineVUText" class="text-emerald-400 font-bold font-mono">Silent (0%)</span>
                                                                    </div>
                                                                    <div class="h-2 w-full bg-gray-950 rounded-full overflow-hidden border border-white/5">
                                                                        <div id="webrtcInlineVUBars" class="h-full bg-emerald-400 transition-all duration-75 w-0 rounded-full"></div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- Telemetry & Stream Health Card -->
                                                            <div class="p-2.5 rounded-lg bg-blue-950/30 border border-blue-500/20 text-[10px] space-y-1">
                                                                <div class="flex justify-between text-gray-300">
                                                                    <span>Status:</span>
                                                                    <span id="webrtcInlineLiveStatus" class="text-yellow-400 font-bold">Standby</span>
                                                                </div>
                                                                <div class="flex justify-between text-gray-300">
                                                                    <span>Target Bitrate:</span>
                                                                    <span id="webrtcInlineBitrate" class="text-white font-mono">720P (~2200 kbps)</span>
                                                                </div>
                                                                <div class="flex justify-between text-gray-300">
                                                                    <span>Protocol:</span>
                                                                    <span class="text-blue-300 font-mono">WebRTC P2P + Adaptive Relay</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Go Live Button -->
                                                        <div class="pt-1">
                                                            <button type="button" id="btnStartWebRTCInline" onclick="window.startWebRTCBroadcast()" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-all shadow-lg shadow-blue-500/30">
                                                                <i data-lucide="radio" class="w-4 h-4 text-white animate-pulse"></i>
                                                                <span>Start WebRTC Broadcast</span>
                                                            </button>
                                                            <button type="button" id="btnStopWebRTCInline" onclick="window.stopWebRTCBroadcast()" class="hidden w-full py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-all shadow-lg shadow-red-500/30">
                                                                <i data-lucide="square" class="w-4 h-4 text-white"></i>
                                                                <span>End WebRTC Broadcast</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- FULL-WIDTH INTERACTIVE LIVE CONFERENCE & CO-HOST STAGE MANAGER -->
                                                <div class="mt-4 p-4 rounded-2xl bg-slate-900/95 border border-cyan-500/30 shadow-2xl space-y-3.5">
                                                    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-cyan-500/20">
                                                        <div class="flex items-center gap-2.5">
                                                            <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-md shadow-cyan-500/20">
                                                                <i data-lucide="users" class="w-4 h-4"></i>
                                                            </div>
                                                            <div>
                                                                <div class="flex items-center gap-2">
                                                                    <span class="text-white text-sm font-bold tracking-wide">Video Conference & Co-Hosts Stage</span>
                                                                    <span id="adminConferenceBadge" class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-gray-800 text-gray-400 border border-gray-700">Disabled</span>
                                                                </div>
                                                                <p class="text-[11px] text-gray-400">Allow viewers to request face-to-face conference talk or private 1-on-1 consultation.</p>
                                                            </div>
                                                        </div>
                                                        <div class="flex items-center gap-3 bg-black/40 px-3 py-1.5 rounded-xl border border-white/10">
                                                            <span id="adminConferenceToggleLabel" class="text-xs font-bold text-gray-300">Allow Requests</span>
                                                            <label class="relative inline-flex items-center cursor-pointer">
                                                                <input type="checkbox" id="adminConferenceToggle" onchange="window.toggleAdminConference(this.checked)" class="sr-only peer">
                                                                <div class="w-11 h-6 bg-gray-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gradient-to-r peer-checked:from-cyan-500 peer-checked:to-blue-600 border border-gray-700"></div>
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <!-- 3-Column Responsive Interactive Grid -->
                                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
                                                        <!-- 1. Stage Requests Queue -->
                                                        <div class="bg-black/50 border border-gray-800 rounded-xl p-3 flex flex-col space-y-2">
                                                            <div class="flex items-center justify-between text-xs pb-1.5 border-b border-gray-800/80">
                                                                <span class="text-gray-300 font-semibold flex items-center gap-1.5">
                                                                    <i data-lucide="user-plus" class="w-3.5 h-3.5 text-cyan-400"></i>
                                                                    <span>Stage Requests</span>
                                                                    <span id="adminPendingCountBadge" class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/40">0</span>
                                                                </span>
                                                                <span class="text-[9px] text-gray-500">Auto-refreshes</span>
                                                            </div>
                                                            <div id="adminPendingRequestsList" class="space-y-1.5 max-h-52 overflow-y-auto pr-1 flex-1">
                                                                <div class="p-3 rounded-lg bg-black/40 border border-dashed border-gray-800 text-center text-gray-500 text-xs">
                                                                    No pending join requests from viewers right now.
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- 2. Active Co-Hosts & Guests -->
                                                        <div class="bg-black/50 border border-gray-800 rounded-xl p-3 flex flex-col space-y-2">
                                                            <div class="flex items-center justify-between text-xs pb-1.5 border-b border-gray-800/80">
                                                                <span class="text-gray-300 font-semibold flex items-center gap-1.5">
                                                                    <i data-lucide="video" class="w-3.5 h-3.5 text-emerald-400"></i>
                                                                    <span>Active on Stage</span>
                                                                    <span id="adminActiveCountBadge" class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">0</span>
                                                                </span>
                                                                <span class="text-[9px] text-cyan-400 font-medium">Layout adapts live</span>
                                                            </div>
                                                            <div id="adminActiveParticipantsList" class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-52 overflow-y-auto pr-1 flex-1">
                                                                <div class="col-span-full p-3 rounded-lg bg-black/40 border border-dashed border-gray-800 text-center text-gray-500 text-xs">
                                                                    Only Admin is currently on stage. Approved guests will appear here with live video & mute controls.
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- 3. Conference Live Chat & Private DMs -->
                                                        <div class="bg-black/50 border border-gray-800 rounded-xl p-3 flex flex-col space-y-2">
                                                            <div class="flex items-center justify-between text-xs pb-1.5 border-b border-gray-800/80">
                                                                <div class="flex items-center gap-1.5">
                                                                    <button type="button" onclick="window.switchAdminChatTab('all')" id="btnAdminChatTabAll" class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-blue-600 text-white transition-all">All Messages</button>
                                                                    <button type="button" onclick="window.switchAdminChatTab('private')" id="btnAdminChatTabPrivate" class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-gray-800 text-gray-400 hover:text-white transition-all flex items-center gap-1">
                                                                        <span>🔒 Private (1-on-1)</span>
                                                                        <span id="adminPrivateMsgBadge" class="hidden w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse"></span>
                                                                    </button>
                                                                </div>
                                                                <span class="text-[9px] text-gray-500">Live Chat</span>
                                                            </div>
                                                            <div id="adminChatFeed" class="h-32 overflow-y-auto p-2 rounded-lg bg-black/60 border border-gray-800 text-xs space-y-1.5 flex-1">
                                                                <div class="text-xs text-gray-500 text-center py-4">No chat messages yet.</div>
                                                            </div>
                                                            <div class="flex gap-1.5 pt-1">
                                                                <input type="text" id="adminChatInput" placeholder="Broadcast chat or reply..." onkeydown="if(event.key==='Enter') window.sendAdminChatMessage();" class="flex-1 bg-gray-900 border border-gray-700 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-gray-500 focus:border-blue-500 outline-none">
                                                                <button type="button" onclick="window.sendAdminChatMessage()" class="px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition-all flex items-center gap-1 flex-shrink-0">
                                                                    <span>Send</span>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Quick Preset Streams -->
                                <div class="space-y-1">
                                    <div class="text-[9px] font-bold text-gray-500 uppercase tracking-widest ml-1">Quick Presets & Live Demos:</div>
                                    <div class="flex flex-wrap gap-1.5">
                                        <button type="button" onclick="selectWebRTCBroadcast()" class="px-2.5 py-1 rounded-lg bg-blue-600/30 hover:bg-blue-600/50 text-[9px] font-bold text-blue-300 hover:text-white transition-all border border-blue-500/40 flex items-center gap-1">🎙️ WebRTC Live Studio</button>
                                        <button type="button" onclick="setVideoPreset('https://www.youtube.com/watch?v=jfKfPfyJRdk', 'youtube', 'Lofi Girl 24/7 Live Stream', 'Relaxing Beats & Music')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-red-500/20 hover:border-red-500/40 text-[9px] font-bold text-slate-300 hover:text-white transition-all border border-white/5">🔴 Lofi Girl (YouTube)</button>
                                        <button type="button" onclick="setVideoPreset('https://www.youtube.com/watch?v=21X5lGlDOfg', 'youtube', 'NASA Space Station Live', 'Earth from Orbit Feed')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-red-500/20 hover:border-red-500/40 text-[9px] font-bold text-slate-300 hover:text-white transition-all border border-white/5">🚀 NASA Live (YouTube)</button>
                                        <button type="button" onclick="setVideoPreset('https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4', 'direct', '4K Ultra HD Showcase', 'Master Video Stream')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-red-500/20 hover:border-red-500/40 text-[9px] font-bold text-slate-300 hover:text-white transition-all border border-white/5">🎬 Sample MP4 Video</button>
                                        <button type="button" onclick="setVideoPreset('https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8', 'm3u', 'HLS Test Live Stream', 'Multi-bitrate M3U8')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-red-500/20 hover:border-red-500/40 text-[9px] font-bold text-slate-300 hover:text-white transition-all border border-white/5">📡 Test M3U8 Stream</button>
                                    </div>
                                </div>

                                <!-- Local Video / M3U File Upload Zone -->
                                <div class="p-4 rounded-xl bg-black/40 border border-dashed border-gray-700 hover:border-red-500/50 transition-all space-y-3">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <i data-lucide="upload-cloud" class="w-4 h-4 text-red-400"></i>
                                            <span class="text-xs font-bold text-white">Upload Local Video or M3U Playlist File</span>
                                        </div>
                                        <span class="text-[9px] text-gray-400">Supports .mp4, .webm, .mkv, .mov, .m3u, .m3u8 (Up to 500MB)</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <input type="file" id="maintenanceVideoFileInput" accept="video/*,.m3u,.m3u8,.ts,.mp4,.webm,.mkv,.mov" class="hidden" onchange="handleAdminVideoFileUpload(event)">
                                        <button type="button" onclick="document.getElementById('maintenanceVideoFileInput').click()" class="bg-gray-800 hover:bg-gray-700 text-slate-200 hover:text-white px-4 py-2 rounded-xl text-xs font-bold transition-all border border-gray-700 flex items-center gap-2 cursor-pointer">
                                            <i data-lucide="file-video" class="w-4 h-4 text-red-400"></i>
                                            <span>Choose Video / M3U File</span>
                                        </button>
                                        <div id="videoUploadStatus" class="text-[11px] text-gray-400 font-medium truncate flex-1">
                                            No file uploaded. Select a file or paste URL above.
                                        </div>
                                    </div>
                                </div>

                                <!-- Broadcast Overlay Titles & Playback Customization -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    <div>
                                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Overlay Banner Title</label>
                                        <input type="text" id="maintenanceVideoTitle" placeholder="e.g. 🔴 EMERGENCY BROADCAST / SYSTEM UPDATE"
                                            class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-xs text-white outline-none mt-1 transition-all">
                                    </div>
                                    <div>
                                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Overlay Banner Subtitle</label>
                                        <input type="text" id="maintenanceVideoSubtitle" placeholder="e.g. Live transmission in progress during maintenance"
                                            class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-xs text-white outline-none mt-1 transition-all">
                                    </div>
                                </div>

                                <!-- Playback Options (Autoplay, Mute, Loop) -->
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                                    <div class="flex items-center justify-between p-3 rounded-xl bg-gray-900/40 border border-gray-800">
                                        <span class="text-xs font-bold text-slate-300">Autoplay</span>
                                        <input type="checkbox" id="maintenanceVideoAutoplay" checked class="w-4 h-4 accent-red-500 rounded cursor-pointer">
                                    </div>
                                    <div class="flex items-center justify-between p-3 rounded-xl bg-gray-900/40 border border-gray-800">
                                        <span class="text-xs font-bold text-slate-300">Start Muted</span>
                                        <input type="checkbox" id="maintenanceVideoMuted" class="w-4 h-4 accent-red-500 rounded cursor-pointer">
                                    </div>
                                    <div class="flex items-center justify-between p-3 rounded-xl bg-gray-900/40 border border-gray-800">
                                        <span class="text-xs font-bold text-slate-300">Continuous Loop</span>
                                        <input type="checkbox" id="maintenanceVideoLoop" checked class="w-4 h-4 accent-red-500 rounded cursor-pointer">
                                    </div>
                                </div>

                                <!-- Admin Live Interactive Video Preview Container -->
                                <div id="adminVideoPreviewBox" class="hidden p-3.5 rounded-2xl bg-black/80 border border-red-500/30 space-y-2.5">
                                    <div class="flex items-center justify-between">
                                        <span class="text-[10px] font-bold text-red-400 uppercase tracking-widest flex items-center gap-1.5">
                                            <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
                                            <span>Live Broadcast Preview</span>
                                        </span>
                                        <button type="button" onclick="closeAdminVideoPreview()" class="text-gray-400 hover:text-white text-xs font-bold p-1 rounded-lg hover:bg-white/10 transition-colors">
                                            ✕ Close Preview
                                        </button>
                                    </div>
                                    <div id="adminVideoPlayerFrame" class="w-full aspect-video rounded-xl overflow-hidden bg-black flex items-center justify-center border border-white/10 relative">
                                        <!-- Dynamic Preview Injected Here -->
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="w-full bg-amber-600 hover:bg-amber-700 py-3.5 rounded-xl font-bold text-xs text-white transition-all flex items-center justify-center gap-2 shadow-lg shadow-amber-600/20 mt-4">
                                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                                <span>Apply Maintenance State</span>
                            </button>
                        </form>
                    </div>
                     <!-- SITE LOCK MODE CONFIG -->
                     <div class="glass-card rounded-2xl p-6 border border-gray-800 space-y-6">
                         <div class="flex items-center justify-between">
                             <div>
                                 <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                     <i data-lucide="lock" class="w-5 h-5 text-cyan-400"></i>
                                     <span>Site Lock Mode (Passcode Gate)</span>
                                 </h3>
                                 <p class="text-xs text-gray-400 mt-1">Locks the entire website behind a passcode. Visitors must enter the PIN/password to see and access content.</p>
                             </div>
                             <span id="siteLockStatusBadge" class="px-2.5 py-1 rounded-lg bg-gray-800 border border-gray-700 text-[10px] font-bold text-gray-400 uppercase tracking-widest">
                                 Inactive
                             </span>
                         </div>
                         <form id="siteLockForm" onsubmit="saveSiteLockSettings(event)" class="space-y-5">
                             <div class="flex items-center justify-between p-4 rounded-xl bg-gray-900/40 border border-gray-800">
                                 <div class="flex items-center gap-3">
                                     <div class="p-2.5 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400">
                                         <i data-lucide="shield-check" class="w-5 h-5"></i>
                                     </div>
                                     <div>
                                         <p class="font-bold text-sm text-white">Lock Mode Active</p>
                                         <p class="text-[11px] text-gray-500">When enabled, visitors must authenticate before website content is delivered.</p>
                                     </div>
                                 </div>
                                 <label class="relative inline-flex items-center cursor-pointer">
                                     <input type="checkbox" id="siteLockToggle" onchange="handleSiteLockToggleInstant(this.checked)" class="sr-only peer">
                                     <div class="w-11 h-6 bg-gray-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-gray-300 after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-500"></div>
                                 </label>
                             </div>

                             <div>
                                 <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Unlock Passcode / PIN</label>
                                 <div class="relative mt-1">
                                     <input type="password" id="siteLockPasswordInput" placeholder="e.g. 1857 or secretpass" required
                                         class="w-full bg-gray-900/60 border border-gray-800 focus:border-cyan-500 rounded-xl p-3.5 text-sm text-white outline-none font-mono transition-all pr-10">
                                     <button type="button" onclick="toggleAdminLockPassReveal()" class="absolute right-3.5 top-3.5 text-gray-500 hover:text-gray-300 transition-colors">
                                         <i id="adminLockPassEye" data-lucide="eye" class="w-4 h-4"></i>
                                     </button>
                                 </div>
                                 <p class="text-[11px] text-gray-500 mt-1">The security code visitors must type into the lock screen.</p>
                             </div>

                             <div>
                                 <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Lock Screen Title</label>
                                 <input type="text" id="siteLockTitleInput" placeholder="e.g. RESTRICTED ACCESS PORTAL"
                                     class="w-full bg-gray-900/60 border border-gray-800 focus:border-cyan-500 rounded-xl p-3.5 text-sm text-white outline-none mt-1 transition-all">
                             </div>

                             <div>
                                 <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Lock Screen Message</label>
                                 <textarea id="siteLockMessageInput" rows="2" placeholder="e.g. This portal is secured by Quantum Lock. Please enter the authorized passcode to continue."
                                     class="w-full bg-gray-900/60 border border-gray-800 focus:border-cyan-500 rounded-xl p-3.5 text-sm text-white outline-none mt-1 transition-all resize-none"></textarea>
                             </div>

                             <div>
                                 <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Optional Passcode Hint (Visible to visitors)</label>
                                 <input type="text" id="siteLockHintInput" placeholder="e.g. Default PIN is 1857"
                                     class="w-full bg-gray-900/60 border border-gray-800 focus:border-cyan-500 rounded-xl p-3.5 text-sm text-white outline-none mt-1 transition-all">
                             </div>

                             <div class="flex items-center gap-3 pt-2">
                                 <button type="submit" class="flex-1 bg-cyan-600 hover:bg-cyan-500 text-gray-950 font-bold py-3.5 rounded-xl text-xs uppercase tracking-widest transition-all shadow-lg shadow-cyan-600/20 flex items-center justify-center gap-2 cursor-pointer">
                                     <i data-lucide="save" class="w-4 h-4"></i>
                                     <span>Save & Apply Lock Mode</span>
                                 </button>
                                 <button type="button" onclick="testLockScreenDirect()" class="bg-gray-800 hover:bg-gray-700 text-white font-bold py-3.5 px-4 rounded-xl text-xs flex items-center gap-2 border border-gray-700 transition-all cursor-pointer" title="Preview Lock Screen">
                                     <i data-lucide="external-link" class="w-4 h-4"></i>
                                     <span>Preview</span>
                                 </button>
                             </div>
                         </form>
                     </div>

                    <!-- DEVELOPER MODE CONFIG -->
                    <div class="glass-card rounded-2xl p-6 border border-gray-800 space-y-6">
                        <div>
                            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                <i data-lucide="code" class="w-5 h-5 text-indigo-500"></i>
                                <span>Developer Mode</span>
                            </h3>
                            <p class="text-xs text-gray-400 mt-1">Locks out external IPs entirely. Only whitelisted IPs can access.</p>
                        </div>
                        <div class="space-y-5">
                            <div class="flex items-center justify-between p-4 rounded-xl bg-gray-900/40 border border-gray-800">
                                <div class="flex items-center gap-3">
                                    <div class="p-2.5 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400">
                                        <i data-lucide="terminal" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <p class="font-bold text-sm text-white">Developer Mode Active</p>
                                        <p class="text-[11px] text-gray-500">Only allowed IPs can connect</p>
                                    </div>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="developerModeToggle" onchange="toggleDeveloperMode(this.checked)" class="sr-only peer">
                                    <div class="w-11 h-6 bg-gray-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-gray-300 after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-500"></div>
                                </label>
                            </div>
                            <div class="space-y-3">
                                <h4 class="text-sm font-bold text-white">Allowed Developer IPs</h4>
                                <form id="devWhitelistForm" class="flex gap-2" onsubmit="addDevWhitelistIp(event)">
                                    <input type="text" id="devWhitelistInput" placeholder="Enter IP address..." class="flex-1 bg-gray-900/60 border border-gray-800 focus:border-indigo-500 rounded-xl px-4 py-2 text-sm text-white outline-none transition-all" required>
                                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl font-bold text-sm transition-all shadow-md">Add IP</button>
                                </form>
                                <div class="bg-gray-900/40 border border-gray-800 rounded-xl p-2 overflow-y-auto max-h-48 custom-scrollbar">
                                    <table class="w-full text-left text-sm text-gray-400">
                                        <tbody id="devWhitelistTableBody" class="divide-y divide-gray-800/60">
                                            <!-- Whitelisted IPs will be populated here -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- DATA CLEANUP TRIGGERS -->
                    <div class="glass-card rounded-2xl p-6 border border-gray-800 space-y-6">
                        <div>
                            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                <i data-lucide="trash-2" class="w-5 h-5 text-red-500"></i>
                                <span>Instance Cleanup Triggers</span>
                            </h3>
                            <p class="text-xs text-gray-400 mt-1">Clear caches, playlists logs, history trackers, or user state metadata safely on the server.</p>
                        </div>
                        <div class="space-y-4">
                            <!-- Cache clear -->
                            <div class="flex items-center justify-between p-4 rounded-xl bg-gray-900/40 border border-gray-800/60">
                                <div>
                                    <h4 class="font-bold text-sm text-white">Clear Server Caches</h4>
                                    <p class="text-xs text-gray-500 mt-0.5">Purges all cached genres, play links, and handshakes in cache_stalker.</p>
                                </div>
                                <button onclick="triggerCleanup('cache')" class="bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white font-bold text-xs border border-red-500/20 px-4 py-2.5 rounded-xl transition-all">
                                    Purge Cache
                                </button>
                            </div>
                            <!-- History clear -->
                            <div class="flex items-center justify-between p-4 rounded-xl bg-gray-900/40 border border-gray-800/60">
                                <div>
                                    <h4 class="font-bold text-sm text-white">Clear Recent Play History</h4>
                                    <p class="text-xs text-gray-500 mt-0.5">Cleans recent channels lists from the database across portals.</p>
                                </div>
                                <button onclick="triggerCleanup('history')" class="bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white font-bold text-xs border border-red-500/20 px-4 py-2.5 rounded-xl transition-all">
                                    Clear History
                                </button>
                            </div>
                            <!-- Favorites clear -->
                            <div class="flex items-center justify-between p-4 rounded-xl bg-gray-900/40 border border-gray-800/60">
                                <div>
                                    <h4 class="font-bold text-sm text-white">Clear Favorites Settings</h4>
                                    <p class="text-xs text-gray-500 mt-0.5">Erases all favorited profiles and channel alignments.</p>
                                </div>
                                <button onclick="triggerCleanup('favorites')" class="bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white font-bold text-xs border border-red-500/20 px-4 py-2.5 rounded-xl transition-all">
                                    Wipe Favorites
                                </button>
                            </div>
                        </div>
                    </div>
                    <!-- FEATURE ACCESS MANAGEMENT (ICON OFF SECTION) -->
                    <div class="lg:col-span-2 glass-card rounded-2xl p-6 border border-gray-800 space-y-6">
                        <div>
                            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                <i data-lucide="layers" class="w-5 h-5 text-blue-500"></i>
                                <span>Feature Access Management (Master Toggles)</span>
                            </h3>
                            <p class="text-xs text-gray-400 mt-1">Enable or disable entire functional modules of the application instance.</p>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- M3U Toggle -->
                            <div class="flex items-center justify-between p-4 rounded-xl bg-gray-900/40 border border-gray-800">
                                <div class="flex items-center gap-3">
                                    <div class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400">
                                        <i data-lucide="folder-archive" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <p class="font-bold text-sm text-white">M3U Playlist Feature</p>
                                        <p class="text-[11px] text-gray-500">Enable local M3U vault.</p>
                                    </div>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="feat-m3u" class="sr-only peer feature-toggle" onchange="updateFeature('m3uEnabled', this.checked)">
                                    <div class="w-11 h-6 bg-gray-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-gray-300 after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                                </label>
                            </div>
                            <!-- Stalker Toggle -->
                            <div class="flex items-center justify-between p-4 rounded-xl bg-gray-900/40 border border-gray-800">
                                <div class="flex items-center gap-3">
                                    <div class="p-2.5 rounded-xl bg-blue-500/10 text-blue-400">
                                        <i data-lucide="server" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <p class="font-bold text-sm text-white">Stalker Portal Feature</p>
                                        <p class="text-[11px] text-gray-500">Enable external Stalker APIs.</p>
                                    </div>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="feat-stalker" class="sr-only peer feature-toggle" onchange="updateFeature('stalkerEnabled', this.checked)">
                                    <div class="w-11 h-6 bg-gray-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-gray-300 after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
                                </label>
                            </div>
                            <!-- Firewall Toggle -->
                            <div class="flex items-center justify-between p-4 rounded-xl bg-gray-900/40 border border-gray-800">
                                <div class="flex items-center gap-3">
                                    <div class="p-2.5 rounded-xl bg-red-500/10 text-red-400">
                                        <i data-lucide="shield" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <p class="font-bold text-sm text-white">IP Firewall Security</p>
                                        <p class="text-[11px] text-gray-500">Enable automatic blacklisting.</p>
                                    </div>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="feat-firewall" class="sr-only peer feature-toggle" onchange="updateFeature('firewallEnabled', this.checked)">
                                    <div class="w-11 h-6 bg-gray-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-gray-300 after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-500"></div>
                                </label>
                            </div>
                            <!-- Public Playlist Toggle -->
                            <div class="flex items-center justify-between p-4 rounded-xl bg-gray-900/40 border border-gray-800">
                                <div class="flex items-center gap-3">
                                    <div class="p-2.5 rounded-xl bg-amber-500/10 text-amber-400">
                                        <i data-lucide="share-2" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <p class="font-bold text-sm text-white">Public M3U Export</p>
                                        <p class="text-[11px] text-gray-500">Enable /playlist.php route.</p>
                                    </div>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="feat-public" class="sr-only peer feature-toggle" onchange="updateFeature('publicPlaylistEnabled', this.checked)">
                                    <div class="w-11 h-6 bg-gray-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-gray-300 after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                                </label>
                            </div>
                            <!-- Two-Way 2FA & Device Binding Security Card -->
                            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-4 rounded-xl bg-cyan-950/20 border border-cyan-500/20 gap-3 col-span-1 md:col-span-2">
                                <div class="flex items-center gap-3">
                                    <div class="p-2.5 rounded-xl bg-cyan-500/10 text-cyan-400">
                                        <i data-lucide="fingerprint" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <p class="font-bold text-sm text-white">Two-Way Identification & Device Binding</p>
                                        <p class="text-[11px] text-gray-400">Master PIN 2FA (2325 / 232512) + WebCrypto hardware signature binding.</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button onclick="openChange2faPinModal()" class="px-3.5 py-1.5 bg-cyan-600/30 hover:bg-cyan-600/50 text-cyan-300 border border-cyan-500/30 rounded-lg text-xs font-bold flex items-center gap-1.5 transition-all">
                                        <i data-lucide="key" class="w-3.5 h-3.5"></i> Change Security PIN
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- TAB 6: SPORTS MANAGER -->
            <div id="tabContent-sports" class="space-y-8 hidden">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-800/60 pb-6">
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight">Sports Manager</h1>
                        <p class="text-sm text-gray-400 mt-1">Add and monitor your custom global sports streams shown in the consumer portal.</p>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="extractSportsM3u()" id="extractSportsBtn" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-xl transition-all flex items-center gap-2 shadow-lg shadow-blue-600/10">
                            <i data-lucide="refresh-cw" class="w-4 h-4"></i> Extract Sports M3U
                        </button>
                        <button onclick="openNewSportsModal()" class="px-5 py-2.5 bg-red-600 hover:bg-red-500 text-white text-xs font-bold rounded-xl transition-all flex items-center gap-2 shadow-lg shadow-red-600/10">
                            <i data-lucide="plus" class="w-4 h-4"></i> Add Sports Stream
                        </button>
                    </div>
                </div>
                
                <!-- Sports M3U Vault section -->
                <div class="mt-8 pt-8 border-t border-gray-800">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i data-lucide="folder-kanban" class="w-5 h-5 text-emerald-500"></i> Sports M3U Files
                        </h2>
                        <button onclick="toggleSportsM3uModal(true)" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl transition-all flex items-center gap-2 shadow-lg shadow-emerald-600/10">
                            <i data-lucide="plus" class="w-4 h-4"></i> Add Sports M3U
                        </button>
                    </div>
                    <div class="bg-gray-900/40 border border-gray-800 rounded-2xl overflow-hidden">
                        <table class="w-full text-left">
                            <thead class="bg-gray-800/50 text-[10px] uppercase tracking-wider text-gray-400 font-bold border-b border-gray-800">
                                <tr>
                                    <th class="p-4">Name</th>
                                    <th class="p-4">Date Added</th>
                                    <th class="p-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="adminSportsM3uList" class="divide-y border-gray-800/50 text-sm">
                                <!-- Loaded dynamically via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Showcase Container Settings Section (Multi-Container Studio) -->
                <div class="mt-8 pt-8 border-t border-gray-800">
                    <div class="bg-gradient-to-br from-gray-950 via-gray-900/90 to-gray-950 border border-red-500/30 rounded-2xl p-6 sm:p-7 shadow-2xl relative overflow-hidden">
                        <div class="absolute -right-16 -top-16 w-64 h-64 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>
                        
                        <!-- Header & AI Presets Toolbar -->
                        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6 border-b border-gray-800/80 pb-5">
                            <div class="flex items-center gap-3">
                                <div class="p-2.5 bg-red-600/10 border border-red-500/20 rounded-xl text-red-400">
                                    <i data-lucide="layout-grid" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <h2 class="text-lg font-black text-white uppercase tracking-tight flex items-center gap-2">
                                        Multi-Container Showcase Studio
                                    </h2>
                                    <p class="text-xs text-gray-400">Manage multiple containers with custom Player Cutout PNGs, selectable channel grid styles, and custom backgrounds.</p>
                                </div>
                            </div>
                            
                            <!-- Action Buttons & AI Creator -->
                            <div class="flex flex-wrap items-center gap-2">
                                <div class="flex items-center gap-1.5 bg-gray-900/80 p-1 rounded-xl border border-gray-800 text-[10px]">
                                    <span class="text-gray-500 font-bold px-1.5 uppercase tracking-wider">Presets:</span>
                                    <button type="button" onclick="createContainerFromPreset('cricket')" class="px-2.5 py-1 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 rounded-lg font-bold border border-amber-500/30 transition-all">🏏 Cricket</button>
                                    <button type="button" onclick="createContainerFromPreset('football')" class="px-2.5 py-1 bg-blue-500/10 hover:bg-blue-500/20 text-blue-300 rounded-lg font-bold border border-blue-500/30 transition-all">⚽ Football</button>
                                    <button type="button" onclick="createContainerFromPreset('formula1')" class="px-2.5 py-1 bg-red-500/10 hover:bg-red-500/20 text-red-300 rounded-lg font-bold border border-red-500/30 transition-all">🏎️ F1 Racing</button>
                                    <button type="button" onclick="createContainerFromPreset('ufc')" class="px-2.5 py-1 bg-orange-500/10 hover:bg-orange-500/20 text-orange-300 rounded-lg font-bold border border-orange-500/30 transition-all">🥊 UFC/MMA</button>
                                    <button type="button" onclick="createContainerFromPreset('nba')" class="px-2.5 py-1 bg-purple-500/10 hover:bg-purple-500/20 text-purple-300 rounded-lg font-bold border border-purple-500/30 transition-all">🏀 NBA</button>
                                </div>
                                <button type="button" onclick="openNewContainerForm()" class="px-3.5 py-2 bg-red-600 hover:bg-red-500 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all shadow-lg shadow-red-600/20">
                                    <i data-lucide="plus" class="w-3.5 h-3.5"></i> New Container
                                </button>
                            </div>
                        </div>

                        <!-- AI Smart Container Creator Bar -->
                        <div class="mb-6 p-3.5 bg-gray-900/60 rounded-xl border border-amber-500/30 flex flex-col sm:flex-row items-center gap-3">
                            <div class="flex items-center gap-2 shrink-0">
                                <span class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                    <i data-lucide="sparkles" class="w-4 h-4"></i>
                                </span>
                                <span class="text-xs font-black text-amber-300 uppercase tracking-wide">AI Container Creator:</span>
                            </div>
                            <div class="flex-1 w-full flex items-center gap-2">
                                <input type="text" id="adminAiContainerPrompt" placeholder="e.g. Champions League Final, Formula 1 Monaco GP, or ICC World Cup..." class="w-full bg-black/60 border border-gray-800 focus:border-amber-400 rounded-lg px-3 py-2 text-xs text-white outline-none" onkeydown="if(event.key==='Enter'){event.preventDefault();generateAiChannelContainer();}">
                                <button type="button" id="btnGenerateAiContainer" onclick="generateAiChannelContainer()" class="px-4 py-2 bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white rounded-lg text-xs font-bold shrink-0 flex items-center gap-1.5 shadow-md shadow-amber-600/20 transition-all">
                                    <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-200"></i> Generate AI Container
                                </button>
                            </div>
                        </div>

                        <!-- Container Selector Deck -->
                        <div class="mb-6">
                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">Active Showcase Containers (<span id="adminContainersCount">1</span>)</label>
                            <div id="adminContainersChips" class="flex flex-wrap gap-2.5">
                                <!-- Loaded dynamically via JS -->
                            </div>
                        </div>

                        <!-- Active Container Settings Form -->
                        <form id="sportsHubConfigForm" onsubmit="saveActiveContainer(event)" class="space-y-4 bg-gray-900/40 p-5 rounded-2xl border border-gray-800/80">
                            <input type="hidden" id="adminContainerId" value="default_showcase">
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Container Title</label>
                                    <input type="text" id="adminHubTitle" value="INDIA VS AFGHANISTAN" placeholder="e.g. INDIA VS AFGHANISTAN" class="w-full bg-gray-900/80 border border-gray-800 focus:border-red-500 rounded-xl p-3.5 text-xs text-white outline-none transition-all">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Badge Tag</label>
                                    <input type="text" id="adminHubBadge" value="CRICKET LIVE" placeholder="e.g. CRICKET LIVE or CHAMPIONS LEAGUE" class="w-full bg-gray-900/80 border border-gray-800 focus:border-red-500 rounded-xl p-3.5 text-xs text-white outline-none transition-all">
                                </div>
                            </div>
                            
                            <div>
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Container Subtitle / Description</label>
                                <input type="text" id="adminHubSubtitle" value="Live ICC match coverage, 4K multi-camera streams, Hindi & English dugout feeds." placeholder="e.g. High-speed live sports broadcasts, official network feeds, and direct streams." class="w-full bg-gray-900/80 border border-gray-800 focus:border-red-500 rounded-xl p-3.5 text-xs text-white outline-none transition-all">
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Container Backdrop Image URL (Backdrop)</label>
                                    <input type="url" id="adminHubBgUrl" placeholder="https://example.com/stadium-backdrop.jpg" class="w-full bg-gray-900/80 border border-gray-800 focus:border-red-500 rounded-xl p-3.5 text-xs text-white outline-none transition-all" oninput="updateContainerPreviewThumbnails()">
                                    <p class="text-[9px] text-gray-500 mt-1">High-res pure background image behind the container.</p>
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-amber-400 uppercase tracking-widest block mb-1 flex items-center justify-between">
                                        <span>Player Cutout PNG (Right of Container)</span>
                                        <span class="text-[9px] text-emerald-400 font-normal">Transparent PNG</span>
                                    </label>
                                    <input type="url" id="adminHubPlayerPng" placeholder="https://pngimg.com/d/cricket_PNG10.png" class="w-full bg-gray-900/80 border border-amber-500/30 focus:border-amber-400 rounded-xl p-3.5 text-xs text-white outline-none transition-all" oninput="updateContainerPreviewThumbnails()">
                                    <p class="text-[9px] text-gray-500 mt-1">Stands boldly on the right side of the container with realistic depth shadow.</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Channel Grid Background / Texture (Optional)</label>
                                    <input type="url" id="adminHubGridBgUrl" placeholder="https://example.com/carbon-texture.png" class="w-full bg-gray-900/80 border border-gray-800 focus:border-red-500 rounded-xl p-3.5 text-xs text-white outline-none transition-all">
                                    <p class="text-[9px] text-gray-500 mt-1">Custom background texture applied behind the channel cards.</p>
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Channel Grid Layout Style</label>
                                    <select id="adminHubGridStyle" class="w-full bg-gray-900/80 border border-gray-800 focus:border-red-500 rounded-xl p-3.5 text-xs text-white outline-none transition-all">
                                        <option value="shelf">🎠 Horizontal Carousel Shelf (Smooth Scroll)</option>
                                        <option value="grid">🍱 Bento Multi-Card Grid (High Density)</option>
                                        <option value="glass_cards">💎 Cyberpunk Glass Neon (Translucent Cards)</option>
                                        <option value="compact_chips">⚡ Compact Action Chips (Fast Select)</option>
                                        <option value="spotlight">🌟 Hero Spotlight Showcase (Featured Feed + Strip)</option>
                                    </select>
                                    <p class="text-[9px] text-gray-500 mt-1">Admins can choose how channel streams are arranged in this container.</p>
                                </div>
                            </div>

                            <!-- Live Visual Preview Bar -->
                            <div id="adminContainerVisualPreview" class="p-3 bg-black/60 rounded-xl border border-gray-800 flex items-center justify-between gap-4">
                                <div class="flex items-center gap-3">
                                    <div id="adminContainerBgThumb" class="w-14 h-10 rounded-lg bg-gray-800 bg-cover bg-center border border-white/10 shrink-0"></div>
                                    <div class="min-w-0">
                                        <p id="adminContainerPreviewTitle" class="text-xs font-black text-white truncate">INDIA VS AFGHANISTAN</p>
                                        <p id="adminContainerPreviewStyle" class="text-[10px] text-red-400 font-bold uppercase">Grid Style: Bento Multi-Card</p>
                                    </div>
                                </div>
                                <div id="adminContainerPlayerThumbBox" class="flex items-center gap-2 pr-2">
                                    <span class="text-[9px] text-gray-400 uppercase font-bold">Player Cutout:</span>
                                    <img id="adminContainerPlayerThumb" src="https://pngimg.com/d/cricket_PNG10.png" class="w-8 h-10 object-contain filter drop-shadow" onerror="this.src='https://pngimg.com/d/cricket_PNG10.png'">
                                </div>
                            </div>

                            <div class="pt-2 flex items-center justify-between">
                                <button type="button" id="btnDeleteCurrentContainer" onclick="deleteActiveContainer()" class="px-4 py-2.5 bg-red-950/60 hover:bg-red-900/80 border border-red-500/30 text-red-400 text-xs font-bold rounded-xl transition-all flex items-center gap-1.5">
                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Delete Container
                                </button>
                                <div class="flex items-center gap-2">
                                    <button type="submit" id="btnSaveSportsHubConfig" class="px-6 py-3 bg-red-600 hover:bg-red-500 text-white text-xs font-bold rounded-xl transition-all flex items-center gap-2 shadow-lg shadow-red-600/20">
                                        <i data-lucide="save" class="w-4 h-4"></i> Save Container Settings
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Channels Filter & Header -->
                <div class="mt-8 pt-8 border-t border-gray-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i data-lucide="tv" class="w-5 h-5 text-red-500"></i> Channels in Showcase Containers
                        </h2>
                        <p class="text-xs text-gray-400 mt-0.5">Filter by container or assign channels to any showcase container.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <select id="adminFilterChannelContainer" onchange="filterChannelsByContainer(this.value)" class="bg-gray-900 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white outline-none">
                            <option value="all">All Containers</option>
                        </select>
                        <button onclick="openNewSportsModal()" class="px-4 py-2 bg-red-600/20 hover:bg-red-600/30 border border-red-500/40 text-red-300 hover:text-white rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all">
                            <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Channel
                        </button>
                    </div>
                </div>
                
                <!-- Sports Grid list -->
                <div id="adminSportsList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Loaded dynamically via JS -->
                </div>
                <!-- Dummy Play Frame inside admin panel -->
                <div id="dummyPlayContainer" class="hidden p-6 bg-gray-950/80 border border-gray-800 rounded-2xl text-left">
                    <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-800">
                        <h4 class="text-xs font-black uppercase text-gray-400 flex items-center gap-2">
                            <i data-lucide="play" class="w-4 h-4 text-red-500 animate-pulse"></i> Stream Playback Preview
                        </h4>
                        <button onclick="closeDummyPlayer()" class="p-1 hover:bg-gray-800 rounded text-gray-400 hover:text-white transition-all">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    </div>
                    <div class="aspect-video w-full rounded-xl overflow-hidden bg-black border border-gray-800 relative">
                        <video id="dummyVideoPlayer" class="w-full h-full" controls playsinline></video>
                    </div>
                    <p id="dummyVideoInfo" class="text-[10px] text-gray-500 mt-2 font-mono break-all"></p>
                </div>
            </div>
            <!-- Consumet Builder View -->
            <div id="tabContent-builder" class="hidden space-y-6 max-w-6xl">
                <div>
                    <h2 class="text-2xl font-bold text-white tracking-tight flex items-center gap-3">
                        <i data-lucide="wand-2" class="w-7 h-7 text-purple-500"></i>
                        Consumet UI Builder
                    </h2>
                    <p class="text-gray-400 text-sm mt-1">Ambitious graphic UI editor to visually modify and inject new sections into consumet.html</p>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Builder Form -->
                    <div class="bg-[#0a0a0a] border border-gray-800 rounded-2xl p-6 shadow-2xl relative overflow-hidden group">
                        <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
                            <i data-lucide="layout-template" class="w-5 h-5 text-purple-400"></i> Inject New Element
                        </h3>
                        <form id="builderForm" class="space-y-4 relative z-10">
                            <div>
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Element Type</label>
                                <select id="builderAction" class="w-full bg-gray-900/60 border border-gray-800 focus:border-purple-500 rounded-xl p-3.5 text-sm text-white outline-none mt-1 transition-all">
                                    <option value="add_section">New Grid/Sports Section</option>
                                    <option value="add_button">Floating Action Button</option>
                                </select>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Title / Display Name</label>
                                <input type="text" id="builderTitle" placeholder="e.g. Live Sports 2026" class="w-full bg-gray-900/60 border border-gray-800 focus:border-purple-500 rounded-xl p-3.5 text-sm text-white outline-none mt-1 transition-all">
                            </div>
                                                        <div id="builderBgContainer">
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Grid Background Image (Optional)</label>
                                <input type="url" id="builderBgUrl" placeholder="e.g. https://example.com/bg.jpg" class="w-full bg-gray-900/60 border border-gray-800 focus:border-purple-500 rounded-xl p-3.5 text-sm text-white outline-none mt-1 transition-all">
                                <p class="text-[9px] text-gray-500 ml-1 mt-1">Add a custom background image or gradient to this section (like Marvel & DC Multiverse styles).</p>
                            </div>
                            <div id="builderGridIdContainer">
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Grid DOM ID (Optional)</label>
                                <input type="text" id="builderGridId" placeholder="e.g. sportsGrid2" class="w-full bg-gray-900/60 border border-gray-800 focus:border-purple-500 rounded-xl p-3.5 text-sm text-white outline-none mt-1 transition-all">
                            </div>
                            <div id="builderHtmlContainer">
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Custom HTML Inner Content</label>
                                <textarea id="builderHtml" rows="4" placeholder="<div class='glass-card p-4'>Item</div>" class="w-full bg-gray-900/60 border border-gray-800 focus:border-purple-500 rounded-xl p-3.5 text-sm text-white outline-none mt-1 transition-all font-mono"></textarea>
                            </div>
                            <button type="submit" class="w-full bg-purple-600 hover:bg-purple-500 text-white font-bold py-3.5 px-6 rounded-xl shadow-[0_0_20px_rgba(168,85,247,0.3)] transition-all flex items-center justify-center gap-2">
                                <i data-lucide="zap" class="w-4 h-4"></i> Inject to UI
                            </button>
                        </form>
                    </div>
                    <!-- Actions & Preview -->
                    <div class="space-y-6">
                        <div class="bg-[#0a0a0a] border border-gray-800 rounded-2xl p-6 shadow-2xl relative overflow-hidden group">
                            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
                                <i data-lucide="rotate-ccw" class="w-5 h-5 text-red-400"></i> Emergency Reset
                            </h3>
                            <p class="text-sm text-gray-400 mb-4">Messed up the layout? Restore consumet.html to its last working backup state.</p>
                            <button id="builderResetBtn" class="w-full bg-red-600/10 hover:bg-red-600/20 text-red-500 border border-red-500/20 font-bold py-3.5 px-6 rounded-xl transition-all flex items-center justify-center gap-2">
                                <i data-lucide="shield-alert" class="w-4 h-4"></i> Factory Reset UI
                            </button>
                        </div>
                        <div class="bg-gray-900/40 border border-gray-800 rounded-2xl p-6 shadow-inner flex flex-col items-center justify-center text-center h-48">
                            <i data-lucide="monitor-smartphone" class="w-10 h-10 text-gray-600 mb-3"></i>
                            <h4 class="text-gray-300 font-medium">Live Preview Mode</h4>
                            <p class="text-xs text-gray-500 mt-1">Changes are applied immediately. Refresh the consumet page to view.</p>
                            <a href="/consumet.html" target="_blank" class="mt-4 text-xs font-bold text-purple-400 hover:text-purple-300 bg-purple-400/10 px-4 py-2 rounded-lg transition-colors">
                                Open consumet.html ↗
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- TAB 7: LIVE EVENTS MANAGER -->
            <div id="tabContent-liveevents" class="space-y-8 hidden">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-800/60 pb-6">
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight">Live Events Manager</h1>
                        <p class="text-sm text-gray-400 mt-1">Add and monitor your custom global live events shown in the consumer portal.</p>
                    </div>
                    <button onclick="openNewLiveEventModal()" class="px-5 py-2.5 bg-red-600 hover:bg-red-500 text-white text-xs font-bold rounded-xl transition-all flex items-center gap-2 shadow-lg shadow-red-600/10">
                        <i data-lucide="plus" class="w-4 h-4"></i> Add Live Event
                    </button>
                </div>
                <!-- Live Events Grid list -->
                <div id="adminLiveEventsList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Loaded dynamically via JS -->
                </div>
            </div>
            <!-- TAB 8: REAL-TIME ANALYTICS -->
            <div id="tabContent-analytics" class="space-y-8 hidden">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-800/80 pb-5">
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight flex items-center gap-3">
                            <i data-lucide="bar-chart-3" class="w-7 h-7 text-emerald-400"></i>
                            Real-time Server Analytics & Telemetry
                        </h1>
                        <p class="text-xs text-gray-400 mt-1">Live tracking for proxy bandwidth, active stream sessions, top requested media, and client IPs.</p>
                    </div>
                    <button onclick="fetchAnalytics()" class="px-4 py-2.5 bg-gray-900 hover:bg-gray-800 border border-gray-700/80 text-white rounded-xl text-xs font-bold flex items-center gap-2 transition-all">
                        <i data-lucide="refresh-cw" class="w-4 h-4 text-emerald-400"></i>
                        Refresh Telemetry
                    </button>
                </div>

                <!-- Live Analytics Stat Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="glass-card p-5 rounded-2xl border border-gray-800/80 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Active Concurrent Streams</p>
                            <h3 id="analyticsActiveStreams" class="text-3xl font-black text-white mt-1 mono">0</h3>
                            <p class="text-[10px] text-emerald-400 font-semibold mt-1 flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Streaming active
                            </p>
                        </div>
                        <div class="p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
                            <i data-lucide="radio" class="w-6 h-6"></i>
                        </div>
                    </div>

                    <div class="glass-card p-5 rounded-2xl border border-gray-800/80 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Total Bandwidth Transferred</p>
                            <h3 id="analyticsBandwidth" class="text-3xl font-black text-amber-400 mt-1 mono">0 B</h3>
                            <p class="text-[10px] text-amber-400/80 font-semibold mt-1">RAM Cache & Proxy Served</p>
                        </div>
                        <div class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400">
                            <i data-lucide="hard-drive-download" class="w-6 h-6"></i>
                        </div>
                    </div>

                    <div class="glass-card p-5 rounded-2xl border border-gray-800/80 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Unique Client IPs Tracked</p>
                            <h3 id="analyticsTrackedIps" class="text-3xl font-black text-blue-400 mt-1 mono">0</h3>
                            <p class="text-[10px] text-blue-400/80 font-semibold mt-1">Active client endpoints</p>
                        </div>
                        <div class="p-3.5 rounded-2xl bg-blue-500/10 border border-blue-500/20 text-blue-400">
                            <i data-lucide="users" class="w-6 h-6"></i>
                        </div>
                    </div>

                    <div class="glass-card p-5 rounded-2xl border border-gray-800/80 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">System Server Uptime</p>
                            <h3 id="analyticsUptime" class="text-3xl font-black text-purple-400 mt-1 mono">0s</h3>
                            <p class="text-[10px] text-purple-400/80 font-semibold mt-1">Process runtime</p>
                        </div>
                        <div class="p-3.5 rounded-2xl bg-purple-500/10 border border-purple-500/20 text-purple-400">
                            <i data-lucide="clock" class="w-6 h-6"></i>
                        </div>
                    </div>
                </div>

                <!-- Top Requested Movies & Shows + Connected Client IPs Table -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Top Requested Media -->
                    <div class="glass-card p-6 rounded-2xl border border-gray-800/80 space-y-4">
                        <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
                            <i data-lucide="flame" class="w-4 h-4 text-amber-500"></i>
                            Top Requested Movies & Shows
                        </h3>
                        <div id="analyticsTopRequested" class="space-y-2 max-h-[350px] overflow-y-auto pr-1">
                            <p class="text-xs text-gray-500 italic">No media request telemetry logged yet.</p>
                        </div>
                    </div>

                    <!-- Connected Client IPs -->
                    <div class="glass-card p-6 rounded-2xl border border-gray-800/80 space-y-4">
                        <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
                            <i data-lucide="globe" class="w-4 h-4 text-emerald-400"></i>
                            Connected Client IPs & Activity
                        </h3>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead>
                                    <tr class="border-b border-gray-800 text-[10px] text-gray-400 uppercase tracking-wider">
                                        <th class="py-2 px-3">IP Address</th>
                                        <th class="py-2 px-3">Requests</th>
                                        <th class="py-2 px-3">Status</th>
                                        <th class="py-2 px-3">Last Active</th>
                                    </tr>
                                </thead>
                                <tbody id="analyticsClientIps" class="divide-y divide-gray-800/60">
                                    <tr><td colspan="4" class="py-4 text-center text-gray-500 italic">No active client IP activity recorded.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Real-Time Bandwidth & Streams Telemetry Charts -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- High-Resolution Bandwidth Chart -->
                    <div class="lg:col-span-2 glass-card p-6 rounded-2xl border border-gray-800/80 space-y-4">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <div class="p-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
                                    <i data-lucide="activity" class="w-4 h-4"></i>
                                </div>
                                <div>
                                    <h3 class="text-sm font-bold text-white uppercase tracking-wider">Live Bandwidth Throughput (Mbps)</h3>
                                    <p class="text-[10px] text-gray-400">High-resolution 2-second streaming sample rate</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-mono font-black text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-lg" id="liveBandwidthGauge">0.00 Mbps</span>
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                            </div>
                        </div>
                        <!-- Canvas / SVG Area Chart Container -->
                        <div class="relative w-full h-48 bg-black/40 rounded-xl border border-white/5 p-2 overflow-hidden flex flex-col justify-end">
                            <svg id="bandwidthChartSvg" class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 400 120">
                                <defs>
                                    <linearGradient id="bwGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#10b981" stop-opacity="0.5"/>
                                        <stop offset="100%" stop-color="#10b981" stop-opacity="0.0"/>
                                    </linearGradient>
                                </defs>
                                <path id="bandwidthChartArea" d="M 0 120 L 400 120 Z" fill="url(#bwGrad)"/>
                                <path id="bandwidthChartLine" d="M 0 120 L 400 120" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round"/>
                            </svg>
                            <div class="flex justify-between text-[9px] font-mono text-gray-500 pt-1 border-t border-white/5 px-1">
                                <span>60s ago</span>
                                <span>30s ago</span>
                                <span>Live Now</span>
                            </div>
                        </div>
                    </div>

                    <!-- Active Channels Distribution -->
                    <div class="glass-card p-6 rounded-2xl border border-gray-800/80 space-y-4 flex flex-col">
                        <div class="flex items-center justify-between">
                            <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
                                <i data-lucide="tv-2" class="w-4 h-4 text-cyan-400"></i>
                                Active Channel Viewers
                            </h3>
                            <span class="text-[10px] font-mono text-cyan-400 bg-cyan-500/10 px-2 py-0.5 rounded border border-cyan-500/20" id="totalActiveViewersBadge">0 Viewers</span>
                        </div>
                        <div id="activeChannelsDistribution" class="space-y-3 flex-1 overflow-y-auto max-h-[190px] pr-1">
                            <p class="text-xs text-gray-500 italic py-4 text-center">No active concurrent stream viewers right now.</p>
                        </div>
                    </div>
                </div>

                <!-- Automated Stream Health Checker & Failover Panel -->
                <div class="glass-card p-6 rounded-2xl border border-gray-800/80 space-y-5">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-800/80 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="p-2.5 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400">
                                <i data-lucide="heart-pulse" class="w-6 h-6"></i>
                            </div>
                            <div>
                                <h3 class="text-lg font-black text-white tracking-tight flex items-center gap-2">
                                    Automated Stream Health Checker & Auto-Failover
                                    <span id="healthAutoFailoverBadge" class="text-[9px] font-mono font-bold uppercase px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">AUTO-FAILOVER ON</span>
                                </h3>
                                <p class="text-xs text-gray-400">Background worker continuously monitors streams, measures latency, and reroutes degraded channels</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <button onclick="triggerStreamHealthScan()" id="btnTriggerHealthScan" class="px-4 py-2 bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white rounded-xl text-xs font-bold flex items-center gap-2 transition-all shadow-lg shadow-cyan-600/20 active:scale-95">
                                <i data-lucide="zap" class="w-4 h-4"></i>
                                <span>Run Health Scan Now</span>
                            </button>
                            <button onclick="toggleHealthAutoFailover()" id="btnToggleFailover" class="px-3.5 py-2 bg-gray-900 hover:bg-gray-800 border border-gray-700/80 text-white rounded-xl text-xs font-bold transition-all">
                                Toggle Failover
                            </button>
                        </div>
                    </div>

                    <!-- Health Stat Metric Cards -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <div class="p-3.5 rounded-xl bg-black/40 border border-white/5">
                            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block">Total Monitored</span>
                            <span id="healthTotalStreams" class="text-2xl font-black text-white font-mono mt-0.5 block">0</span>
                        </div>
                        <div class="p-3.5 rounded-xl bg-black/40 border border-white/5">
                            <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-widest block">Healthy (Online)</span>
                            <span id="healthOnlineStreams" class="text-2xl font-black text-emerald-400 font-mono mt-0.5 block">0</span>
                        </div>
                        <div class="p-3.5 rounded-xl bg-black/40 border border-white/5">
                            <span class="text-[10px] font-bold text-amber-400 uppercase tracking-widest block">Degraded (High Latency)</span>
                            <span id="healthDegradedStreams" class="text-2xl font-black text-amber-400 font-mono mt-0.5 block">0</span>
                        </div>
                        <div class="p-3.5 rounded-xl bg-black/40 border border-white/5">
                            <span class="text-[10px] font-bold text-red-400 uppercase tracking-widest block">Offline / Failing</span>
                            <span id="healthOfflineStreams" class="text-2xl font-black text-red-400 font-mono mt-0.5 block">0</span>
                        </div>
                    </div>

                    <!-- Stream Health Results Table -->
                    <div class="overflow-x-auto rounded-xl border border-white/5">
                        <table class="w-full text-left text-xs">
                            <thead>
                                <tr class="bg-gray-900/60 border-b border-gray-800 text-[10px] text-gray-400 uppercase tracking-wider">
                                    <th class="py-2.5 px-3">Stream / Channel</th>
                                    <th class="py-2.5 px-3">Status</th>
                                    <th class="py-2.5 px-3">Latency</th>
                                    <th class="py-2.5 px-3">HTTP Code</th>
                                    <th class="py-2.5 px-3">Last Ping</th>
                                    <th class="py-2.5 px-3">Failover Route</th>
                                </tr>
                            </thead>
                            <tbody id="streamHealthTableBody" class="divide-y divide-gray-800/60">
                                <tr><td colspan="6" class="py-4 text-center text-gray-500 italic">Loading stream health status...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB: STREAM QUARANTINE & HEALTH SCANNER -->
            <div id="tabContent-quarantine" class="space-y-8 hidden">
                <!-- Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight flex items-center gap-3">
                            <i data-lucide="shield-alert" class="w-7 h-7 text-rose-500"></i>
                            M3U Stream Quarantine & Health Watchdog
                        </h1>
                        <p class="text-xs text-gray-400 mt-1">Deep diagnostics scanner for all M3U playlists (excluding sports). Quarantines dead/unworking streams and gives 1-click bulk purge.</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <button onclick="startQuarantineScan()" id="btnStartScan" class="px-4 py-2.5 bg-rose-600 hover:bg-rose-500 active:scale-95 text-white rounded-xl text-xs font-bold flex items-center gap-2 transition-all shadow-lg shadow-rose-600/20">
                            <i data-lucide="scan-line" class="w-4 h-4"></i>
                            <span>Scan All M3Us for Dead Links</span>
                        </button>
                        <button onclick="triggerFixAllLogos()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white rounded-xl text-xs font-bold flex items-center gap-2 transition-all shadow-lg shadow-indigo-600/20">
                            <i data-lucide="sparkles" class="w-4 h-4"></i>
                            <span>Auto-Assign IPTV-ORG Logos</span>
                        </button>
                        <button onclick="clearScannedDiagnosticsData()" class="px-4 py-2.5 bg-amber-600/20 hover:bg-amber-600/30 border border-amber-500/40 text-amber-300 active:scale-95 rounded-xl text-xs font-bold flex items-center gap-2 transition-all" title="Clear scanned diagnostic list without deleting channels from M3U files">
                            <i data-lucide="eraser" class="w-4 h-4 text-amber-400"></i>
                            <span>Clear Scanned Data</span>
                        </button>
                        <button onclick="purgeAllQuarantined()" class="px-4 py-2.5 bg-red-950/80 hover:bg-red-900 border border-red-500/40 text-red-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all">
                            <i data-lucide="trash-2" class="w-4 h-4 text-red-400"></i>
                            <span>Purge All Dead Links</span>
                        </button>
                    </div>
                </div>

                <!-- Scanner Status & Progress Card -->
                <div id="quarantineProgressBox" class="hidden glass-card p-6 rounded-2xl border border-rose-500/30 bg-rose-950/10 space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-3 h-3 rounded-full bg-rose-500 animate-ping"></div>
                            <span class="text-sm font-bold text-white">Live M3U Stream Diagnostic Scanner Running...</span>
                        </div>
                        <span id="scanPercentText" class="text-xs font-mono font-bold text-rose-400">0%</span>
                    </div>
                    <div class="w-full bg-gray-800 rounded-full h-3 overflow-hidden border border-gray-700">
                        <div id="scanProgressBar" class="bg-gradient-to-r from-rose-600 via-amber-500 to-emerald-500 h-full w-0 transition-all duration-300"></div>
                    </div>
                    <div class="flex items-center justify-between text-xs text-gray-400">
                        <span id="scanCurrentChannel" class="truncate max-w-md italic">Probing streams...</span>
                        <div class="flex items-center gap-4 font-mono">
                            <span>Checked: <b id="scanCheckedCount" class="text-white">0</b> / <b id="scanTotalCount">0</b></span>
                            <span>Dead: <b id="scanDeadCount" class="text-rose-400">0</b></span>
                            <span>Live: <b id="scanLiveCount" class="text-emerald-400">0</b></span>
                        </div>
                    </div>
                </div>

                <!-- Metric Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="glass-card p-5 rounded-2xl border border-gray-800 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Quarantined Dead Streams</p>
                            <h3 id="quarantineCountDisplay" class="text-3xl font-black text-rose-500 mt-1 mono">0</h3>
                            <p class="text-[10px] text-gray-500 mt-1">Marked as dead / inaccessible</p>
                        </div>
                        <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-500">
                            <i data-lucide="alert-triangle" class="w-6 h-6"></i>
                        </div>
                    </div>

                    <div class="glass-card p-5 rounded-2xl border border-gray-800 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Protected Playlists</p>
                            <h3 id="quarantinePlaylistsCount" class="text-3xl font-black text-blue-400 mt-1 mono">All</h3>
                            <p class="text-[10px] text-blue-400/80 mt-1">sportsM3u.ts is excluded</p>
                        </div>
                        <div class="p-3.5 rounded-2xl bg-blue-500/10 border border-blue-500/20 text-blue-400">
                            <i data-lucide="shield-check" class="w-6 h-6"></i>
                        </div>
                    </div>

                    <div class="glass-card p-5 rounded-2xl border border-gray-800 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Client Badging Mode</p>
                            <h3 class="text-xl font-black text-emerald-400 mt-1">ACTIVE</h3>
                            <p class="text-[10px] text-emerald-400/80 mt-1">Prompts user on player to delete dead channels</p>
                        </div>
                        <div class="p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
                            <i data-lucide="badge-alert" class="w-6 h-6"></i>
                        </div>
                    </div>
                </div>

                <!-- Search & Filters -->
                <div class="flex flex-col sm:flex-row items-center gap-3">
                    <div class="relative flex-1 w-full">
                        <input type="text" id="quarantineSearchInput" oninput="filterQuarantineTable()" placeholder="Search dead streams by channel name or stream URL..." class="w-full bg-gray-900/80 border border-gray-800 rounded-xl px-4 py-3 pl-10 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-rose-500 transition-colors">
                        <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-3.5 text-gray-500"></i>
                    </div>
                    <button onclick="fetchQuarantineList()" class="px-4 py-3 bg-gray-900 border border-gray-800 text-gray-300 hover:text-white rounded-xl text-xs font-bold flex items-center gap-2">
                        <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                        <span>Refresh List</span>
                    </button>
                </div>

                <!-- Table of Quarantined Streams -->
                <div class="glass-card rounded-2xl border border-gray-800/80 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead>
                                <tr class="border-b border-gray-800 bg-gray-900/50 text-[10px] text-gray-400 uppercase tracking-wider">
                                    <th class="py-3.5 px-4">Channel & Logo</th>
                                    <th class="py-3.5 px-4">Sub-section / Group</th>
                                    <th class="py-3.5 px-4">Playlist Source</th>
                                    <th class="py-3.5 px-4">Failure Reason</th>
                                    <th class="py-3.5 px-4">Stream URL</th>
                                    <th class="py-3.5 px-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="quarantineTableBody" class="divide-y divide-gray-800/60">
                                <tr>
                                    <td colspan="6" class="py-8 text-center text-gray-500 italic">No quarantined streams detected. Click "Scan All M3Us for Dead Links" above to run diagnostics.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB: MANUAL SUB-SECTION & CHANNEL ORGANIZER -->
            <div id="tabContent-reorganize" class="space-y-8 hidden">
                <!-- Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight flex items-center gap-3">
                            <i data-lucide="folder-tree" class="w-7 h-7 text-cyan-400"></i>
                            Sub-Section & Channel Organizer
                        </h1>
                        <p class="text-xs text-gray-400 mt-1">Manage sub-sections, add new channels, edit logos and channel names, or batch move channels with instant live save.</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <button onclick="openAddChannelModal()" class="px-4 py-2.5 bg-cyan-600 hover:bg-cyan-500 active:scale-95 text-white rounded-xl text-xs font-bold flex items-center gap-2 transition-all shadow-lg shadow-cyan-600/20">
                            <i data-lucide="plus-circle" class="w-4 h-4"></i>
                            <span>Add New Channel</span>
                        </button>
                        <button onclick="promptAddSubsection()" class="px-4 py-2.5 bg-indigo-600/30 hover:bg-indigo-600/50 border border-indigo-500/40 text-indigo-300 hover:text-white rounded-xl text-xs font-bold flex items-center gap-2 transition-all">
                            <i data-lucide="folder-plus" class="w-4 h-4"></i>
                            <span>New Sub-Section</span>
                        </button>
                        <button onclick="triggerFixAllLogos()" class="px-4 py-2.5 bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/40 text-purple-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all" title="Auto-match logos from IPTV-ORG database">
                            <i data-lucide="sparkles" class="w-4 h-4 text-purple-400"></i>
                            <span>Auto-Assign Logos</span>
                        </button>
                        <button onclick="saveReorganizedChannels()" id="btnSaveReorganize" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white rounded-xl text-xs font-bold flex items-center gap-2 transition-all shadow-lg shadow-emerald-600/20">
                            <i data-lucide="save" class="w-4 h-4"></i>
                            <span>Save & Apply to Playlist</span>
                        </button>
                    </div>
                </div>

                <!-- Playlist Selector & Quick Sub-section Explorer -->
                <div class="glass-card p-6 rounded-2xl border border-gray-800 space-y-5">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                        <div>
                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Target M3U Playlist</label>
                            <select id="organizerPlaylistSelect" onchange="loadPlaylistChannelsForOrganizer()" class="w-full bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500 font-bold">
                                <option value="kliv_zob">KLIV Master Zob Playlist (Default)</option>
                                <option value="kliv_jozo">KLIV Jozo Entertainment</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Batch Move Selected Channels</label>
                            <div class="flex gap-2">
                                <input type="text" id="batchMoveTargetInput" placeholder="Enter target sub-section..." class="flex-1 bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500">
                                <button onclick="executeBatchMove()" class="px-4 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl text-xs font-bold flex items-center gap-1 transition-all shrink-0">
                                    <i data-lucide="corner-down-right" class="w-3.5 h-3.5"></i>
                                    <span>Move</span>
                                </button>
                            </div>
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Quick Add / Rename Sub-section</label>
                            <div class="flex gap-2">
                                <input type="text" id="quickSubsectionInput" placeholder="Sub-section name..." class="flex-1 bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500">
                                <button onclick="handleQuickAddSubsection()" class="px-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-bold flex items-center gap-1 transition-all shrink-0" title="Add as new sub-section">
                                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                                    <span>Add</span>
                                </button>
                                <button onclick="executeRenameSubsection()" class="px-3 bg-purple-600 hover:bg-purple-500 text-white rounded-xl text-xs font-bold flex items-center gap-1 transition-all shrink-0" title="Rename active sub-section">
                                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                                    <span>Rename</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Visual Sub-section Explorer (Show our own sub-sections) -->
                    <div class="pt-3 border-t border-gray-800/80">
                        <div class="flex items-center justify-between mb-3">
                            <div class="flex items-center gap-2">
                                <i data-lucide="folders" class="w-4 h-4 text-cyan-400"></i>
                                <span class="text-[10px] font-bold text-gray-300 uppercase tracking-widest">Playlist Sub-Sections</span>
                                <span id="organizerSubCountBadge" class="text-[10px] bg-gray-800 text-gray-400 px-2 py-0.5 rounded-full font-mono">0 categories</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span id="organizerTotalBadge" class="text-[10px] text-cyan-400 font-mono font-bold">0 channels loaded</span>
                                <button onclick="promptAddSubsection()" class="text-[11px] text-cyan-400 hover:text-cyan-300 font-bold flex items-center gap-1">
                                    <i data-lucide="plus" class="w-3 h-3"></i>
                                    <span>Add Sub-Section</span>
                                </button>
                            </div>
                        </div>
                        <div id="organizerSubsectionPills" class="flex flex-wrap gap-1.5 max-h-40 overflow-y-auto pr-1">
                            <button class="px-3 py-1 rounded-lg bg-cyan-600 text-white text-[11px] font-bold">ALL</button>
                        </div>

                        <!-- Active Sub-section Toolbar Strip -->
                        <div id="activeSubToolbar" class="mt-3 p-3 rounded-xl bg-cyan-950/30 border border-cyan-500/20 flex flex-wrap items-center justify-between gap-3 hidden">
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-gray-400">Active Sub-Section:</span>
                                <span id="activeSubNameDisplay" class="text-xs font-black text-cyan-300 uppercase tracking-wide"></span>
                                <span id="activeSubCountDisplay" class="text-[10px] bg-cyan-500/20 text-cyan-300 px-2 py-0.5 rounded-full font-mono"></span>
                            </div>
                            <div class="flex items-center gap-2">
                                <button onclick="openAddChannelToCurrentSubModal()" class="px-2.5 py-1 bg-cyan-600/30 hover:bg-cyan-600 text-cyan-300 hover:text-white border border-cyan-500/40 rounded-lg text-xs font-bold flex items-center gap-1 transition-all">
                                    <i data-lucide="plus" class="w-3 h-3"></i>
                                    <span>Add Channel Here</span>
                                </button>
                                <button onclick="promptRenameActiveSub()" class="px-2.5 py-1 bg-purple-600/30 hover:bg-purple-600 text-purple-300 hover:text-white border border-purple-500/40 rounded-lg text-xs font-bold flex items-center gap-1 transition-all">
                                    <i data-lucide="edit" class="w-3 h-3"></i>
                                    <span>Rename</span>
                                </button>
                                <button onclick="deleteActiveSubsection()" class="px-2.5 py-1 bg-red-600/20 hover:bg-red-600 text-red-300 hover:text-white border border-red-500/30 rounded-lg text-xs font-bold flex items-center gap-1 transition-all">
                                    <i data-lucide="trash-2" class="w-3 h-3"></i>
                                    <span>Delete Category</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Channels Table with Selection & Inline Move -->
                <div class="glass-card rounded-2xl border border-gray-800 overflow-hidden">
                    <div class="p-4 bg-gray-900/60 border-b border-gray-800 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <label class="flex items-center gap-2 text-xs text-gray-300 font-bold cursor-pointer">
                                <input type="checkbox" id="organizerSelectAll" onchange="toggleSelectAllOrganizer(this)" class="rounded bg-gray-800 border-gray-700 text-cyan-600 focus:ring-cyan-500">
                                <span>Select All Filtered</span>
                            </label>
                            <span id="organizerSelectedCount" class="text-xs text-cyan-400 font-bold bg-cyan-500/10 px-2 py-0.5 rounded-full border border-cyan-500/20">0 selected</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="relative">
                                <input type="text" id="organizerSearchInput" oninput="renderOrganizerChannelsList()" placeholder="Filter by name or stream URL..." class="bg-gray-950 border border-gray-800 rounded-xl px-3 py-1.5 pl-8 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 w-56 sm:w-64">
                                <i data-lucide="search" class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-gray-500"></i>
                            </div>
                            <button onclick="fixSelectedLogos()" class="px-3 py-1.5 bg-indigo-600/30 hover:bg-indigo-600 text-indigo-300 hover:text-white border border-indigo-500/40 rounded-xl text-xs font-bold flex items-center gap-1 transition-all" title="Resolve IPTV-Org Logos for selected">
                                <i data-lucide="wand-2" class="w-3.5 h-3.5"></i>
                                <span>Fix Selected Logos</span>
                            </button>
                            <button onclick="deleteSelectedOrganizerChannels()" class="px-3 py-1.5 bg-red-600/30 hover:bg-red-600 text-red-300 hover:text-white border border-red-500/40 rounded-xl text-xs font-bold flex items-center gap-1 transition-all">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                <span>Delete Selected</span>
                            </button>
                        </div>
                    </div>

                    <div class="overflow-x-auto max-h-[650px] overflow-y-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="sticky top-0 bg-gray-950 border-b border-gray-800 text-[10px] text-gray-400 uppercase tracking-wider z-10">
                                <tr>
                                    <th class="py-3 px-4 w-10 text-center">#</th>
                                    <th class="py-3 px-4 w-14">Logo</th>
                                    <th class="py-3 px-4">Channel Name</th>
                                    <th class="py-3 px-4">Sub-section (Group)</th>
                                    <th class="py-3 px-4">Stream URL & Status</th>
                                    <th class="py-3 px-4 text-center w-20">Position</th>
                                    <th class="py-3 px-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="organizerChannelsTableBody" class="divide-y divide-gray-800/60">
                                <tr><td colspan="7" class="py-8 text-center text-gray-500 italic">Loading channels for organization...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB: UNIVERSAL EMBED SCRAPER & SPORTS CHANNEL STUDIO -->
            <div id="tabContent-embedscraper" class="space-y-8 hidden">
                <!-- Header -->
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-800/60 pb-6">
                    <div>
                        <div class="flex items-center gap-3">
                            <h1 class="text-3xl font-black text-white tracking-tight flex items-center gap-3">
                                <span>Universal Embed Scraper & Channel Studio</span>
                            </h1>
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-cyan-500/20 text-cyan-300 border border-cyan-500/40">M3U8-Engine</span>
                        </div>
                        <p class="text-sm text-gray-400 mt-1">Extract M3U8 master manifests from any iframe, tokenized embed, or protected stream and host as verified live channels in Sports Consumet.</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <button onclick="fetchScrapedChannels()" class="px-4 py-2.5 bg-gray-800 hover:bg-gray-700 text-gray-200 border border-gray-700 rounded-xl text-xs font-bold flex items-center gap-2 transition-all">
                            <i data-lucide="refresh-cw" class="w-4 h-4 text-cyan-400"></i>
                            <span>Refresh Channels</span>
                        </button>
                    </div>
                </div>

                <!-- Input Scraper Bento Card -->
                <div class="glass-card p-6 rounded-2xl border border-gray-800 space-y-6">
                    <div class="flex items-center justify-between border-b border-gray-800/60 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 flex items-center justify-center text-cyan-400 border border-cyan-500/20">
                                <i data-lucide="scan-line" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h3 class="text-base font-black text-white">Embed URL & Stream Analyzer</h3>
                                <p class="text-xs text-gray-400">Paste any website embed link, iframe source, or dynamic token stream.</p>
                            </div>
                        </div>
                        <span class="text-[10px] font-mono text-cyan-400/80 bg-cyan-950/60 border border-cyan-800/50 px-2 py-1 rounded-lg">Auto-Unpacker Enabled</span>
                    </div>

                    <!-- Quick Preset Badges -->
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider mr-1">Quick Presets:</span>
                        <button type="button" onclick="quickFillEmbedUrl('timstreams')" class="px-2.5 py-1 bg-gray-900 hover:bg-cyan-950/60 border border-gray-800 hover:border-cyan-500/40 text-gray-300 hover:text-cyan-300 rounded-lg text-[11px] font-medium transition-all flex items-center gap-1.5">
                            <i data-lucide="zap" class="w-3 h-3 text-cyan-400"></i> TimStreams Live
                        </button>
                        <button type="button" onclick="quickFillEmbedUrl('epiembeds')" class="px-2.5 py-1 bg-gray-900 hover:bg-cyan-950/60 border border-gray-800 hover:border-cyan-500/40 text-gray-300 hover:text-cyan-300 rounded-lg text-[11px] font-medium transition-all flex items-center gap-1.5">
                            <i data-lucide="play-circle" class="w-3 h-3 text-indigo-400"></i> EpiEmbeds
                        </button>
                        <button type="button" onclick="quickFillEmbedUrl('daddylive')" class="px-2.5 py-1 bg-gray-900 hover:bg-cyan-950/60 border border-gray-800 hover:border-cyan-500/40 text-gray-300 hover:text-cyan-300 rounded-lg text-[11px] font-medium transition-all flex items-center gap-1.5">
                            <i data-lucide="shield" class="w-3 h-3 text-amber-400"></i> DaddyLive / Romponalis
                        </button>
                        <button type="button" onclick="quickFillEmbedUrl('vidhide')" class="px-2.5 py-1 bg-gray-900 hover:bg-cyan-950/60 border border-gray-800 hover:border-cyan-500/40 text-gray-300 hover:text-cyan-300 rounded-lg text-[11px] font-medium transition-all flex items-center gap-1.5">
                            <i data-lucide="video" class="w-3 h-3 text-purple-400"></i> VidHide / StreamHide
                        </button>
                    </div>

                    <!-- URL Input Bar -->
                    <div class="space-y-2">
                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block">Embed / Stream Target URL <span class="text-cyan-400">*</span></label>
                        <div class="flex flex-col sm:flex-row gap-3">
                            <div class="relative flex-1">
                                <input type="url" id="embedScraperUrlInput" placeholder="https://timst.cfd/channel/... or https://epiembeds.online/embed/... or https://domain.com/embed.php?id=..." class="w-full bg-gray-900 border border-gray-800 pl-10 pr-4 py-3.5 rounded-xl text-sm text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 transition-colors">
                                <i data-lucide="link" class="w-4 h-4 text-gray-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                            </div>
                            <button type="button" id="btnScrapeEmbedAnalyze" onclick="analyzeEmbedUrl()" class="px-6 py-3.5 bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white rounded-xl text-sm font-black flex items-center justify-center gap-2 transition-all shadow-lg shadow-cyan-600/20 shrink-0">
                                <i data-lucide="sparkles" class="w-4 h-4"></i>
                                <span>Scrape & Extract M3U8</span>
                            </button>
                        </div>
                    </div>

                    <!-- Advanced Headers Accordion -->
                    <details class="group bg-gray-950/60 rounded-xl border border-gray-800/80 p-3.5">
                        <summary class="cursor-pointer text-xs font-bold text-gray-400 hover:text-gray-200 flex items-center justify-between list-none">
                            <div class="flex items-center gap-2">
                                <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5 text-cyan-400"></i>
                                <span>Custom Headers & Security Spoofing (Optional)</span>
                            </div>
                            <i data-lucide="chevron-down" class="w-4 h-4 text-gray-500 group-open:rotate-180 transition-transform"></i>
                        </summary>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4 pt-3 border-t border-gray-800/60">
                            <div>
                                <label class="text-[9px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Custom Referer</label>
                                <input type="text" id="embedHeaderReferer" placeholder="e.g. https://timst.cfd/" class="w-full bg-gray-900 border border-gray-800 p-2.5 rounded-lg text-xs text-white focus:outline-none focus:border-cyan-500">
                            </div>
                            <div>
                                <label class="text-[9px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Custom Origin</label>
                                <input type="text" id="embedHeaderOrigin" placeholder="e.g. https://timst.cfd" class="w-full bg-gray-900 border border-gray-800 p-2.5 rounded-lg text-xs text-white focus:outline-none focus:border-cyan-500">
                            </div>
                            <div class="sm:col-span-2">
                                <label class="text-[9px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Custom User-Agent</label>
                                <input type="text" id="embedHeaderUserAgent" placeholder="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36..." class="w-full bg-gray-900 border border-gray-800 p-2.5 rounded-lg text-xs text-white focus:outline-none focus:border-cyan-500">
                            </div>
                        </div>
                    </details>
                </div>

                <!-- Extraction Loading Spinner -->
                <div id="embedScraperLoading" class="hidden glass-card p-12 rounded-2xl border border-cyan-500/30 text-center space-y-4">
                    <div class="inline-flex p-4 bg-cyan-500/10 rounded-2xl border border-cyan-500/20 text-cyan-400 animate-pulse">
                        <i data-lucide="loader-2" class="w-8 h-8 animate-spin"></i>
                    </div>
                    <h3 class="text-lg font-black text-white">Decompiling Embed & Unpacking Stream Data...</h3>
                    <p class="text-xs text-gray-400 max-w-md mx-auto">Running dynamic curl bypassing, eval unpackers, token regex extraction, and CDN probes...</p>
                </div>

                <!-- Extraction Results Deck -->
                <div id="embedScraperResults" class="hidden space-y-6">
                    <div class="glass-card p-6 rounded-2xl border border-cyan-500/40 space-y-6 bg-gradient-to-b from-cyan-950/20 to-gray-950/60">
                        <!-- Result Status Bar -->
                        <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-gray-800">
                            <div class="flex items-center gap-3">
                                <div id="scraperStatusBadge" class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center gap-1.5">
                                    <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                                    <span>M3U8 RESOLVED</span>
                                </div>
                                <div id="scraperCdnBadge" class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-blue-500/20 text-blue-400 border border-blue-500/40">
                                    CDN: TIMSTREAMS
                                </div>
                                <div id="scraperTokenBadge" class="px-3 py-1 rounded-full text-xs font-bold text-amber-300 bg-amber-500/10 border border-amber-500/30">
                                    Token-Protected Proxy
                                </div>
                            </div>
                            <button type="button" onclick="testCurrentExtractedStream()" class="px-3.5 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-200 border border-gray-700 rounded-lg text-xs font-bold flex items-center gap-1.5 transition-all">
                                <i data-lucide="activity" class="w-3.5 h-3.5 text-cyan-400"></i>
                                <span>Probe Stream Health</span>
                            </button>
                        </div>

                        <!-- 2-Column Stream Preview & Channel Creator -->
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                            <!-- Left: Video Preview & Technical Details (5 cols) -->
                            <div class="lg:col-span-5 space-y-4">
                                <!-- Mode Switcher Bar -->
                                <div class="flex items-center justify-between bg-gray-900/90 p-1 rounded-xl border border-gray-800 text-xs">
                                    <div class="flex gap-1">
                                        <button type="button" id="btnModeHls" onclick="switchScraperPlayerMode('hls')" class="px-3 py-1.5 rounded-lg font-bold transition-all bg-cyan-600 text-white text-[11px] flex items-center gap-1.5 shadow-sm">
                                            <i data-lucide="play" class="w-3.5 h-3.5"></i>
                                            <span>HLS Stream Player</span>
                                        </button>
                                        <button type="button" id="btnModeIframe" onclick="switchScraperPlayerMode('iframe')" class="px-3 py-1.5 rounded-lg font-bold transition-all text-gray-400 hover:text-white text-[11px] flex items-center gap-1.5">
                                            <i data-lucide="globe" class="w-3.5 h-3.5"></i>
                                            <span>Iframe Embed Player</span>
                                        </button>
                                    </div>
                                    <span id="playerStreamStatus" class="text-[10px] font-mono px-2 py-0.5 rounded text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">READY</span>
                                </div>

                                <div class="relative bg-black rounded-xl overflow-hidden border border-gray-800 aspect-video flex items-center justify-center">
                                    <!-- HLS Video Element -->
                                    <video id="scrapedPreviewVideo" class="w-full h-full object-contain" controls autoplay playsinline muted></video>
                                    
                                    <!-- Iframe Embed Fallback Element -->
                                    <iframe id="scrapedPreviewIframe" class="hidden w-full h-full border-0" allow="autoplay; fullscreen; encrypted-media; picture-in-picture" allowfullscreen></iframe>

                                    <!-- Diagnostic / Offline Overlay -->
                                    <div id="scrapedPreviewErrorOverlay" class="hidden absolute inset-0 bg-gray-950/95 flex flex-col items-center justify-center p-5 text-center z-20 space-y-3">
                                        <div class="w-10 h-10 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center border border-rose-500/30">
                                            <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                                        </div>
                                        <div>
                                            <h4 class="text-xs font-bold text-white mb-1" id="scrapedErrorTitle">Stream Temporarily Offline</h4>
                                            <p class="text-[11px] text-gray-400 max-w-xs" id="scrapedErrorMsg">The upstream CDN returned 404/403. This event or channel might not be broadcasting right now.</p>
                                        </div>
                                        <div class="flex gap-2 pt-1">
                                            <button type="button" onclick="switchScraperPlayerMode('iframe')" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-[11px] font-bold rounded-lg flex items-center gap-1.5">
                                                <i data-lucide="globe" class="w-3.5 h-3.5"></i> View Original Iframe
                                            </button>
                                            <button type="button" onclick="retryScrapedHlsPlay()" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-200 text-[11px] font-bold rounded-lg border border-gray-700 flex items-center gap-1.5">
                                                <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Retry HLS
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Placeholder / Click to Play Overlay -->
                                    <div id="scrapedPreviewPlaceholder" class="hidden absolute inset-0 bg-gray-950/90 flex flex-col items-center justify-center p-4 text-center z-10">
                                        <i data-lucide="play-circle" class="w-10 h-10 text-cyan-400 mb-2"></i>
                                        <span class="text-xs text-gray-300 font-bold">Live Stream Ready</span>
                                        <button onclick="playScrapedPreviewNow()" class="mt-2 px-3 py-1 bg-cyan-600 hover:bg-cyan-500 text-white text-[11px] font-bold rounded-lg">Play Preview</button>
                                    </div>
                                </div>

                                <div class="bg-gray-950/80 p-4 rounded-xl border border-gray-800/80 space-y-2 text-xs">
                                    <div class="flex justify-between items-center text-gray-400">
                                        <span>Extracted M3U8:</span>
                                        <button onclick="copyExtractedM3u8Url()" class="text-cyan-400 hover:underline flex items-center gap-1 text-[11px]"><i data-lucide="copy" class="w-3 h-3"></i> Copy</button>
                                    </div>
                                    <div id="extractedM3u8Display" class="font-mono text-[11px] text-cyan-300 break-all bg-gray-900/90 p-2.5 rounded-lg border border-gray-800 select-all max-h-20 overflow-y-auto">
                                        https://...
                                    </div>
                                    <div class="flex justify-between text-gray-400 text-[11px] pt-1">
                                        <span>Referer Attached:</span>
                                        <span id="extractedRefererDisplay" class="text-gray-200 font-mono">None</span>
                                    </div>
                                    <div class="flex justify-between text-gray-400 text-[11px]">
                                        <span>Qualities Found:</span>
                                        <span id="extractedQualitiesDisplay" class="text-gray-200 font-bold">1080p Master HLS</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Sports Channel Configuration & CDN Approval Gate (7 cols) -->
                            <div class="lg:col-span-7 space-y-4">
                                <form id="saveScrapedChannelForm" onsubmit="saveScrapedChannelAsSportsChannel(event)" class="space-y-4">
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                        <div class="sm:col-span-2">
                                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Channel Name / Match Title <span class="text-cyan-400">*</span></label>
                                            <input type="text" id="scrapedChName" required placeholder="e.g. Star Sports 1 HD or UEFA: Chelsea vs PSG" class="w-full bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500 font-bold">
                                        </div>
                                        <div>
                                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Sport Category <span class="text-cyan-400">*</span></label>
                                            <select id="scrapedChCategory" class="w-full bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500">
                                                <option value="Cricket">🏏 Cricket</option>
                                                <option value="Football / Soccer">⚽ Football / Soccer</option>
                                                <option value="Motorsport / F1">🏎️ Motorsport / F1</option>
                                                <option value="Tennis">🎾 Tennis</option>
                                                <option value="Combat Sports / UFC">🥊 Combat Sports / UFC</option>
                                                <option value="Basketball / NBA">🏀 Basketball / NBA</option>
                                                <option value="American Football / NFL">🏈 American Football / NFL</option>
                                                <option value="Baseball / MLB">⚾ Baseball / MLB</option>
                                                <option value="Golf / PGA Tour">⛳ Golf / PGA Tour</option>
                                                <option value="Ice Hockey / NHL">🏒 Ice Hockey / NHL</option>
                                                <option value="Live Sports" selected>🏆 24/7 Live Sports</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Sports Showcase Container <span class="text-cyan-400">*</span></label>
                                            <select id="scrapedChContainer" class="w-full bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500">
                                                <!-- Populated dynamically -->
                                            </select>
                                        </div>
                                        <div class="sm:col-span-2">
                                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Logo URL (Optional)</label>
                                            <div class="flex gap-2">
                                                <input type="text" id="scrapedChLogo" placeholder="https://raw.githubusercontent.com/.../tv.svg" class="flex-1 bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500">
                                                <button type="button" onclick="autoFindLogoForScraped()" class="px-3 bg-gray-800 hover:bg-gray-700 text-cyan-400 border border-gray-700 rounded-xl text-xs font-bold flex items-center gap-1">
                                                    <i data-lucide="search" class="w-3.5 h-3.5"></i> Logo
                                                </button>
                                            </div>
                                        </div>
                                        <div class="sm:col-span-2">
                                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Background Image URL (Optional)</label>
                                            <input type="url" id="scrapedChBgUrl" placeholder="https://images.unsplash.com/... or stadium card art" class="w-full bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500">
                                        </div>
                                    </div>

                                    <!-- CDN Approval & Proxy Engine Controls -->
                                    <div class="p-4 bg-gray-950 rounded-xl border border-cyan-500/20 space-y-3">
                                        <div class="flex items-center justify-between">
                                            <div>
                                                <span class="text-xs font-black text-white flex items-center gap-1.5">
                                                    <i data-lucide="shield-check" class="w-4 h-4 text-cyan-400"></i>
                                                    <span>CDN Proxy & Token Auto-Refresh</span>
                                                </span>
                                                <p class="text-[10px] text-gray-400 mt-0.5">Route via Stalker Pro engine to prevent CORS, token drops, and browser blocks (like TimStreams channels).</p>
                                            </div>
                                            <label class="relative inline-flex items-center cursor-pointer">
                                                <input type="checkbox" id="scrapedChProxyToggle" checked class="sr-only peer">
                                                <div class="w-9 h-5 bg-gray-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-cyan-600"></div>
                                            </label>
                                        </div>

                                        <div class="pt-2 border-t border-gray-800/80 flex items-center gap-2">
                                            <input type="checkbox" id="scrapedChCdnApproval" checked required class="w-4 h-4 rounded border-gray-700 bg-gray-900 text-cyan-500 focus:ring-cyan-500">
                                            <label for="scrapedChCdnApproval" class="text-[11px] font-bold text-gray-300 cursor-pointer">
                                                Admin Approval: Verify CDN and authorize broadcast to Sports Consumet & M3U
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Submit Button -->
                                    <button type="submit" id="btnPublishScrapedChannel" class="w-full py-4 bg-gradient-to-r from-emerald-600 via-cyan-600 to-blue-600 hover:from-emerald-500 hover:to-blue-500 text-white rounded-xl text-sm font-black flex items-center justify-center gap-2 transition-all shadow-lg shadow-cyan-600/20">
                                        <i data-lucide="tv" class="w-4 h-4"></i>
                                        <span>Publish as Channel in Sports Consumet</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hosted Scraped Channels Directory -->
                <div class="glass-card p-6 rounded-2xl border border-gray-800 space-y-4">
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-gray-800/60 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center text-purple-400 border border-purple-500/20">
                                <i data-lucide="list-video" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h3 class="text-base font-black text-white">Active Scraped Channels Directory</h3>
                                <p class="text-xs text-gray-400">Custom embed-scraped channels broadcasting live to Sports Consumet and M3U playlists.</p>
                            </div>
                        </div>
                        <span id="scrapedChannelsCountBadge" class="text-xs font-mono text-gray-300 bg-gray-900 px-3 py-1.5 rounded-lg border border-gray-800">0 Hosted Channels</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-gray-950 border-b border-gray-800 text-[10px] text-gray-400 uppercase tracking-wider">
                                <tr>
                                    <th class="py-3 px-4 w-12 text-center">#</th>
                                    <th class="py-3 px-4 w-14">Logo</th>
                                    <th class="py-3 px-4">Channel Title</th>
                                    <th class="py-3 px-4">Category</th>
                                    <th class="py-3 px-4">Proxy Mode / Source</th>
                                    <th class="py-3 px-4">Showcase Container</th>
                                    <th class="py-3 px-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="scrapedChannelsTableBody" class="divide-y divide-gray-800/60">
                                <tr><td colspan="7" class="py-8 text-center text-gray-500 italic">No custom scraped channels registered yet. Paste an embed link above to extract and broadcast.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB: CHANNELS JSON STUDIO & M3U CONVERTER -->
            <div id="tabContent-channelsjson" class="space-y-8 hidden">
                <!-- Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight flex items-center gap-3">
                            <i data-lucide="file-json" class="w-7 h-7 text-amber-400"></i>
                            Channels JSON Studio & Master Quarantine
                        </h1>
                        <p class="text-xs text-gray-400 mt-1">Convert M3U playlists into standard channels.json, inspect, search, quarantine dead streams, deduplicate, and export with zero friction.</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <button onclick="openAddChannelJsonModal()" class="px-3.5 py-2.5 bg-amber-600 hover:bg-amber-500 active:scale-95 text-white rounded-xl text-xs font-bold flex items-center gap-2 transition-all shadow-lg shadow-amber-600/20">
                            <i data-lucide="plus-circle" class="w-4 h-4"></i>
                            <span>Add Channel</span>
                        </button>
                        <button onclick="fixAllChannelsJsonLogosUi()" class="px-3.5 py-2.5 bg-cyan-600/20 hover:bg-cyan-600/30 border border-cyan-500/40 text-cyan-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all shadow-lg shadow-cyan-600/10" title="Scrape and resolve authentic logos using Logopedia (logos.fandom.com), DuckDuckGo, Yahoo & Wikimedia backup">
                            <i data-lucide="sparkles" class="w-4 h-4 text-cyan-400"></i>
                            <span>Search & Fix All Logos (Logopedia / DDG / Yahoo)</span>
                        </button>
                        <button onclick="confirmClearAllChannelsJson()" class="px-3.5 py-2.5 bg-rose-600/20 hover:bg-rose-600/40 border border-rose-500/50 text-rose-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all shadow-lg shadow-rose-900/20" title="Delete all channels in channels.json (creates an automatic backup)">
                            <i data-lucide="trash-2" class="w-4 h-4 text-rose-400"></i>
                            <span>Full Deletion</span>
                        </button>
                        <button onclick="confirmDeduplicateChannels()" class="px-3.5 py-2.5 bg-amber-600/20 hover:bg-amber-600/30 border border-amber-500/40 text-amber-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all" title="Scan and remove duplicate stream URLs">
                            <i data-lucide="copy-minus" class="w-4 h-4 text-amber-400"></i>
                            <span>Deduplicate</span>
                        </button>
                        <button onclick="importAllM3uStorageToStudio()" class="px-3.5 py-2.5 bg-indigo-600/20 hover:bg-indigo-600/30 border border-indigo-500/40 text-indigo-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all" title="Scan & import all stored M3U playlists into channels.json">
                            <i data-lucide="folder-input" class="w-4 h-4 text-indigo-400"></i>
                            <span>Import All M3Us</span>
                        </button>
                        <button onclick="syncAllM3uStorage()" class="px-3.5 py-2.5 bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/40 text-emerald-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all" title="Synchronize channels.json to all M3U storage & feeds">
                            <i data-lucide="zap" class="w-4 h-4 text-emerald-400"></i>
                            <span>Sync All M3U</span>
                        </button>
                        <button onclick="triggerDeduplicateJson()" class="px-4 py-2.5 bg-blue-600/20 hover:bg-blue-600/30 border border-blue-500/40 text-blue-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all" title="Remove duplicate stream URLs">
                            <i data-lucide="sparkles" class="w-4 h-4 text-blue-400"></i>
                            <span>Deduplicate</span>
                        </button>
                        <button onclick="exportChannelsAsM3u()" class="px-4 py-2.5 bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/40 text-purple-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all" title="Download as .m3u playlist">
                            <i data-lucide="download" class="w-4 h-4"></i>
                            <span>Export M3U</span>
                        </button>
                        <button onclick="downloadChannelsJsonRaw()" class="px-4 py-2.5 bg-gray-800 hover:bg-gray-700 text-gray-200 border border-gray-700 rounded-xl text-xs font-bold flex items-center gap-2 transition-all" title="Download raw channels.json">
                            <i data-lucide="file-code-2" class="w-4 h-4 text-emerald-400"></i>
                            <span>Download JSON</span>
                        </button>
                        <button onclick="syncChannelsJsonCache()" class="px-4 py-2.5 bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/40 text-emerald-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all" title="Force rebuild live sports cache">
                            <i data-lucide="refresh-cw" class="w-4 h-4 text-emerald-400"></i>
                            <span>Sync Cache</span>
                        </button>
                    </div>
                </div>

                <!-- Studio Sub-Navigation Tabs -->
                <div class="flex flex-wrap items-center gap-2 p-1.5 bg-gray-950/80 rounded-2xl border border-gray-800/80 shadow-lg">
                    <button type="button" onclick="switchCjSubTab('catalog')" id="cjSubTabBtn-catalog" class="flex-1 min-w-[180px] py-2.5 px-4 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 bg-amber-600 text-white shadow-lg shadow-amber-600/30">
                        <i data-lucide="database" class="w-4 h-4"></i>
                        <span>Channels Catalog Database</span>
                        <span id="cjSubBadgeCatalog" class="ml-1 text-[10px] px-2 py-0.5 rounded-full bg-black/40 text-amber-200 font-mono">5,223</span>
                    </button>
                    <button type="button" onclick="switchCjSubTab('quarantine')" id="cjSubTabBtn-quarantine" class="flex-1 min-w-[180px] py-2.5 px-4 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 text-gray-400 hover:text-white hover:bg-gray-900/60">
                        <i data-lucide="shield-alert" class="w-4 h-4 text-rose-500"></i>
                        <span>Stream Quarantine & Health</span>
                        <span id="cjSubBadgeQuarantine" class="ml-1 text-[10px] px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30 font-mono">0 DEAD</span>
                    </button>
                    <button type="button" onclick="switchCjSubTab('converter')" id="cjSubTabBtn-converter" class="flex-1 min-w-[180px] py-2.5 px-4 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 text-gray-400 hover:text-white hover:bg-gray-900/60">
                        <i data-lucide="wand-2" class="w-4 h-4 text-cyan-400"></i>
                        <span>M3U to JSON Converter</span>
                        <span class="ml-1 text-[10px] px-2 py-0.5 rounded-full bg-gray-800 text-gray-400 font-mono">IMPORT</span>
                    </button>
                </div>

                <!-- Stats Metric Cards -->
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="glass-card p-5 rounded-2xl border border-gray-800 flex items-center justify-between cursor-pointer hover:border-amber-500/40 transition-colors" onclick="switchCjSubTab('catalog')">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Total Channels</p>
                            <h3 id="cjStatTotalChannels" class="text-2xl font-black text-white mt-1">5,223</h3>
                            <span class="text-[10px] text-amber-400 font-semibold">assets/channels.json</span>
                        </div>
                        <div class="p-3 bg-amber-500/10 text-amber-400 rounded-2xl border border-amber-500/20">
                            <i data-lucide="tv" class="w-6 h-6"></i>
                        </div>
                    </div>
                    <div class="glass-card p-5 rounded-2xl border border-gray-800 flex items-center justify-between cursor-pointer hover:border-purple-500/40 transition-colors" onclick="switchCjSubTab('catalog')">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Total Genres</p>
                            <h3 id="cjStatTotalGenres" class="text-2xl font-black text-white mt-1">--</h3>
                            <span class="text-[10px] text-purple-400 font-semibold">Distinct Categories</span>
                        </div>
                        <div class="p-3 bg-purple-500/10 text-purple-400 rounded-2xl border border-purple-500/20">
                            <i data-lucide="layers" class="w-6 h-6"></i>
                        </div>
                    </div>
                    <div class="glass-card p-5 rounded-2xl border border-gray-800 flex items-center justify-between cursor-pointer hover:border-rose-500/40 transition-colors" onclick="switchCjSubTab('quarantine')">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Dead Streams</p>
                            <h3 id="cjStatQuarantined" class="text-2xl font-black text-rose-500 mt-1">0</h3>
                            <span class="text-[10px] text-rose-400 font-semibold flex items-center gap-1">
                                <i data-lucide="shield-alert" class="w-3 h-3"></i>
                                <span>channels.json Watchdog</span>
                            </span>
                        </div>
                        <div class="p-3 bg-rose-500/10 text-rose-400 rounded-2xl border border-rose-500/20">
                            <i data-lucide="alert-triangle" class="w-6 h-6"></i>
                        </div>
                    </div>
                    <div class="glass-card p-5 rounded-2xl border border-gray-800 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">File Size & Storage</p>
                            <h3 id="cjStatFileSize" class="text-2xl font-black text-white mt-1">--</h3>
                            <span id="cjStatLastModified" class="text-[10px] text-emerald-400 font-semibold truncate max-w-[140px] block">Live Storage</span>
                        </div>
                        <div class="p-3 bg-emerald-500/10 text-emerald-400 rounded-2xl border border-emerald-500/20">
                            <i data-lucide="hard-drive" class="w-6 h-6"></i>
                        </div>
                    </div>
                </div>

                <!-- SUB-SECTION 1: LIVE CHANNELS CATALOG & SEARCH MANAGER -->
                <div id="cjSection-catalog" class="space-y-6">
                    <div class="glass-card p-6 rounded-2xl border border-gray-800 space-y-5">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div>
                                <h2 class="text-lg font-black text-white flex items-center gap-2">
                                    <i data-lucide="database" class="w-5 h-5 text-amber-400"></i>
                                    Live Channels Database (channels.json - 5,223 Channels)
                                </h2>
                                <p class="text-xs text-gray-400 mt-0.5">Search, inspect, update, or remove individual channels in real time with instant live synchronization.</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <button onclick="switchCjSubTab('quarantine')" class="px-3.5 py-2 bg-rose-600/20 hover:bg-rose-600/30 border border-rose-500/40 text-rose-300 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all">
                                    <i data-lucide="scan-line" class="w-3.5 h-3.5 text-rose-400"></i>
                                    <span>Scan Dead Streams</span>
                                </button>
                                <button onclick="promptDeleteByGenre()" class="px-3.5 py-2 bg-rose-900/20 hover:bg-rose-900/40 border border-rose-700/40 text-rose-300 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all">
                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                    <span>Purge Selected Genre</span>
                                </button>
                            </div>
                        </div>

                        <!-- Search & Filter Controls -->
                        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
                            <div class="sm:col-span-6 relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-500">
                                    <i data-lucide="search" class="w-4 h-4"></i>
                                </div>
                                <input type="text" id="cjSearchInput" placeholder="Search by channel name, genre, or stream URL..." class="w-full bg-gray-900/80 border border-gray-800 pl-10 pr-4 py-2.5 rounded-xl text-xs text-white focus:outline-none focus:border-amber-500 transition-colors" oninput="debounceCjSearch()">
                            </div>
                            <div class="sm:col-span-4">
                                <select id="cjGenreFilter" class="w-full bg-gray-900/80 border border-gray-800 py-2.5 px-3 rounded-xl text-xs text-gray-300 font-bold focus:outline-none focus:border-amber-500" onchange="handleCjFilterChange()">
                                    <option value="">All Categories / Genres</option>
                                </select>
                            </div>
                            <div class="sm:col-span-2">
                                <select id="cjSourceFilter" class="w-full bg-gray-900/80 border border-gray-800 py-2.5 px-3 rounded-xl text-xs text-gray-300 font-bold focus:outline-none focus:border-amber-500" onchange="handleCjFilterChange()">
                                    <option value="">All Sources</option>
                                </select>
                            </div>
                        </div>

                        <!-- Table Container -->
                        <div class="overflow-x-auto max-h-[600px] overflow-y-auto rounded-xl border border-gray-800">
                            <table class="w-full text-left text-xs">
                                <thead class="sticky top-0 bg-gray-950 border-b border-gray-800 text-[10px] text-gray-400 uppercase tracking-wider z-10">
                                    <tr>
                                        <th class="py-3 px-3 w-12 text-center">#</th>
                                        <th class="py-3 px-3 w-14 text-center">Logo</th>
                                        <th class="py-3 px-4">Channel Name</th>
                                        <th class="py-3 px-4">Category / Genre</th>
                                        <th class="py-3 px-4">Source</th>
                                        <th class="py-3 px-4">Stream URL</th>
                                        <th class="py-3 px-4 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="cjChannelsTableBody" class="divide-y divide-gray-800/60">
                                    <tr>
                                        <td colspan="7" class="py-12 text-center text-gray-500 italic">Loading channels.json catalog...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Footer -->
                        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-3 border-t border-gray-800/80">
                            <div class="text-xs text-gray-400">
                                Showing <span id="cjPageStart" class="font-bold text-white">0</span> to <span id="cjPageEnd" class="font-bold text-white">0</span> of <span id="cjTotalFiltered" class="font-bold text-white">0</span> channels
                            </div>
                            <div class="flex items-center gap-2">
                                <select id="cjPageLimit" class="bg-gray-900 border border-gray-800 py-1.5 px-2.5 rounded-lg text-xs text-gray-300 font-bold focus:outline-none" onchange="handleCjLimitChange(this.value)">
                                    <option value="25">25 per page</option>
                                    <option value="50" selected>50 per page</option>
                                    <option value="100">100 per page</option>
                                    <option value="200">200 per page</option>
                                </select>
                                <button onclick="changeCjPage(-1)" id="btnCjPrevPage" class="p-2 bg-gray-900 hover:bg-gray-800 text-gray-400 hover:text-white border border-gray-800 rounded-lg text-xs disabled:opacity-30 disabled:pointer-events-none transition-colors">
                                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                </button>
                                <span id="cjPageIndicator" class="text-xs font-mono font-bold text-amber-400 px-2">Page 1 / 1</span>
                                <button onclick="changeCjPage(1)" id="btnCjNextPage" class="p-2 bg-gray-900 hover:bg-gray-800 text-gray-400 hover:text-white border border-gray-800 rounded-lg text-xs disabled:opacity-30 disabled:pointer-events-none transition-colors">
                                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SUB-SECTION 2: STREAM QUARANTINE & HEALTH WATCHDOG (UNDER CHANNELS.JSON) -->
                <div id="cjSection-quarantine" class="space-y-6 hidden">
                    <div class="glass-card p-6 rounded-2xl border border-gray-800 space-y-6">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-800 pb-5">
                            <div>
                                <h2 class="text-lg font-black text-white flex items-center gap-2">
                                    <i data-lucide="shield-alert" class="w-5 h-5 text-rose-500"></i>
                                    Stream Quarantine & Health Watchdog (channels.json)
                                </h2>
                                <p class="text-xs text-gray-400 mt-1">Deep stream health diagnostic scanner for assets/channels.json (5,223 master channels). Automatically probes streams with 8-second handshake, flags 404/451/dead upstream links, and provides 1-click bulk purge directly from channels.json.</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <button onclick="startQuarantineScan('channels_json')" id="btnStartScanCj" class="px-4 py-2.5 bg-rose-600 hover:bg-rose-500 active:scale-95 text-white rounded-xl text-xs font-bold flex items-center gap-2 transition-all shadow-lg shadow-rose-600/20">
                                    <i data-lucide="scan-line" class="w-4 h-4"></i>
                                    <span>Scan channels.json Dead Links</span>
                                </button>
                                <button onclick="startQuarantineScan('all')" class="px-4 py-2.5 bg-blue-600/20 hover:bg-blue-600/30 border border-blue-500/40 text-blue-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all" title="Scan channels.json + all imported M3Us">
                                    <i data-lucide="globe" class="w-4 h-4"></i>
                                    <span>Scan All (JSON + M3Us)</span>
                                </button>
                                <button onclick="triggerFixAllLogos()" class="px-4 py-2.5 bg-indigo-600/20 hover:bg-indigo-600/30 border border-indigo-500/40 text-indigo-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all">
                                    <i data-lucide="sparkles" class="w-4 h-4 text-indigo-400"></i>
                                    <span>Auto-Assign Logos</span>
                                </button>
                                <button onclick="clearScannedDiagnosticsData()" class="px-4 py-2.5 bg-amber-600/20 hover:bg-amber-600/30 border border-amber-500/40 text-amber-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all" title="Clear scanned diagnostic list without deleting channels">
                                    <i data-lucide="eraser" class="w-4 h-4 text-amber-400"></i>
                                    <span>Clear Scanned</span>
                                </button>
                                <button onclick="purgeAllQuarantined()" class="px-4 py-2.5 bg-red-950/80 hover:bg-red-900 border border-red-500/40 text-red-300 rounded-xl text-xs font-bold flex items-center gap-2 transition-all">
                                    <i data-lucide="trash-2" class="w-4 h-4 text-red-400"></i>
                                    <span>Purge Dead from channels.json</span>
                                </button>
                            </div>
                        </div>

                        <!-- Scanner Status & Progress Card -->
                        <div id="quarantineProgressBox" class="hidden glass-card p-6 rounded-2xl border border-rose-500/30 bg-rose-950/10 space-y-4">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-3 h-3 rounded-full bg-rose-500 animate-ping"></div>
                                    <span class="text-sm font-bold text-white">Live Stream Diagnostic Scanner Running (assets/channels.json)...</span>
                                </div>
                                <span id="scanPercentText" class="text-xs font-mono font-bold text-rose-400">0%</span>
                            </div>
                            <div class="w-full bg-gray-800 rounded-full h-3 overflow-hidden border border-gray-700">
                                <div id="scanProgressBar" class="bg-gradient-to-r from-rose-600 via-amber-500 to-emerald-500 h-full w-0 transition-all duration-300"></div>
                            </div>
                            <div class="flex items-center justify-between text-xs text-gray-400">
                                <span id="scanCurrentChannel" class="truncate max-w-md italic">Probing streams...</span>
                                <div class="flex items-center gap-4 font-mono">
                                    <span>Checked: <b id="scanCheckedCount" class="text-white">0</b> / <b id="scanTotalCount">0</b></span>
                                    <span>Dead: <b id="scanDeadCount" class="text-rose-400">0</b></span>
                                    <span>Live: <b id="scanLiveCount" class="text-emerald-400">0</b></span>
                                </div>
                            </div>
                        </div>

                        <!-- Search & Filters for Quarantined -->
                        <div class="flex flex-col sm:flex-row items-center gap-3">
                            <div class="relative flex-1 w-full">
                                <input type="text" id="quarantineSearchInput" oninput="filterQuarantineTable()" placeholder="Search dead streams by channel name or stream URL..." class="w-full bg-gray-900/80 border border-gray-800 rounded-xl px-4 py-3 pl-10 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-rose-500 transition-colors">
                                <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-3.5 text-gray-500"></i>
                            </div>
                            <button onclick="fetchQuarantineList()" class="px-4 py-3 bg-gray-900 border border-gray-800 text-gray-300 hover:text-white rounded-xl text-xs font-bold flex items-center gap-2">
                                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                                <span>Refresh List</span>
                            </button>
                        </div>

                        <!-- Table of Quarantined Streams -->
                        <div class="rounded-2xl border border-gray-800/80 overflow-hidden">
                            <div class="overflow-x-auto max-h-[600px] overflow-y-auto">
                                <table class="w-full text-left text-xs">
                                    <thead class="sticky top-0 bg-gray-950 border-b border-gray-800 text-[10px] text-gray-400 uppercase tracking-wider z-10">
                                        <tr>
                                            <th class="py-3.5 px-4">Channel & Logo</th>
                                            <th class="py-3.5 px-4">Category / Genre</th>
                                            <th class="py-3.5 px-4">Database Source</th>
                                            <th class="py-3.5 px-4">Failure Reason</th>
                                            <th class="py-3.5 px-4">Stream URL</th>
                                            <th class="py-3.5 px-4 text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="quarantineTableBody" class="divide-y divide-gray-800/60">
                                        <tr>
                                            <td colspan="6" class="py-8 text-center text-gray-500 italic">No quarantined dead streams detected in channels.json. Click "Scan channels.json Dead Links" above to run diagnostics.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SUB-SECTION 3: CONVERTER STUDIO -->
                <div id="cjSection-converter" class="space-y-6 hidden">
                    <div class="glass-card p-6 sm:p-8 rounded-3xl border border-amber-500/30 shadow-2xl relative overflow-hidden bg-gradient-to-b from-gray-900/90 to-gray-950/90 space-y-6">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-800 pb-5">
                            <div class="flex items-center gap-3">
                                <div class="p-2.5 bg-amber-500/20 text-amber-400 rounded-xl border border-amber-500/30">
                                    <i data-lucide="wand-2" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <h2 class="text-lg font-black text-white uppercase tracking-wider">M3U to Channels.json Converter</h2>
                                    <p class="text-xs text-gray-400">Import any standard M3U/M3U8 file, raw playlist text, or live URL and instantly convert to our channels schema.</p>
                                </div>
                            </div>
                            <!-- Method tabs -->
                            <div class="flex bg-gray-950 p-1 rounded-xl border border-gray-800">
                                <button type="button" onclick="setCjInputMethod('file')" id="cjMethodBtn-file" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-amber-600 text-white transition-all">Upload File</button>
                                <button type="button" onclick="setCjInputMethod('paste')" id="cjMethodBtn-paste" class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-gray-400 hover:text-white transition-all">Paste M3U</button>
                                <button type="button" onclick="setCjInputMethod('url')" id="cjMethodBtn-url" class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-gray-400 hover:text-white transition-all">M3U URL</button>
                            </div>
                        </div>

                        <form id="cjConverterForm" onsubmit="handleCjConvertSubmit(event)" class="space-y-6">
                            <!-- Input Section 1: File Upload -->
                            <div id="cjInputGroup-file" class="space-y-2">
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block">Choose M3U File (.m3u, .m3u8, .txt)</label>
                                <div id="cjDropZone" class="border-2 border-dashed border-gray-800 hover:border-amber-500/50 rounded-2xl p-8 text-center cursor-pointer transition-all bg-gray-950/60 relative">
                                    <input type="file" id="cjFileInput" accept=".m3u,.m3u8,.txt" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" onchange="handleCjFileSelected(this)">
                                    <div class="flex flex-col items-center gap-3 pointer-events-none">
                                        <div class="p-3 bg-gray-900 rounded-2xl text-amber-400 border border-gray-800">
                                            <i data-lucide="file-up" class="w-8 h-8"></i>
                                        </div>
                                        <div>
                                            <p id="cjDropZoneFileName" class="text-sm font-bold text-white">Drag & drop your M3U playlist file here</p>
                                            <p class="text-xs text-gray-500 mt-0.5">Supports .m3u, .m3u8, or plain text channel lists up to 50MB</p>
                                        </div>
                                        <span class="px-4 py-1.5 bg-gray-900 hover:bg-gray-800 border border-gray-800 text-gray-300 text-xs font-bold rounded-xl mt-1">Browse Local Files</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Input Section 2: Paste Raw Content -->
                            <div id="cjInputGroup-paste" class="hidden space-y-2">
                                <div class="flex items-center justify-between">
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block">Paste Raw M3U Content</label>
                                    <button type="button" onclick="loadSampleM3uIntoPaste()" class="text-[10px] text-amber-400 hover:underline">Insert Sample M3U</button>
                                </div>
                                <textarea id="cjPasteTextarea" rows="8" placeholder="#EXTM3U&#10;#EXTINF:-1 tvg-name=&quot;Sony Ten 1 HD&quot; tvg-logo=&quot;https://...&quot; group-title=&quot;Sports&quot;,Sony Ten 1 HD&#10;https://stream.kliv.in/nex/bozz_123.m3u8" class="w-full bg-gray-950 border border-gray-800 p-4 rounded-2xl text-xs font-mono text-gray-200 focus:outline-none focus:border-amber-500 transition-all resize-y"></textarea>
                            </div>

                            <!-- Input Section 3: Remote URL -->
                            <div id="cjInputGroup-url" class="hidden space-y-2">
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block">Remote M3U Playlist URL</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-500">
                                        <i data-lucide="globe" class="w-4 h-4"></i>
                                    </div>
                                    <input type="url" id="cjUrlInput" placeholder="https://example.com/playlist.m3u" class="w-full bg-gray-950 border border-gray-800 pl-11 pr-4 py-3.5 rounded-2xl text-xs text-white focus:outline-none focus:border-amber-500 transition-all font-mono">
                                </div>
                                <p class="text-[11px] text-gray-500">The server will fetch the playlist directly and parse all valid streams.</p>
                            </div>

                            <!-- Conversion Options Grid -->
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-t border-gray-800/80">
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1.5">Import Mode</label>
                                    <select id="cjImportMode" class="w-full bg-gray-950 border border-gray-800 p-3 rounded-xl text-xs font-bold text-white focus:outline-none focus:border-amber-500">
                                        <option value="append" selected>🟢 Append & Merge (Keep existing, add new)</option>
                                        <option value="replace">🔴 Replace & Overwrite (Wipe & set new)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1.5">Default / Fallback Genre</label>
                                    <input type="text" id="cjDefaultGenre" value="Custom M3U" placeholder="e.g. Sports, Movies" class="w-full bg-gray-950 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-amber-500">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1.5">Source Tag</label>
                                    <input type="text" id="cjSourceTag" value="m3u_converter" placeholder="e.g. kliv_jozo, admin_import" class="w-full bg-gray-950 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-amber-500">
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-gray-300">
                                    <input type="checkbox" id="cjDeduplicateCheck" checked class="w-4 h-4 rounded text-amber-600 bg-gray-900 border-gray-700 focus:ring-0">
                                    <span>Auto-skip duplicate stream URLs (recommended)</span>
                                </label>
                            </div>

                            <!-- Action buttons -->
                            <div class="flex flex-col sm:flex-row items-center gap-3 pt-3">
                                <button type="button" onclick="previewCjConversion()" id="btnCjPreview" class="w-full sm:w-auto px-6 py-3.5 bg-gray-800 hover:bg-gray-700 text-white rounded-xl text-xs font-bold flex items-center justify-center gap-2 transition-all border border-gray-700">
                                    <i data-lucide="eye" class="w-4 h-4 text-amber-400"></i>
                                    <span>Preview Conversion</span>
                                </button>
                                <button type="submit" id="btnCjConvertSubmit" class="w-full sm:flex-1 py-3.5 bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 active:scale-95 text-white rounded-xl text-xs font-black uppercase tracking-wider flex items-center justify-center gap-2 transition-all shadow-xl shadow-amber-600/20">
                                    <i data-lucide="file-check" class="w-4 h-4"></i>
                                    <span>Convert & Save to channels.json</span>
                                </button>
                                <button type="button" onclick="resetCjConverterForm()" class="w-full sm:w-auto px-5 py-3.5 bg-gray-900 hover:bg-gray-800 text-gray-400 hover:text-white rounded-xl text-xs font-bold transition-all border border-gray-800">
                                    Clear
                                </button>
                            </div>
                        </form>

                        <!-- Preview Container -->
                        <div id="cjPreviewResultContainer" class="hidden space-y-4 pt-6 border-t border-gray-800 animate-in fade-in duration-200">
                            <div class="flex items-center justify-between">
                                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                                    <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
                                    Conversion Preview Results
                                </h3>
                                <button type="button" onclick="document.getElementById('cjPreviewResultContainer').classList.add('hidden')" class="text-xs text-gray-400 hover:text-white">Close</button>
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                <div class="bg-gray-950 p-3.5 rounded-xl border border-gray-800">
                                    <p class="text-[10px] text-gray-400 uppercase font-bold">Total Parsed</p>
                                    <p id="cjPrevTotalParsed" class="text-lg font-black text-amber-400 mt-0.5">0</p>
                                </div>
                                <div class="bg-gray-950 p-3.5 rounded-xl border border-gray-800">
                                    <p class="text-[10px] text-gray-400 uppercase font-bold">New Unique</p>
                                    <p id="cjPrevNewUnique" class="text-lg font-black text-emerald-400 mt-0.5">0</p>
                                </div>
                                <div class="bg-gray-950 p-3.5 rounded-xl border border-gray-800">
                                    <p class="text-[10px] text-gray-400 uppercase font-bold">Existing In DB</p>
                                    <p id="cjPrevExisting" class="text-lg font-black text-blue-400 mt-0.5">0</p>
                                </div>
                                <div class="bg-gray-950 p-3.5 rounded-xl border border-gray-800">
                                    <p class="text-[10px] text-gray-400 uppercase font-bold">Genres Found</p>
                                    <p id="cjPrevGenresCount" class="text-lg font-black text-purple-400 mt-0.5">0</p>
                                </div>
                            </div>

                            <!-- Sample list -->
                            <div class="bg-gray-950 rounded-2xl border border-gray-800 overflow-hidden">
                                <div class="p-3 bg-gray-900/60 border-b border-gray-800 flex items-center justify-between text-xs font-bold text-gray-300">
                                    <span>Sample Parsed Channels (First 10)</span>
                                    <span id="cjPrevSampleCount" class="text-[10px] text-gray-500 font-mono">10 items</span>
                                </div>
                                <div class="max-h-60 overflow-y-auto">
                                    <table class="w-full text-left text-xs">
                                        <thead class="bg-gray-950 text-[10px] text-gray-400 uppercase tracking-wider sticky top-0 border-b border-gray-800">
                                            <tr>
                                                <th class="py-2.5 px-3 w-12 text-center">#</th>
                                                <th class="py-2.5 px-3">Channel Name</th>
                                                <th class="py-2.5 px-3">Genre</th>
                                                <th class="py-2.5 px-3">Stream URL</th>
                                            </tr>
                                        </thead>
                                        <tbody id="cjPrevTableBody" class="divide-y divide-gray-800/50">
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <!-- Sports M3U Modal -->
    <div id="sportsM3uModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-gray-950 border border-gray-800 w-full max-w-lg rounded-2xl p-8 animate-in zoom-in-95 duration-200 shadow-2xl">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-800">
                <h3 class="text-white text-lg font-black uppercase tracking-tight flex items-center gap-2">
                    <i data-lucide="folder-kanban" class="w-5 h-5 text-emerald-500"></i> Add Sports M3U
                </h3>
                <button onclick="toggleSportsM3uModal(false)" class="p-2 text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <form id="sportsM3uForm" class="space-y-5" onsubmit="saveSportsM3u(event)">
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">M3U Playlist Name <span class="text-red-500">*</span></label>
                    <input type="text" id="sportsM3uName" required placeholder="e.g. My Sports VIP" class="w-full bg-gray-900 border border-gray-800 p-4 rounded-xl text-sm text-white focus:outline-none focus:border-emerald-500 transition-colors">
                </div>
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Import Method</label>
                    <div class="flex gap-2 mt-1 mb-3">
                        <button type="button" onclick="setSportsM3uMethod('file')" id="sportsM3uMethodFile" class="flex-1 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold transition-all border border-emerald-500">File Upload</button>
                        <button type="button" onclick="setSportsM3uMethod('url')" id="sportsM3uMethodUrl" class="flex-1 py-2 rounded-xl bg-white/5 text-gray-400 text-xs font-bold transition-all border border-gray-800">M3U URL</button>
                    </div>
                </div>
                
                <div id="sportsM3uFileGroup">
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Select File (.m3u, .m3u8)</label>
                    <div id="sportsM3uDropZone" class="border-2 border-dashed border-gray-800 hover:border-emerald-500/50 rounded-2xl p-6 text-center cursor-pointer transition-colors bg-gray-900/40 relative mt-1">
                        <input type="file" id="sportsM3uFileInput" accept=".m3u,.m3u8" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
                        <div class="flex flex-col items-center gap-2 pointer-events-none">
                            <i data-lucide="file-plus" class="w-8 h-8 text-gray-500"></i>
                            <span id="sportsM3uDropZoneText" class="text-xs text-gray-400 font-bold">Drag file here or click to browse</span>
                        </div>
                    </div>
                </div>

                <div id="sportsM3uUrlGroup" class="hidden">
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">M3U Playlist URL</label>
                    <input type="url" id="sportsM3uUrlInput" placeholder="https://example.com/sports.m3u" class="w-full bg-gray-900 border border-gray-800 p-4 rounded-xl text-sm text-white focus:outline-none focus:border-emerald-500 transition-colors">
                </div>
                
                <div class="pt-4">
                    <button type="submit" class="w-full py-4 bg-emerald-600 hover:bg-emerald-500 rounded-xl font-bold text-white text-sm flex items-center justify-center gap-2 transition-all shadow-lg shadow-emerald-600/10">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        <span>Save M3U</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Sports Link Modal -->
    <div id="sportsModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-gray-950 border border-gray-800 w-full max-w-lg rounded-2xl p-8 animate-in zoom-in-95 duration-200 shadow-2xl">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-800">
                <h3 id="sportsModalTitle" class="text-white text-lg font-black uppercase tracking-tight flex items-center gap-2">
                    <i data-lucide="trophy" class="w-5 h-5 text-red-500"></i> Add Sports Stream
                </h3>
                <button onclick="toggleSportsModal(false)" class="p-2 text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <form id="sportsForm" class="space-y-5" onsubmit="saveSportsStream(event)">
                <input type="hidden" id="sportsId">
                <div class="mb-4 space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block">Quick Select (From Channels Catalog)</label>
                        <button type="button" onclick="openSportsChannelPicker()" class="text-[10px] font-black uppercase text-red-400 hover:text-red-300 flex items-center gap-1.5 transition-colors px-2.5 py-1 rounded-lg bg-red-500/10 border border-red-500/20 hover:border-red-500/50 hover:bg-red-500/20 shadow-sm" title="Search all 5,200+ catalog channels">
                            <i data-lucide="search" class="w-3 h-3"></i>
                            <span>Search Picker</span>
                        </button>
                    </div>

                    <!-- Search Input and Search Button Toolbar -->
                    <div class="flex items-center gap-2">
                        <div class="relative flex-1">
                            <input type="text" id="sportsQuickSearchInput" placeholder="Type channel name to filter (e.g. Sony, Sky, Star, Jio, Ten)..." oninput="filterSportsQuickSelect(this.value)" class="w-full bg-gray-900 border border-gray-800 pl-9 pr-8 py-2.5 rounded-xl text-xs text-white placeholder-gray-500 focus:outline-none focus:border-red-500 transition-colors">
                            <i data-lucide="search" class="w-3.5 h-3.5 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                            <button type="button" id="btnClearSportsQuickSearch" onclick="clearSportsQuickSearch()" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white text-xs w-4 h-4 rounded-full flex items-center justify-center bg-gray-800 hover:bg-gray-700 transition-all" title="Clear filter">✕</button>
                        </div>
                        <button type="button" onclick="openSportsChannelPicker()" class="px-3.5 py-2.5 bg-red-600/20 hover:bg-red-600/30 border border-red-500/40 hover:border-red-500 text-red-300 hover:text-white rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all shadow-sm shrink-0" title="Open Visual Search Channel Picker">
                            <i data-lucide="search" class="w-3.5 h-3.5"></i>
                            <span>Search</span>
                        </button>
                    </div>

                    <!-- Filtered Dropdown Select -->
                    <select id="sportsQuickSelect" class="w-full bg-gray-900 border border-gray-800 p-3.5 rounded-xl text-xs text-white focus:outline-none focus:border-red-500 transition-colors" onchange="autoFillSportsForm(this)">
                        <option value="">-- Custom (Enter manually below) --</option>
                    </select>
                    <div id="sportsQuickSelectMatchInfo" class="hidden text-[10px] text-gray-400 flex items-center justify-between px-1">
                        <span id="sportsQuickSelectMatchCount" class="text-gray-400 font-medium">0 channels</span>
                        <span class="text-red-400/80 font-medium">Select above or click Search button</span>
                    </div>
                </div>
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Title <span class="text-red-500">*</span></label>
                    <input type="text" id="sportsTitle" required placeholder="e.g. Sky Sports Main Event" class="w-full bg-gray-900 border border-gray-800 p-4 rounded-xl text-sm text-white focus:outline-none focus:border-red-500 transition-colors">
                </div>
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Page Icon (Lucide name or Image URL Link) <span class="text-red-500">*</span></label>
                    <input type="text" id="sportsIcon" required placeholder="e.g. trophy, tv OR https://example.com/logo.png" class="w-full bg-gray-900 border border-gray-800 p-4 rounded-xl text-sm text-white focus:outline-none focus:border-red-500 transition-colors">
                </div>
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Showcase Container Assignment <span class="text-red-500">*</span></label>
                    <select id="sportsContainerSelect" class="w-full bg-gray-900 border border-gray-800 p-4 rounded-xl text-sm text-white focus:outline-none focus:border-red-500 transition-colors">
                        <!-- Populated dynamically via JS -->
                    </select>
                </div>
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">M3U or TS Stream Link <span class="text-red-500">*</span></label>
                    <input type="text" id="sportsUrl" required placeholder="e.g. http://server:port/live/user/pass/123.ts" class="w-full bg-gray-900 border border-gray-800 p-4 rounded-xl text-sm text-white focus:outline-none focus:border-red-500 transition-colors">
                </div>
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Channel Background Image URL (Optional)</label>
                    <input type="url" id="sportsBgUrl" placeholder="e.g. https://image.url/match-art.jpg" class="w-full bg-gray-900 border border-gray-800 p-4 rounded-xl text-sm text-white focus:outline-none focus:border-red-500 transition-colors">
                </div>
                <div class="pt-4">
                    <button type="submit" class="w-full py-4 bg-red-600 hover:bg-red-500 rounded-xl font-bold text-white text-sm flex items-center justify-center gap-2 transition-all shadow-lg shadow-red-600/10">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        <span>Save Stream</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Visual Sports Channel Search Picker Modal -->
    <div id="sportsChannelPickerModal" class="hidden fixed inset-0 bg-black/85 backdrop-blur-md z-[60] flex items-center justify-center p-4">
        <div class="bg-gray-950 border border-gray-800 w-full max-w-2xl rounded-2xl p-6 sm:p-7 animate-in zoom-in-95 duration-200 shadow-2xl max-h-[90vh] flex flex-col">
            <div class="flex items-center justify-between pb-4 border-b border-gray-800 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400">
                        <i data-lucide="search" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="text-white text-base sm:text-lg font-black uppercase tracking-tight flex items-center gap-2">
                            Search Channels Catalog
                        </h3>
                        <p class="text-xs text-gray-400">Quickly find and pick any channel from 5,200+ streams to auto-fill stream details.</p>
                    </div>
                </div>
                <button type="button" onclick="closeSportsChannelPicker()" class="p-2 text-gray-400 hover:text-white transition-colors rounded-xl hover:bg-gray-900">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Search and Filter Bar -->
            <div class="py-4 space-y-3 shrink-0">
                <div class="relative">
                    <input type="text" id="sportsPickerSearchInput" oninput="filterSportsPickerList()" placeholder="Search by channel name, source, or genre (e.g. Sony Ten, Sky Sports, Jio, Bein, TNT, Star, ESPN)..." class="w-full bg-gray-900 border border-gray-800 p-3 pl-10 pr-9 rounded-xl text-xs text-white placeholder-gray-500 focus:outline-none focus:border-red-500 transition-colors">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-3.5 text-gray-500 pointer-events-none"></i>
                    <button type="button" onclick="clearSportsPickerSearch()" id="btnClearSportsPickerSearch" class="hidden absolute right-3 top-3 text-gray-500 hover:text-white text-xs p-1 rounded hover:bg-gray-800">
                        <i data-lucide="x" class="w-3.5 h-3.5"></i>
                    </button>
                </div>

                <!-- Quick Genre Filter Pills -->
                <div class="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar text-[11px]" id="sportsPickerFilterPills">
                    <button type="button" onclick="setSportsPickerCategory('ALL')" class="sports-picker-pill px-3 py-1 rounded-lg font-bold bg-red-600 text-white shadow-sm shrink-0" data-cat="ALL">All Channels</button>
                    <button type="button" onclick="setSportsPickerCategory('Sports')" class="sports-picker-pill px-3 py-1 rounded-lg font-bold bg-gray-900 text-gray-400 hover:text-white border border-gray-800 shrink-0" data-cat="Sports">Sports</button>
                    <button type="button" onclick="setSportsPickerCategory('Sony')" class="sports-picker-pill px-3 py-1 rounded-lg font-bold bg-gray-900 text-gray-400 hover:text-white border border-gray-800 shrink-0" data-cat="Sony">Sony</button>
                    <button type="button" onclick="setSportsPickerCategory('Star')" class="sports-picker-pill px-3 py-1 rounded-lg font-bold bg-gray-900 text-gray-400 hover:text-white border border-gray-800 shrink-0" data-cat="Star">Star / Hotstar</button>
                    <button type="button" onclick="setSportsPickerCategory('Sky')" class="sports-picker-pill px-3 py-1 rounded-lg font-bold bg-gray-900 text-gray-400 hover:text-white border border-gray-800 shrink-0" data-cat="Sky">Sky Sports</button>
                    <button type="button" onclick="setSportsPickerCategory('Jio')" class="sports-picker-pill px-3 py-1 rounded-lg font-bold bg-gray-900 text-gray-400 hover:text-white border border-gray-800 shrink-0" data-cat="Jio">JioTV</button>
                    <button type="button" onclick="setSportsPickerCategory('Bein')" class="sports-picker-pill px-3 py-1 rounded-lg font-bold bg-gray-900 text-gray-400 hover:text-white border border-gray-800 shrink-0" data-cat="Bein">beIN</button>
                    <button type="button" onclick="setSportsPickerCategory('Entertainment')" class="sports-picker-pill px-3 py-1 rounded-lg font-bold bg-gray-900 text-gray-400 hover:text-white border border-gray-800 shrink-0" data-cat="Entertainment">Entertainment</button>
                </div>
            </div>

            <!-- Results Status Bar -->
            <div class="flex items-center justify-between pb-2 text-[11px] text-gray-400 shrink-0 px-1">
                <span id="sportsPickerResultCount">Loading catalog channels...</span>
                <span class="text-gray-500">Click any channel card to select</span>
            </div>

            <!-- Channels Results List Container -->
            <div id="sportsPickerResultsList" class="flex-1 overflow-y-auto space-y-2 pr-1 custom-scrollbar min-h-[260px] border border-gray-800/80 rounded-xl bg-gray-900/30 p-2">
                <!-- Dynamically filled -->
            </div>
        </div>
    </div>

    <!-- Live Events Modal -->
    <div id="liveEventsModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-gray-950 border border-gray-800 w-full max-w-lg rounded-2xl p-8 animate-in zoom-in-95 duration-200 shadow-2xl">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-800">
                <h3 id="liveEventsModalTitle" class="text-white text-lg font-black uppercase tracking-tight flex items-center gap-2">
                    <i data-lucide="zap" class="w-5 h-5 text-red-500"></i> Add Live Event
                </h3>
                <button onclick="toggleLiveEventsModal(false)" class="p-2 text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <form id="liveEventsForm" class="space-y-5" onsubmit="saveLiveEventStream(event)">
                <input type="hidden" id="liveEventsId">
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Title <span class="text-red-500">*</span></label>
                    <input type="text" id="liveEventsTitle" required placeholder="e.g. UFC 300" class="w-full bg-gray-900 border border-gray-800 p-4 rounded-xl text-sm text-white focus:outline-none focus:border-red-500 transition-colors">
                </div>
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Page Icon (Lucide name or Image URL Link) <span class="text-red-500">*</span></label>
                    <input type="text" id="liveEventsIcon" required placeholder="e.g. zap OR https://example.com/logo.png" class="w-full bg-gray-900 border border-gray-800 p-4 rounded-xl text-sm text-white focus:outline-none focus:border-red-500 transition-colors">
                </div>
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">M3U or TS Stream Link <span class="text-red-500">*</span></label>
                    <input type="url" id="liveEventsUrl" required placeholder="e.g. http://server:port/live/user/pass/123.ts" class="w-full bg-gray-900 border border-gray-800 p-4 rounded-xl text-sm text-white focus:outline-none focus:border-red-500 transition-colors">
                </div>
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Background Image URL (Optional)</label>
                    <input type="url" id="liveEventsBgUrl" placeholder="e.g. https://image.url" class="w-full bg-gray-900 border border-gray-800 p-4 rounded-xl text-sm text-white focus:outline-none focus:border-red-500 transition-colors">
                </div>
                <div class="pt-4">
                    <button type="submit" class="w-full py-4 bg-red-600 hover:bg-red-500 rounded-xl font-bold text-white text-sm flex items-center justify-center gap-2 transition-all shadow-lg shadow-red-600/10">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        <span>Save Event</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- Organizer Channel Modal (Add & Edit) -->
    <div id="organizerChannelModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-gray-950 border border-gray-800 w-full max-w-2xl rounded-2xl p-6 sm:p-8 animate-in zoom-in-95 duration-200 shadow-2xl max-h-[92vh] overflow-y-auto">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-800">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-cyan-500/10 border border-cyan-500/20 rounded-xl text-cyan-400">
                        <i data-lucide="tv" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 id="organizerChannelModalTitle" class="text-white text-lg font-black uppercase tracking-tight">
                            Add New Channel
                        </h3>
                        <p id="organizerChannelModalSubtitle" class="text-xs text-gray-400">Choose from our existing channel library or enter a custom stream.</p>
                    </div>
                </div>
                <button onclick="toggleOrganizerChannelModal(false)" class="p-2 text-gray-400 hover:text-white transition-colors rounded-xl hover:bg-gray-900">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Mode Selector Tabs (Only in Add Mode) -->
            <div id="channelModalSourceTabs" class="grid grid-cols-2 gap-2 p-1 bg-gray-900/90 border border-gray-800/80 rounded-xl mb-5">
                <button type="button" onclick="switchChannelModalTab('library')" id="tabBtnLibrary" class="py-2.5 px-3 rounded-lg text-xs font-bold flex items-center justify-center gap-2 transition-all bg-cyan-600 text-white shadow-md shadow-cyan-600/20">
                    <i data-lucide="library" class="w-4 h-4"></i>
                    <span>Select from Our Channels</span>
                </button>
                <button type="button" onclick="switchChannelModalTab('manual')" id="tabBtnManual" class="py-2.5 px-3 rounded-lg text-xs font-bold flex items-center justify-center gap-2 transition-all text-gray-400 hover:text-white">
                    <i data-lucide="pen-tool" class="w-4 h-4"></i>
                    <span>Custom / Manual Entry</span>
                </button>
            </div>

            <!-- VIEW 1: OUR CHANNELS LIBRARY PICKER -->
            <div id="channelLibraryPickerSection" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                    <div class="sm:col-span-3 relative">
                        <input type="text" id="libChannelSearchInput" oninput="filterLibraryChannels()" placeholder="Search channels by name or genre (e.g. HBO, Star, Sony, Telugu, Sports)..." class="w-full bg-gray-900 border border-gray-800 p-3 pl-9 rounded-xl text-xs text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500">
                        <i data-lucide="search" class="w-4 h-4 absolute left-3 top-3.5 text-gray-500"></i>
                        <button onclick="clearLibrarySearch()" id="btnClearLibSearch" class="hidden absolute right-3 top-3 text-gray-500 hover:text-white text-xs">
                            <i data-lucide="x" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Source Playlist</label>
                        <select id="libSourcePlaylistFilter" onchange="filterLibraryChannels()" class="w-full bg-gray-900 border border-gray-800 p-2.5 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500">
                            <option value="ALL">All Playlists & Portals</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Source Category</label>
                        <select id="libSourceGroupFilter" onchange="filterLibraryChannels()" class="w-full bg-gray-900 border border-gray-800 p-2.5 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500">
                            <option value="ALL">All Categories</option>
                        </select>
                    </div>
                    <div class="flex items-end">
                        <button onclick="refreshLibraryChannels(true)" class="w-full py-2.5 px-3 bg-gray-900 hover:bg-gray-800 border border-gray-800 text-cyan-400 hover:text-cyan-300 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-all">
                            <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                            <span>Reload Library</span>
                        </button>
                    </div>
                </div>

                <!-- Library Channel Results List -->
                <div class="border border-gray-800/80 rounded-xl bg-gray-900/40 p-1">
                    <div class="flex items-center justify-between px-3 py-2 border-b border-gray-800/60 text-[11px]">
                        <span class="text-gray-400 font-medium">Available Channels in Our Library:</span>
                        <span id="libResultCountBadge" class="font-mono text-cyan-400 font-bold">Loading...</span>
                    </div>
                    <div id="libChannelsContainer" class="max-h-72 overflow-y-auto divide-y divide-gray-800/50 p-1 space-y-0.5">
                        <div class="py-8 text-center text-gray-500 text-xs italic">Loading our channel library...</div>
                    </div>
                </div>
            </div>

            <!-- VIEW 2: MANUAL FORM / CHANNEL CUSTOMIZATION -->
            <form id="organizerChannelForm" class="space-y-4 mt-2" onsubmit="saveOrganizerChannelForm(event)">
                <input type="hidden" id="modalChannelId">
                <input type="hidden" id="modalChannelMode" value="edit">

                <!-- Selected Channel Source Notice -->
                <div id="selectedChannelSourceBanner" class="p-3 bg-cyan-950/40 border border-cyan-500/30 rounded-xl flex items-center justify-between hidden">
                    <div class="flex items-center gap-2">
                        <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
                        <span class="text-xs text-gray-300">Selected from: <strong id="selectedChannelSourceText" class="text-cyan-300"></strong></span>
                    </div>
                    <button type="button" onclick="switchChannelModalTab('library')" class="text-xs text-cyan-400 hover:text-cyan-300 font-bold flex items-center gap-1">
                        <i data-lucide="library" class="w-3.5 h-3.5"></i>
                        <span>Change Channel</span>
                    </button>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block">Channel Name <span class="text-cyan-400">*</span></label>
                        <button type="button" onclick="switchChannelModalTab('library')" class="text-[11px] text-cyan-400 hover:text-cyan-300 font-bold flex items-center gap-1">
                            <i data-lucide="library" class="w-3 h-3"></i>
                            <span>Select from Our Channels</span>
                        </button>
                    </div>
                    <div class="flex gap-2">
                        <input type="text" id="modalChannelName" required placeholder="e.g. HBO HD, Star Sports 1" oninput="onModalChannelNameChange(this.value)" class="flex-1 bg-gray-900 border border-gray-800 p-3.5 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500 transition-colors">
                        <button type="button" onclick="autoResolveModalLogo()" class="px-3.5 bg-indigo-600/30 hover:bg-indigo-600 border border-indigo-500/40 text-indigo-300 hover:text-white rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all shrink-0" title="Auto-find official logo from IPTV-ORG database">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                            <span>Find Logo</span>
                        </button>
                    </div>
                </div>

                <!-- Sub-section / Category -->
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Target Sub-Section (Category) <span class="text-cyan-400">*</span></label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <select id="modalChannelGroupSelect" onchange="onModalGroupSelectChange(this.value)" class="bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500 font-bold">
                            <option value="General">General</option>
                        </select>
                        <input type="text" id="modalChannelGroupCustom" placeholder="Or enter new category..." class="bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500">
                    </div>
                </div>

                <!-- Stream URL -->
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Stream URL (.m3u8, .ts, .mpd) <span class="text-cyan-400">*</span></label>
                    <div class="flex gap-2">
                        <input type="url" id="modalChannelStreamUrl" required placeholder="https://domain.com/live/stream.m3u8" class="flex-1 bg-gray-900 border border-gray-800 p-3.5 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500 transition-colors font-mono">
                        <button type="button" onclick="testModalStreamUrl()" class="px-3.5 bg-emerald-600/20 hover:bg-emerald-600/40 border border-emerald-500/40 text-emerald-300 hover:text-white rounded-xl text-xs font-bold flex items-center gap-1 transition-all shrink-0" title="Test if stream is live">
                            <i data-lucide="zap" class="w-3.5 h-3.5 text-emerald-400"></i>
                            <span>Test</span>
                        </button>
                    </div>
                </div>

                <!-- Channel Logo -->
                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Channel Logo URL</label>
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl bg-black/60 border border-gray-800 p-1 flex items-center justify-center shrink-0 overflow-hidden">
                            <img id="modalLogoPreview" src="https://ui-avatars.com/api/?name=TV&background=0284c7&color=fff&size=64" alt="" class="w-full h-full object-contain" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=TV&background=0284c7&color=fff&size=64';">
                        </div>
                        <input type="url" id="modalChannelLogo" placeholder="https://example.com/logo.png" oninput="updateModalLogoPreview(this.value)" class="flex-1 bg-gray-900 border border-gray-800 p-3.5 rounded-xl text-xs text-white focus:outline-none focus:border-cyan-500 transition-colors">
                    </div>
                </div>

                <!-- Advanced Options Collapsible -->
                <details class="bg-gray-900/40 border border-gray-800/80 rounded-xl p-3 text-xs text-gray-400">
                    <summary class="cursor-pointer font-bold text-gray-300 select-none flex items-center justify-between">
                        <span>Advanced Metadata (User-Agent & EPG ID)</span>
                        <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                    </summary>
                    <div class="space-y-3 pt-3 mt-2 border-t border-gray-800/60">
                        <div>
                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Custom HTTP User-Agent</label>
                            <input type="text" id="modalChannelUA" placeholder="e.g. VLC/3.0.18 LibVLC/3.0.18" class="w-full bg-gray-900 border border-gray-800 p-2.5 rounded-lg text-xs text-white focus:outline-none focus:border-cyan-500">
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">tvg-id / XMLTV EPG ID</label>
                            <input type="text" id="modalChannelXmltv" placeholder="e.g. HBOHD.us, StarSports1.in" class="w-full bg-gray-900 border border-gray-800 p-2.5 rounded-lg text-xs text-white focus:outline-none focus:border-cyan-500">
                        </div>
                    </div>
                </details>

                <div class="pt-3 flex gap-3">
                    <button type="button" onclick="toggleOrganizerChannelModal(false)" class="flex-1 py-3 bg-gray-900 hover:bg-gray-800 border border-gray-800 rounded-xl font-bold text-gray-300 text-xs transition-colors">
                        Cancel
                    </button>
                    <button type="submit" id="btnSubmitChannelModal" class="flex-1 py-3 bg-cyan-600 hover:bg-cyan-500 rounded-xl font-bold text-white text-xs flex items-center justify-center gap-2 transition-all shadow-lg shadow-cyan-600/20">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        <span id="btnSubmitChannelModalText">Save Channel</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Organizer New Sub-section Modal -->
    <div id="organizerSubsectionModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-gray-950 border border-gray-800 w-full max-w-md rounded-2xl p-6 sm:p-8 animate-in zoom-in-95 duration-200 shadow-2xl">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-800">
                <h3 id="organizerSubModalTitle" class="text-white text-lg font-black uppercase tracking-tight flex items-center gap-2">
                    <i data-lucide="folder-plus" class="w-5 h-5 text-indigo-400"></i>
                    <span>New Sub-Section</span>
                </h3>
                <button onclick="toggleOrganizerSubModal(false)" class="p-2 text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <form id="organizerSubForm" class="space-y-4" onsubmit="saveOrganizerSubForm(event)">
                <input type="hidden" id="modalSubMode" value="create">
                <input type="hidden" id="modalSubOldName" value="">
                <div>
                    <label id="modalSubNameLabel" class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Sub-Section / Category Name <span class="text-indigo-400">*</span></label>
                    <input type="text" id="modalSubName" required placeholder="e.g. Premium Movies, Live Sports, News HD" class="w-full bg-gray-900 border border-gray-800 p-3.5 rounded-xl text-xs text-white focus:outline-none focus:border-indigo-500 transition-colors">
                </div>
                <div class="pt-3 flex gap-3">
                    <button type="button" onclick="toggleOrganizerSubModal(false)" class="flex-1 py-3 bg-gray-900 hover:bg-gray-800 border border-gray-800 rounded-xl font-bold text-gray-300 text-xs transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="flex-1 py-3 bg-indigo-600 hover:bg-indigo-500 rounded-xl font-bold text-white text-xs flex items-center justify-center gap-2 transition-all shadow-lg shadow-indigo-600/20">
                        <i data-lucide="check" class="w-4 h-4"></i>
                        <span id="btnSubmitSubModalText">Create Sub-Section</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Channels JSON Studio: Add / Edit Channel Modal -->
    <div id="cjChannelModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-gray-950 border border-gray-800 w-full max-w-lg rounded-2xl p-6 sm:p-8 animate-in zoom-in-95 duration-200 shadow-2xl">
            <div class="flex items-center justify-between mb-5 pb-3 border-b border-gray-800">
                <div class="flex items-center gap-2.5">
                    <div class="p-2 bg-amber-500/10 text-amber-400 rounded-xl border border-amber-500/20">
                        <i data-lucide="tv" class="w-5 h-5"></i>
                    </div>
                    <h3 id="cjChannelModalTitle" class="text-white text-base font-black uppercase tracking-tight">Add Channel to JSON</h3>
                </div>
                <button onclick="toggleCjChannelModal(false)" class="p-2 text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <form id="cjChannelForm" class="space-y-4" onsubmit="saveCjChannelForm(event)">
                <input type="hidden" id="cjFormMode" value="add">
                <input type="hidden" id="cjFormOriginalUrl" value="">

                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Channel Name <span class="text-amber-400">*</span></label>
                    <input type="text" id="cjFormName" required placeholder="e.g. ESPN HD, HBO, Sky Cinema" class="w-full bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-amber-500 transition-colors">
                </div>

                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Stream URL (channel_id) <span class="text-amber-400">*</span></label>
                    <input type="url" id="cjFormUrl" required placeholder="https://example.com/stream.m3u8" class="w-full bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white font-mono focus:outline-none focus:border-amber-500 transition-colors">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Category / Genre</label>
                        <input type="text" id="cjFormGenre" placeholder="e.g. Sports, Entertainment" list="cjGenreDataList" class="w-full bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-amber-500 transition-colors">
                        <datalist id="cjGenreDataList"></datalist>
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">Source Tag</label>
                        <input type="text" id="cjFormSource" placeholder="e.g. custom_manual" class="w-full bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-amber-500 transition-colors">
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block">Channel Logo URL</label>
                        <button type="button" id="btnCjSearchLogoWeb" onclick="searchCjModalLogoWeb()" class="px-2.5 py-1 bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/30 text-amber-300 rounded-lg text-[11px] font-bold flex items-center gap-1.5 transition-all">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-400"></i>
                            <span>Search Web Logo (DDG / Yahoo)</span>
                        </button>
                    </div>
                    <div class="flex gap-2 items-center">
                        <div id="cjFormLogoPreviewBox" class="w-11 h-11 rounded-xl bg-gray-900 border border-gray-800 flex-shrink-0 flex items-center justify-center overflow-hidden p-1">
                            <i data-lucide="image" class="w-5 h-5 text-gray-600"></i>
                        </div>
                        <input type="url" id="cjFormLogo" oninput="updateCjFormLogoPreview(this.value)" placeholder="https://example.com/logo.png" class="flex-1 bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white focus:outline-none focus:border-amber-500 transition-colors">
                    </div>
                    <p id="cjLogoSearchResultNote" class="text-[10px] text-gray-500 mt-1 hidden"></p>
                </div>

                <div class="pt-3 flex gap-3">
                    <button type="button" onclick="toggleCjChannelModal(false)" class="flex-1 py-3 bg-gray-900 hover:bg-gray-800 border border-gray-800 rounded-xl font-bold text-gray-300 text-xs transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="flex-1 py-3 bg-amber-600 hover:bg-amber-500 rounded-xl font-bold text-white text-xs flex items-center justify-center gap-2 transition-all shadow-lg shadow-amber-600/20">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        <span id="cjFormSubmitBtnText">Save Channel</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Channels JSON Studio: Stream Preview Player Modal -->
    <div id="cjStreamModal" class="hidden fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-gray-950 border border-gray-800 w-full max-w-2xl rounded-2xl p-6 animate-in zoom-in-95 duration-200 shadow-2xl space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-gray-800">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-red-500/10 text-red-400 rounded-xl border border-red-500/20">
                        <i data-lucide="play-circle" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 id="cjPlayerTitle" class="text-white text-base font-black truncate max-w-sm">Stream Preview</h3>
                        <p id="cjPlayerGenre" class="text-[11px] text-gray-400">Loading stream...</p>
                    </div>
                </div>
                <button onclick="closeCjStreamModal()" class="p-2 text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <div class="relative bg-black rounded-xl overflow-hidden aspect-video border border-gray-800 flex items-center justify-center">
                <video id="cjVideoPlayer" controls autoplay class="w-full h-full object-contain"></video>
                <div id="cjVideoStatus" class="hidden absolute bg-black/75 px-4 py-2 rounded-xl text-xs font-bold text-white flex items-center gap-2">
                    <i data-lucide="loader-2" class="w-4 h-4 animate-spin text-amber-400"></i>
                    <span>Initializing stream...</span>
                </div>
            </div>
            <div class="p-3 bg-gray-900/60 rounded-xl border border-gray-800/80 flex items-center justify-between text-xs">
                <span id="cjPlayerUrl" class="font-mono text-gray-400 truncate max-w-md text-[11px]"></span>
                <button onclick="copyCjPlayerUrl()" class="px-2.5 py-1 bg-gray-800 hover:bg-gray-700 text-white rounded text-[10px] font-bold">Copy URL</button>
            </div>
        </div>
    </div>

    <!-- Channels JSON Studio: Genre Purge Modal -->
    <div id="cjPurgeModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-gray-950 border border-rose-900/40 w-full max-w-md rounded-2xl p-6 animate-in zoom-in-95 duration-200 shadow-2xl space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-gray-800">
                <div class="flex items-center gap-2.5">
                    <div class="p-2 bg-rose-500/10 text-rose-400 rounded-xl border border-rose-500/20">
                        <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                    </div>
                    <h3 class="text-white text-base font-black uppercase">Purge Genre Channels</h3>
                </div>
                <button onclick="toggleCjPurgeModal(false)" class="p-2 text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <p class="text-xs text-gray-300">Select the category / genre you wish to completely remove from <code class="text-amber-400">channels.json</code>. An automatic backup will be created.</p>
            <div>
                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1.5">Select Category to Delete</label>
                <select id="cjPurgeGenreSelect" class="w-full bg-gray-900 border border-gray-800 p-3 rounded-xl text-xs text-white font-bold focus:outline-none focus:border-rose-500">
                </select>
            </div>
            <div class="pt-2 flex gap-3">
                <button type="button" onclick="toggleCjPurgeModal(false)" class="flex-1 py-3 bg-gray-900 hover:bg-gray-800 border border-gray-800 rounded-xl font-bold text-gray-300 text-xs transition-colors">
                    Cancel
                </button>
                <button type="button" onclick="executeGenrePurge()" class="flex-1 py-3 bg-rose-600 hover:bg-rose-500 rounded-xl font-bold text-white text-xs flex items-center justify-center gap-2 transition-all shadow-lg shadow-rose-600/20">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                    <span>Purge Category</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Channels JSON Studio: Live Web Logo Search Progress Modal -->
    <div id="cjLogoProgressModal" class="hidden fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-gray-950 border border-cyan-500/30 w-full max-w-xl rounded-2xl p-6 animate-in zoom-in-95 duration-200 shadow-2xl shadow-cyan-950/40 space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-gray-800">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 bg-cyan-500/10 text-cyan-400 rounded-xl border border-cyan-500/20">
                        <i data-lucide="sparkles" class="w-5 h-5 animate-pulse"></i>
                    </div>
                    <div>
                        <h3 class="text-white text-base font-black flex items-center gap-2">
                            <span>Web Logo Search & Fix</span>
                            <span class="text-[10px] bg-cyan-500/20 text-cyan-300 px-2 py-0.5 rounded-full font-bold border border-cyan-500/30">Logopedia + DDG + Yahoo</span>
                        </h3>
                        <p id="cjLogoProgressSub" class="text-[11px] text-gray-400">Resolving official transparent network logos with Wikimedia backup...</p>
                    </div>
                </div>
                <button onclick="abortCjLogoFix()" id="btnAbortCjLogoFix" class="p-2 text-gray-400 hover:text-white transition-colors" title="Close / Stop">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Progress Bar Area -->
            <div class="space-y-2">
                <div class="flex justify-between text-xs">
                    <span id="cjLogoProgressCurrentChannel" class="font-bold text-cyan-300 truncate max-w-xs">Initializing scraper...</span>
                    <span id="cjLogoProgressPercent" class="font-mono font-black text-amber-400">0%</span>
                </div>
                <div class="w-full bg-gray-900 rounded-full h-3.5 overflow-hidden border border-gray-800 p-0.5">
                    <div id="cjLogoProgressBarFill" class="bg-gradient-to-r from-cyan-500 via-teal-400 to-amber-400 h-full rounded-full transition-all duration-200 shadow-lg shadow-cyan-500/30" style="width: 0%;"></div>
                </div>
            </div>

            <!-- Live Status & Stats Counter Grid -->
            <div class="grid grid-cols-3 gap-3">
                <div class="p-3 bg-gray-900/60 rounded-xl border border-gray-800/80 text-center">
                    <p class="text-[10px] uppercase font-bold text-gray-500 tracking-wider">Processed</p>
                    <p id="cjLogoStatProcessed" class="text-lg font-black text-white font-mono mt-0.5">0 / 0</p>
                </div>
                <div class="p-3 bg-emerald-950/20 rounded-xl border border-emerald-500/20 text-center">
                    <p class="text-[10px] uppercase font-bold text-emerald-400 tracking-wider">Logos Resolved</p>
                    <p id="cjLogoStatResolved" class="text-lg font-black text-emerald-400 font-mono mt-0.5">0</p>
                </div>
                <div class="p-3 bg-cyan-950/20 rounded-xl border border-cyan-500/20 text-center">
                    <p class="text-[10px] uppercase font-bold text-cyan-400 tracking-wider">Current Engine</p>
                    <p id="cjLogoStatEngine" class="text-xs font-black text-cyan-300 truncate mt-1">LOGOPEDIA</p>
                </div>
            </div>

            <!-- Live Item Activity Box -->
            <div class="p-3.5 bg-gray-900/40 rounded-xl border border-gray-800/70 flex items-center gap-3 min-h-[64px]">
                <div id="cjLogoActivePreviewBox" class="w-12 h-12 rounded-xl bg-gray-900 border border-gray-800 flex items-center justify-center p-1 overflow-hidden flex-shrink-0">
                    <i data-lucide="image" class="w-5 h-5 text-gray-600"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between">
                        <span id="cjLogoActiveTitle" class="text-xs font-bold text-white truncate block">Connecting to scraper stream...</span>
                        <span id="cjLogoActiveBadge" class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-gray-800 text-gray-400 uppercase">SEARCHING</span>
                    </div>
                    <p id="cjLogoActiveUrl" class="text-[10px] text-gray-500 truncate font-mono mt-0.5">Logopedia (logos.fandom.com) → DuckDuckGo → Yahoo → Wikimedia (Backup)</p>
                </div>
            </div>

            <!-- Modal Action Buttons -->
            <div class="pt-2 flex gap-3">
                <button type="button" onclick="abortCjLogoFix()" id="btnStopCjLogoFix" class="flex-1 py-2.5 bg-gray-900 hover:bg-gray-800 border border-gray-800 rounded-xl font-bold text-gray-300 text-xs transition-colors">
                    Stop / Cancel
                </button>
                <button type="button" onclick="finishCjLogoFixModal()" id="btnDoneCjLogoFix" class="hidden flex-1 py-2.5 bg-gradient-to-r from-cyan-600 to-teal-600 hover:from-cyan-500 hover:to-teal-500 text-white rounded-xl font-bold text-xs shadow-lg shadow-cyan-600/20 transition-all">
                    Done (Close & Refresh)
                </button>
            </div>
        </div>
    </div>

    <!-- Universal Confirmation Dialog Modal (Guaranteed to work in all iFrames/Browsers) -->
    <div id="appUniversalConfirmModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-[999] flex items-center justify-center p-4">
        <div class="bg-gray-950 border border-rose-500/30 w-full max-w-md rounded-2xl p-6 animate-in zoom-in-95 duration-200 shadow-2xl shadow-rose-950/40 space-y-4">
            <div class="flex items-center gap-3 pb-3 border-b border-gray-800">
                <div id="appConfirmModalIconContainer" class="p-2.5 bg-rose-500/10 text-rose-400 rounded-xl border border-rose-500/20 flex-shrink-0">
                    <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 id="appConfirmModalTitle" class="text-white text-base font-black truncate">Confirm Action</h3>
                    <p class="text-[11px] text-gray-400">Please confirm your request to continue</p>
                </div>
                <button type="button" onclick="handleAppConfirmModalAction(false)" class="p-2 text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <p id="appConfirmModalMessage" class="text-xs text-gray-300 leading-relaxed"></p>
            <div class="pt-2 flex gap-3">
                <button type="button" id="appConfirmModalBtnCancel" onclick="handleAppConfirmModalAction(false)" class="flex-1 py-3 bg-gray-900 hover:bg-gray-800 border border-gray-800 rounded-xl font-bold text-gray-300 text-xs transition-colors">
                    Cancel
                </button>
                <button type="button" id="appConfirmModalBtnConfirm" onclick="handleAppConfirmModalAction(true)" class="flex-1 py-3 bg-rose-600 hover:bg-rose-500 rounded-xl font-bold text-white text-xs flex items-center justify-center gap-2 transition-all shadow-lg shadow-rose-600/20">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                    <span>Confirm Delete</span>
                </button>
            </div>
        </div>
    </div>

    <!-- UI TOAST -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-10 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="bg-gray-900 border border-gray-800 rounded-2xl p-4 shadow-2xl flex items-center gap-3 pr-6">
            <div id="toastIconBg" class="p-2 rounded-xl">
                <i id="toastIcon" class="w-4 h-4"></i>
            </div>
            <div>
                <p id="toastTitle" class="font-bold text-sm text-white"></p>
                <p id="toastMessage" class="text-xs text-gray-400"></p>
            </div>
        </div>
    </div>
    <!-- Shared Admin Music Audio Element -->
    <audio id="adminMusicPlayer" preload="auto" class="hidden"></audio>

    <script src="/hari.js?v=7.0"></script>

    <!-- Aetheris AI Widget -->
    <link rel="stylesheet" href="/local-ai.css">
    <script src="/local-ai.js"></script>

    <!-- WebRTC Studio Modal -->
    <div id="webrtcStudioModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-3 sm:p-4 bg-black/80 backdrop-blur-sm animate-in fade-in">
        <div class="bg-gray-900 border border-gray-700 rounded-2xl w-full max-w-6xl max-h-[94vh] shadow-2xl overflow-hidden flex flex-col">
            <div class="p-4 border-b border-gray-800 flex justify-between items-center bg-gray-900 shrink-0">
                <div class="flex items-center gap-3">
                    <span class="w-3 h-3 rounded-full bg-blue-500 animate-pulse shadow-lg shadow-blue-500/50"></span>
                    <div>
                        <h3 class="text-white font-bold text-base flex items-center gap-2">
                            WebRTC Live Studio Pro
                            <span id="webrtcModalStatusBadge" class="text-[9px] uppercase px-2 py-0.5 rounded-full font-bold bg-yellow-500/20 text-yellow-300 border border-yellow-500/30">Offline</span>
                        </h3>
                        <p class="text-[11px] text-gray-400">Direct peer-to-peer live streaming engine with hardware diagnostics.</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="detectWebRTCDevices(false, true)" class="px-3 py-1.5 rounded-xl bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white text-xs font-semibold transition-all border border-gray-700 flex items-center gap-1.5" title="Re-scan connected cameras and microphones">
                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-blue-400"></i>
                        <span>Scan Hardware</span>
                    </button>
                    <button onclick="window.closeWebRTCStudio()" class="p-2 text-gray-400 hover:text-white hover:bg-gray-800 rounded-xl transition-colors">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>

            <!-- Hardware Detection Bar -->
            <div class="px-4 py-2.5 bg-black/40 border-b border-gray-800/80 flex flex-wrap items-center justify-between gap-3 text-xs shrink-0">
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-1.5">
                        <span class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Camera:</span>
                        <span id="webrtcModalCamDetectBadge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                            <span id="webrtcModalCamDetectName">Detecting Camera...</span>
                        </span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Microphone:</span>
                        <span id="webrtcModalMicDetectBadge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                            <span id="webrtcModalMicDetectName">Detecting Mic...</span>
                        </span>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <label class="text-[10px] text-gray-400 font-bold uppercase">Video Quality:</label>
                    <select id="webrtcQualitySelect" onchange="changeWebRTCQuality(this.value)" class="bg-gray-900 border border-blue-500/40 text-blue-200 text-xs rounded-lg px-2.5 py-1 font-medium focus:ring-1 focus:ring-blue-500 outline-none">
                        <option value="720p" selected>720p HD (Optimal • 2.2 Mbps)</option>
                        <option value="1080p">1080p FHD (Ultra Quality • 3.5 Mbps)</option>
                        <option value="480p">480p SD (Low Bandwidth • 1.0 Mbps)</option>
                    </select>
                </div>
            </div>
            
            <div class="overflow-y-auto max-h-[calc(94vh-125px)] p-4 space-y-4">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
                    <!-- Video Preview Screen -->
                    <div class="lg:col-span-8 bg-black rounded-2xl overflow-hidden relative aspect-video flex items-center justify-center border border-gray-800 shadow-inner group">
                        <video id="webrtcLocalVideo" autoplay muted playsinline class="w-full h-full object-cover hidden"></video>
                        
                        <div id="webrtcPlaceholder" class="text-center p-6">
                            <div class="w-16 h-16 rounded-full bg-blue-500/10 border border-blue-500/20 flex items-center justify-center mx-auto mb-3 text-blue-400">
                                <i data-lucide="video" class="w-8 h-8"></i>
                            </div>
                            <p class="text-white text-sm font-bold">Studio Preview Offline</p>
                            <p class="text-gray-400 text-xs mt-1">Activate camera to verify audio & video inputs before broadcasting</p>
                            <button type="button" onclick="initWebRTCDevices()" class="mt-3 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition-all shadow-lg shadow-blue-500/30 flex items-center gap-2 mx-auto">
                                <i data-lucide="camera" class="w-4 h-4"></i>
                                <span>Activate Camera Preview</span>
                            </button>
                        </div>

                        <!-- Video HUD Badges -->
                        <div class="absolute top-3 left-3 flex items-center gap-2 pointer-events-none">
                            <span id="webrtcModalResBadge" class="hidden px-2.5 py-1 rounded-md bg-black/80 backdrop-blur-sm border border-white/20 text-xs font-mono text-emerald-400 font-bold">
                                1280x720 • 30fps
                            </span>
                            <span id="webrtcModalShareBadge" class="hidden px-2.5 py-1 rounded-md bg-purple-600/90 backdrop-blur-sm border border-purple-400/40 text-xs font-bold text-white uppercase">
                                🖥️ SCREEN SHARE ACTIVE
                            </span>
                        </div>
                        
                        <!-- Overlay Controls -->
                        <div class="absolute bottom-4 left-0 w-full flex flex-wrap justify-center items-center gap-2 px-3">
                            <button id="btnToggleCam" onclick="window.toggleWebrtcCam()" class="px-3.5 py-2 rounded-xl bg-gray-900/90 hover:bg-black text-white flex items-center gap-2 border border-gray-700 transition-all backdrop-blur-md text-xs font-medium shadow-md" title="Mute/Unmute Video">
                                <i id="iconCam" data-lucide="video" class="w-4 h-4 text-blue-400"></i>
                                <span>Camera</span>
                            </button>
                            <button id="btnToggleMic" onclick="window.toggleWebrtcMic()" class="px-3.5 py-2 rounded-xl bg-gray-900/90 hover:bg-black text-white flex items-center gap-2 border border-gray-700 transition-all backdrop-blur-md text-xs font-medium shadow-md" title="Mute/Unmute Audio">
                                <i id="iconMic" data-lucide="mic" class="w-4 h-4 text-blue-400"></i>
                                <span>Microphone</span>
                            </button>
                            <button id="btnToggleShare" onclick="window.toggleWebRTCScreenShare()" class="px-3.5 py-2 rounded-xl bg-gray-900/90 hover:bg-purple-900/80 text-white flex items-center gap-2 border border-gray-700 transition-all backdrop-blur-md text-xs font-medium shadow-md" title="Share Screen or App Window">
                                <i id="iconShare" data-lucide="monitor" class="w-4 h-4 text-purple-400"></i>
                                <span>Share Screen</span>
                            </button>
                            <button id="btnToggleMirror" onclick="window.toggleWebRTCMirror()" class="px-3 py-2 rounded-xl bg-gray-900/90 hover:bg-black text-gray-300 hover:text-white flex items-center gap-1.5 border border-gray-700 transition-all backdrop-blur-md text-xs font-medium shadow-md" title="Flip Camera Preview">
                                <i data-lucide="flip-horizontal" class="w-4 h-4 text-blue-400"></i>
                                <span class="hidden sm:inline">Mirror</span>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Controls Sidebar -->
                    <div class="lg:col-span-4 flex flex-col justify-between gap-3">
                        <div class="bg-gray-800/50 rounded-xl p-4 border border-gray-700/50 space-y-3">
                            <h4 class="text-white text-xs font-bold uppercase tracking-wider flex items-center justify-between">
                                <span>Input Devices</span>
                                <span class="text-[10px] text-blue-400 font-mono">P2P HD</span>
                            </h4>
                            
                            <!-- Camera Input -->
                            <div>
                                <label class="flex justify-between items-center text-[10px] text-gray-400 uppercase font-bold mb-1">
                                    <span>Camera Device</span>
                                    <span id="webrtcModalCamCount" class="text-[9px] text-blue-400 lowercase font-normal">1 detected</span>
                                </label>
                                <select id="webrtcVideoSource" onchange="switchWebRTCCamera(this.value)" class="w-full bg-gray-900 border border-gray-700 rounded-lg p-2 text-xs text-white focus:border-blue-500 outline-none">
                                    <option value="">Default Camera</option>
                                </select>
                            </div>
                            
                            <!-- Microphone Input & Live VU Meter -->
                            <div>
                                <label class="flex justify-between items-center text-[10px] text-gray-400 uppercase font-bold mb-1">
                                    <span>Microphone Device</span>
                                    <span id="webrtcModalMicCount" class="text-[9px] text-blue-400 lowercase font-normal">1 detected</span>
                                </label>
                                <select id="webrtcAudioSource" onchange="switchWebRTCMic(this.value)" class="w-full bg-gray-900 border border-gray-700 rounded-lg p-2 text-xs text-white focus:border-blue-500 outline-none">
                                    <option value="">Default Microphone</option>
                                </select>

                                <!-- Live VU Meter -->
                                <div class="mt-2 p-2.5 rounded-lg bg-gray-900/90 border border-gray-800 space-y-1.5">
                                    <div class="flex justify-between items-center text-[10px]">
                                        <span class="text-gray-400 flex items-center gap-1">
                                            <i data-lucide="volume-2" class="w-3.5 h-3.5 text-emerald-400"></i>
                                            <span>Live Mic Volume:</span>
                                        </span>
                                        <span id="webrtcModalVUText" class="text-emerald-400 font-bold font-mono">Silent (0%)</span>
                                    </div>
                                    <div class="h-2.5 w-full bg-gray-950 rounded-full overflow-hidden border border-white/5">
                                        <div id="webrtcModalVUBars" class="h-full bg-emerald-400 transition-all duration-75 w-0 rounded-full"></div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="pt-2">
                                <button id="btnStartWebRTC" onclick="window.startWebRTCBroadcast()" class="w-full py-3 rounded-xl bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-sm flex items-center justify-center gap-2 transition-all shadow-lg shadow-blue-500/30">
                                    <i data-lucide="radio" class="w-4 h-4 text-white animate-pulse"></i>
                                    <span>Go Live on Maintenance</span>
                                </button>
                                <button id="btnStopWebRTC" onclick="window.stopWebRTCBroadcast()" class="hidden w-full py-3 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-sm flex items-center justify-center gap-2 transition-all mt-2 shadow-lg shadow-red-500/30">
                                    <i data-lucide="square" class="w-4 h-4"></i>
                                    <span>End Live Broadcast</span>
                                </button>
                            </div>
                        </div>
                        
                        <!-- Stream Telemetry Card -->
                        <div class="bg-gray-800/50 rounded-xl p-4 border border-gray-700/50">
                            <h4 class="text-white text-xs font-bold uppercase tracking-wider mb-2.5 flex items-center justify-between">
                                <span>Live Diagnostics</span>
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                            </h4>
                            <div class="space-y-2 text-xs">
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-400">Broadcast Status:</span>
                                    <span id="webrtcStatus" class="text-yellow-400 font-bold">Offline</span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-400">Active Viewers:</span>
                                    <span id="webrtcViewers" class="text-white font-mono font-bold">0</span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-400">Video Encoding:</span>
                                    <span id="webrtcBitrate" class="text-white font-mono">720P (~2200 kbps)</span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-400">Audio Codec:</span>
                                    <span class="text-blue-300 font-mono">Opus 48kHz Stereo</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FULL-WIDTH INTERACTIVE LIVE CONFERENCE & CO-HOST STAGE MANAGER (MODAL) -->
                <div class="p-4 rounded-2xl bg-slate-900/95 border border-cyan-500/30 shadow-2xl space-y-3.5">
                    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-cyan-500/20">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-md shadow-cyan-500/20">
                                <i data-lucide="users" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="text-white text-sm font-bold tracking-wide">Video Conference & Co-Hosts Stage</span>
                                    <span id="modalAdminConferenceBadge" class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-gray-800 text-gray-400 border border-gray-700">Disabled</span>
                                </div>
                                <p class="text-[11px] text-gray-400">Allow viewers to request face-to-face conference talk or private 1-on-1 consultation.</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 bg-black/40 px-3 py-1.5 rounded-xl border border-white/10">
                            <span id="modalAdminConferenceToggleLabel" class="text-xs font-bold text-gray-300">Allow Requests</span>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="modalAdminConferenceToggle" onchange="window.toggleAdminConference(this.checked)" class="sr-only peer">
                                <div class="w-11 h-6 bg-gray-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gradient-to-r peer-checked:from-cyan-500 peer-checked:to-blue-600 border border-gray-700"></div>
                            </label>
                        </div>
                    </div>

                    <!-- 3-Column Responsive Interactive Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
                        <!-- 1. Stage Requests Queue -->
                        <div class="bg-black/50 border border-gray-800 rounded-xl p-3 flex flex-col space-y-2">
                            <div class="flex items-center justify-between text-xs pb-1.5 border-b border-gray-800/80">
                                <span class="text-gray-300 font-semibold flex items-center gap-1.5">
                                    <i data-lucide="user-plus" class="w-3.5 h-3.5 text-cyan-400"></i>
                                    <span>Stage Requests</span>
                                    <span id="modalAdminPendingCountBadge" class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/40">0</span>
                                </span>
                                <span class="text-[9px] text-gray-500">Auto-refreshes</span>
                            </div>
                            <div id="modalAdminPendingRequestsList" class="space-y-1.5 max-h-52 overflow-y-auto pr-1 flex-1">
                                <div class="p-3 rounded-lg bg-black/40 border border-dashed border-gray-800 text-center text-gray-500 text-xs">
                                    No pending join requests from viewers right now.
                                </div>
                            </div>
                        </div>

                        <!-- 2. Active Co-Hosts & Guests -->
                        <div class="bg-black/50 border border-gray-800 rounded-xl p-3 flex flex-col space-y-2">
                            <div class="flex items-center justify-between text-xs pb-1.5 border-b border-gray-800/80">
                                <span class="text-gray-300 font-semibold flex items-center gap-1.5">
                                    <i data-lucide="video" class="w-3.5 h-3.5 text-emerald-400"></i>
                                    <span>Active on Stage</span>
                                    <span id="modalAdminActiveCountBadge" class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">0</span>
                                </span>
                                <span class="text-[9px] text-cyan-400 font-medium">Layout adapts live</span>
                            </div>
                            <div id="modalAdminActiveParticipantsList" class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-52 overflow-y-auto pr-1 flex-1">
                                <div class="col-span-full p-3 rounded-lg bg-black/40 border border-dashed border-gray-800 text-center text-gray-500 text-xs">
                                    Only Admin is currently on stage. Approved guests will appear here with live video & mute controls.
                                </div>
                            </div>
                        </div>

                        <!-- 3. Conference Live Chat & Private DMs -->
                        <div class="bg-black/50 border border-gray-800 rounded-xl p-3 flex flex-col space-y-2">
                            <div class="flex items-center justify-between text-xs pb-1.5 border-b border-gray-800/80">
                                <div class="flex items-center gap-1.5">
                                    <button type="button" onclick="window.switchAdminChatTab('all')" id="btnModalAdminChatTabAll" class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-blue-600 text-white transition-all">All Messages</button>
                                    <button type="button" onclick="window.switchAdminChatTab('private')" id="btnModalAdminChatTabPrivate" class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-gray-800 text-gray-400 hover:text-white transition-all flex items-center gap-1">
                                        <span>🔒 Private (1-on-1)</span>
                                        <span id="modalAdminPrivateMsgBadge" class="hidden w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse"></span>
                                    </button>
                                </div>
                                <span class="text-[9px] text-gray-500">Live Chat</span>
                            </div>
                            <div id="modalAdminChatFeed" class="h-32 overflow-y-auto p-2 rounded-lg bg-black/60 border border-gray-800 text-xs space-y-1.5 flex-1">
                                <div class="text-xs text-gray-500 text-center py-4">No chat messages yet.</div>
                            </div>
                            <div class="flex gap-1.5 pt-1">
                                <input type="text" id="modalAdminChatInput" placeholder="Broadcast chat or reply..." onkeydown="if(event.key==='Enter') window.sendAdminChatMessage();" class="flex-1 bg-gray-900 border border-gray-700 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-gray-500 focus:border-blue-500 outline-none">
                                <button type="button" onclick="window.sendAdminChatMessage()" class="px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition-all flex items-center gap-1 flex-shrink-0">
                                    <span>Send</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Direct WebRTC Controller & Fail-safe Script -->
    <script>
        window.handleVideoTypeChange = function() {
            const typeSelect = document.getElementById('maintenanceVideoType');
            const standardInput = document.getElementById('standardUrlInputBlock');
            const webrtcStudio = document.getElementById('webrtcStudioBlock');
            if (typeSelect && standardInput && webrtcStudio) {
                if (typeSelect.value === 'webrtc') {
                    standardInput.classList.add('hidden');
                    webrtcStudio.classList.remove('hidden');
                } else {
                    standardInput.classList.remove('hidden');
                    webrtcStudio.classList.add('hidden');
                }
            }
        };

        window.selectWebRTCBroadcast = function() {
            const typeSelect = document.getElementById('maintenanceVideoType');
            if (typeSelect) {
                typeSelect.value = 'webrtc';
                window.handleVideoTypeChange();
            }
            if (document.getElementById('maintenanceVideoEnabledToggle')) {
                document.getElementById('maintenanceVideoEnabledToggle').checked = true;
            }
            window.openWebRTCStudio();
        };

        window.closeWebRTCStudio = function() {
            const modal = document.getElementById('webrtcStudioModal');
            if (modal) modal.classList.add('hidden');
        };

        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(window.handleVideoTypeChange, 100);
            setTimeout(window.handleVideoTypeChange, 600);
        });
    </script>

<script>
async function handleBgUpload(e, targetId) {
    const file = e.target.files[0];
    if (!file) return;
    const formData = new FormData();
    formData.append('videoFile', file);
    
    showToast('Uploading file...', 'info');
    try {
        const res = await fetch('/api/admin/maintenance/upload-video', {
            method: 'POST',
            body: formData,
            headers: { 'Authorization': 'Bearer ' + (window.adminToken || '') }
        });
        const data = await res.json();
        if (data.status === 'success') {
            document.getElementById(targetId).value = data.fileUrl;
            document.getElementById(targetId + 'Type').value = file.type.startsWith('image/') ? 'image' : 'video';
            showToast('File uploaded successfully', 'success');
        } else {
            showToast(data.message || 'Upload failed', 'error');
        }
    } catch(err) {
        showToast('Upload error', 'error');
    }
}
</script>
</body>
</html>

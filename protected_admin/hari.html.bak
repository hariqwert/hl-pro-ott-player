        <button type="button" onclick="document.getElementById('bgHeroUpload').click()" class="px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold transition-all whitespace-nowrap"><i data-lucide="upload" class="w-4 h-4 inline"></i> Upload</button>
        <input type="file" id="bgHeroUpload" class="hidden" accept="video/mp4,video/webm,image/jpeg,image/png,image/webp" onchange="handleBgUpload(event, 'bgHero')">

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta name="robots" content="noindex">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AETHERIS CORE | Quantum Matrix Console</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <style>
        :root {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        body {
            background-color: #030712;
            color: #f3f4f6;
        }
        .mono {
            font-family: 'JetBrains Mono', monospace;
        }
        /* Custom Glowing elements */
        .glow-red {
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.15);
        }
        .glow-green {
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);
        }
        .glow-blue {
            box-shadow: 0 0 25px rgba(59, 130, 246, 0.2);
        }
        .glass-card {
            background: rgba(17, 24, 39, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(31, 41, 55, 0.5);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.3);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(156, 163, 175, 0.5);
        }
    </style>
    <link rel="icon" type="image/png" href="stalker_pro_infinity.svg">

    <style id="tv-mobile-base">
    /* TV/Remote D-pad focus ring */
    .tv-focusable:focus, button:focus, a:focus { outline: 2px solid rgba(255,255,255,0.7) !important; outline-offset: 2px !important; }
    /* Mobile touch improvements */
    @media (max-width:768px) { button, a, [role=button] { min-height: 44px; touch-action: manipulation; } }
    </style>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body class="min-h-screen bg-gray-950 text-gray-100 antialiased overflow-x-hidden">
    <!-- 1. LOGIN OVERLAY -->
    <div id="loginView" class="fixed inset-0 z-50 flex items-center justify-center bg-gray-950/90 backdrop-blur-md p-4">
        <div class="glass-card w-full max-w-md rounded-3xl p-8 shadow-2xl glow-red border border-red-500/10">
            <!-- STAGE 1: CREDENTIALS & CAPTCHA -->
            <div id="loginStage1">
                <div class="flex flex-col items-center text-center mb-8">
                    <div class="inline-flex p-4 rounded-2xl bg-red-500/10 text-red-500 mb-4 border border-red-500/20">
                        <i data-lucide="shield-alert" class="w-8 h-8 animate-pulse"></i>
                    </div>
                    <h1 class="text-2xl font-black text-white tracking-tight">STALKER PRO</h1>
                    <p class="text-xs text-red-500 font-bold uppercase tracking-widest mt-1">Stage 1 : Credential Gate</p>
                    <p class="text-gray-400 text-xs mt-2 max-w-xs">Authorized personnel only. Sessions are bound to your active IP address.</p>
                </div>
                <form id="loginForm" class="space-y-4">
                    <div>
                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Admin Username</label>
                        <div class="relative mt-1">
                            <input type="text" id="usernameInput" placeholder="Enter username" required
                                class="w-full bg-gray-900/80 border border-gray-700/80 focus:border-red-500 rounded-2xl p-4 text-sm pl-12 text-white outline-none transition-all focus:ring-4 focus:ring-red-500/10">
                            <i data-lucide="user" class="w-4 h-4 absolute left-4 top-[18px] text-gray-500"></i>
                        </div>
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Admin Password</label>
                        <div class="relative mt-1">
                            <input type="password" id="passwordInput" placeholder="••••••••" required
                                class="w-full bg-gray-900/80 border border-gray-700/80 focus:border-red-500 rounded-2xl p-4 text-sm pl-12 text-white outline-none transition-all focus:ring-4 focus:ring-red-500/10">
                            <i data-lucide="lock" class="w-4 h-4 absolute left-4 top-[18px] text-gray-500"></i>
                        </div>
                    </div>
                    <div id="loginError" class="hidden flex items-center gap-2 p-3 bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-semibold rounded-xl">
                        <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
                        <span id="loginErrorText">Incorrect credentials.</span>
                    </div>
                    
                    <div class="flex justify-center mt-2">
                        <div class="cf-turnstile" data-sitekey="1x00000000000000000000AA" data-theme="dark"></div>
                    </div>

                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 active:scale-[0.98] transition-all py-4 rounded-2xl text-white font-bold flex items-center justify-center gap-2 shadow-lg shadow-red-600/20">
                        <i data-lucide="key-round" class="w-4 h-4"></i>
                        <span>Verify Credentials (Stage 1)</span>
                    </button>
                </form>
            </div>

            <!-- STAGE 2: TWO-WAY IDENTIFICATION & DEVICE BINDING -->
            <div id="loginStage2" class="hidden">
                <div class="flex flex-col items-center text-center mb-6">
                    <div class="inline-flex p-4 rounded-2xl bg-cyan-500/10 text-cyan-400 mb-4 border border-cyan-500/25 shadow-lg shadow-cyan-500/10">
                        <i data-lucide="fingerprint" class="w-8 h-8 animate-pulse"></i>
                    </div>
                    <h2 class="text-2xl font-black text-white tracking-tight">TWO-WAY IDENTIFICATION</h2>
                    <p class="text-xs text-cyan-400 font-bold uppercase tracking-widest mt-1">Stage 2 : Hardware & PIN Binding</p>
                    <p class="text-gray-400 text-xs mt-2 max-w-xs">Credentials verified. Enter your 6-digit Security PIN to bind this device.</p>
                </div>

                <!-- Hardware Security Indicators -->
                <div class="mb-5 p-3.5 bg-gray-900/90 border border-cyan-500/20 rounded-2xl space-y-2 text-xs">
                    <div class="flex items-center justify-between">
                        <span class="text-gray-400 flex items-center gap-1.5 font-medium">
                            <i data-lucide="network" class="w-3.5 h-3.5 text-cyan-400"></i> Bound IP:
                        </span>
                        <span id="stage2BoundIp" class="font-mono text-cyan-300 font-bold">Checking...</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-gray-400 flex items-center gap-1.5 font-medium">
                            <i data-lucide="cpu" class="w-3.5 h-3.5 text-emerald-400"></i> Device Signature:
                        </span>
                        <span id="stage2DeviceFp" class="font-mono text-emerald-300 font-bold truncate max-w-[150px]">Generating...</span>
                    </div>
                    <div class="flex items-center justify-between pt-1 border-t border-gray-800">
                        <span class="text-gray-400 font-medium">Security Protocol:</span>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-cyan-500/15 text-cyan-300 font-extrabold text-[10px] border border-cyan-500/30">
                            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span> 2FA ACTIVE
                        </span>
                    </div>
                </div>

                <form id="pinForm" class="space-y-4">
                    <div>
                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">6-Digit Security PIN</label>
                        <div class="relative mt-1">
                            <input type="password" id="pinInput" maxlength="10" placeholder="••••••" required autocomplete="one-time-code"
                                class="w-full bg-gray-900/80 border border-gray-700/80 focus:border-cyan-500 rounded-2xl p-4 text-center tracking-[0.5em] font-mono text-lg font-black text-white outline-none transition-all focus:ring-4 focus:ring-cyan-500/10">
                            <i data-lucide="key" class="w-4 h-4 absolute left-4 top-[20px] text-gray-500"></i>
                        </div>
                    </div>

                    <div id="pinError" class="hidden flex items-center gap-2 p-3 bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-semibold rounded-xl">
                        <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
                        <span id="pinErrorText">Invalid Security PIN.</span>
                    </div>

                    <button type="submit" class="w-full bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 active:scale-[0.98] transition-all py-4 rounded-2xl text-white font-bold flex items-center justify-center gap-2 shadow-lg shadow-cyan-600/25">
                        <i data-lucide="shield-check" class="w-4 h-4"></i>
                        <span>Verify PIN & Bind Session</span>
                    </button>

                    <button type="button" onclick="cancelStage2()" class="w-full py-2 text-xs text-gray-500 hover:text-gray-300 transition-colors flex items-center justify-center gap-1.5">
                        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                        <span>Cancel & Back to Credentials</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
    <!-- 2. MAIN DASHBOARD CONTENT -->
    <div id="dashboardView" class="hidden flex-1 flex flex-col md:flex-row min-h-screen">
        <!-- MOBILE TOPBAR (< md) -->
        <div class="md:hidden flex items-center justify-between p-4 bg-gray-950 border-b border-gray-800/80 sticky top-0 z-40">
            <div class="flex items-center gap-2.5">
                <div class="p-1.5 rounded-lg bg-gradient-to-tr from-red-600 to-amber-500 text-white shadow-sm">
                    <i data-lucide="terminal" class="w-4 h-4"></i>
                </div>
                <span class="font-extrabold text-white text-sm tracking-tight">AETHERIS ADMIN</span>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="toggleMobileNav()" class="p-2 bg-gray-900 border border-gray-800 text-gray-300 hover:text-white rounded-xl text-xs flex items-center gap-1.5 font-bold">
                    <i data-lucide="menu" class="w-4 h-4"></i>
                    <span>Menu</span>
                </button>
                <button onclick="handleLogout()" class="p-2 text-gray-400 hover:text-red-500 bg-gray-900 border border-gray-800 rounded-xl" title="Logout Session">
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                </button>
            </div>
        </div>

        <!-- SIDEBAR NAVIGATION -->
        <aside id="sidebarNav" class="w-full md:w-72 lg:w-80 bg-gray-950 border-r border-gray-800/80 md:h-screen md:sticky md:top-0 md:overflow-y-auto flex flex-col justify-between shrink-0 hidden md:flex z-30">
            <div>
                <!-- Brand Header (Desktop) -->
                <div class="p-6 border-b border-gray-800/80 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="p-2 rounded-xl bg-gradient-to-tr from-red-600 to-amber-500 text-white shadow-md shadow-red-600/10">
                            <i data-lucide="terminal" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h2 class="font-extrabold text-white text-lg leading-tight tracking-tight">AETHERIS CORE</h2>
                            <p class="text-[9px] text-gray-400 uppercase tracking-widest font-bold">Admin Console</p>
                        </div>
                    </div>
                    <button onclick="handleLogout()" class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-500/10 rounded-lg transition-colors" title="Logout Session">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                    </button>
                </div>
                <!-- Session Security Status Widget -->
                <div class="m-4 p-4 rounded-2xl bg-gray-900/60 border border-gray-800/60 flex flex-col gap-3">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Active Security Link</span>
                        <span class="flex items-center gap-1 text-[9px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
                            <span>Secure</span>
                        </span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400">
                            <i data-lucide="network" class="w-4 h-4"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-[10px] text-gray-500 uppercase font-bold tracking-wider">Client Session IP</p>
                            <p id="securityIpDisplay" class="text-sm font-bold text-white tracking-tight mono truncate">Loading IP...</p>
                        </div>
                    </div>
                    <div class="flex items-center justify-between text-xs pt-1 border-t border-gray-800/40">
                        <div class="flex items-center gap-1.5 text-gray-400">
                            <i data-lucide="activity" class="w-3.5 h-3.5 text-emerald-500 animate-pulse"></i>
                            <span>Heartbeat Loop</span>
                        </div>
                        <span id="heartbeatTimer" class="font-mono text-gray-400 text-[10px] bg-gray-800/80 px-1.5 py-0.5 rounded font-bold">60s</span>
                    </div>
                </div>
                <!-- Navigation Tabs -->
                <nav class="px-3 space-y-1 pb-4">
                    <button onclick="switchTab('overview')" id="tabBtn-overview"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="layout-dashboard" class="w-4.5 h-4.5 text-blue-500"></i>
                            <span>System Overview</span>
                        </div>
                        <span class="text-[10px] text-gray-600 bg-gray-900 px-1.5 py-0.5 rounded border border-gray-800">1</span>
                    </button>
                    <button onclick="switchTab('portals')" id="tabBtn-portals"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="server" class="w-4.5 h-4.5"></i>
                            <span>Portal Manager</span>
                        </div>
                        <span class="text-[10px] text-gray-600 bg-gray-900 px-1.5 py-0.5 rounded border border-gray-800">2 / T</span>
                    </button>
                    <button onclick="switchTab('m3u')" id="tabBtn-m3u"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="folder-archive" class="w-4.5 h-4.5"></i>
                            <span>M3U Local Vault</span>
                        </div>
                        <span class="text-[10px] text-gray-600 bg-gray-900 px-1.5 py-0.5 rounded border border-gray-800">3 / M</span>
                    </button>
                    <button onclick="switchTab('quarantine')" id="tabBtn-quarantine"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="shield-alert" class="w-4.5 h-4.5 text-rose-500"></i>
                            <span>Stream Quarantine</span>
                        </div>
                        <span id="navQuarantineBadge" class="text-[10px] bg-rose-500/20 text-rose-400 px-1.5 py-0.5 rounded font-bold">0 DEAD</span>
                    </button>
                    <button onclick="switchTab('reorganize')" id="tabBtn-reorganize"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="folder-tree" class="w-4.5 h-4.5 text-cyan-400"></i>
                            <span>Sub-section Organizer</span>
                        </div>
                        <span class="text-[10px] text-cyan-400 bg-cyan-500/10 px-1.5 py-0.5 rounded border border-cyan-500/20 font-bold">LIVE</span>
                    </button>
                    <button onclick="switchTab('monitor')" id="tabBtn-monitor"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="activity" class="w-4.5 h-4.5 text-amber-500"></i>
                            <span>Live Monitor</span>
                        </div>
                        <span class="text-[10px] text-gray-600 bg-gray-900 px-1.5 py-0.5 rounded border border-gray-800">4</span>
                    </button>
                    <button onclick="switchTab('analytics')" id="tabBtn-analytics"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="bar-chart-3" class="w-4.5 h-4.5 text-emerald-400"></i>
                            <span>Server Analytics</span>
                        </div>
                        <span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded font-bold uppercase">LIVE</span>
                    </button>
                    <button onclick="switchTab('system')" id="tabBtn-system"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="settings" class="w-4.5 h-4.5"></i>
                            <span>System Maintenance</span>
                        </div>
                        <span class="text-[10px] text-gray-600 bg-gray-900 px-1.5 py-0.5 rounded border border-gray-800">5</span>
                    </button>
                    <button onclick="switchTab('liveevents')" id="tabBtn-liveevents"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="zap" class="w-4.5 h-4.5 text-red-500"></i>
                            <span>Live Events Manager</span>
                        </div>
                    </button>
                    <button onclick="switchTab('sports')" id="tabBtn-sports"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="trophy" class="w-4.5 h-4.5 text-red-500"></i>
                            <span>Sports Manager</span>
                        </div>
                        <span class="text-[10px] text-gray-600 bg-gray-900 px-1.5 py-0.5 rounded border border-gray-800">6</span>
                    </button>
                    <button onclick="switchTab('embedscraper')" id="tabBtn-embedscraper"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="radio" class="w-4.5 h-4.5 text-cyan-400"></i>
                            <span>Embed Scraper & Studio</span>
                        </div>
                        <span class="text-[10px] bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 px-1.5 py-0.5 rounded font-bold uppercase">M3U-Auto</span>
                    </button>
                    <button onclick="switchTab('channelsjson')" id="tabBtn-channelsjson"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="file-json" class="w-4.5 h-4.5 text-amber-400"></i>
                            <span>Channels JSON Studio</span>
                        </div>
                        <span class="text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/30 px-1.5 py-0.5 rounded font-bold uppercase">M3U-JSON</span>
                    </button>
                    <button onclick="switchTab('builder')" id="tabBtn-builder"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="wand-2" class="w-4.5 h-4.5 text-purple-500"></i>
                            <span>Consumet UI Builder</span>
                        </div>
                    </button>
                    <button onclick="window.location.href='index.php'"
                        class="w-full flex items-center justify-between p-3.5 rounded-xl font-bold text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-900/50 mt-4 border-t border-gray-800/40 pt-6">
                        <div class="flex items-center gap-3">
                            <i data-lucide="monitor-play" class="w-4.5 h-4.5 text-emerald-500"></i>
                            <span>Return to Player</span>
                        </div>
                    </button>
                </nav>
            </div>
            <!-- Footer Meta -->
            <div class="p-6 border-t border-gray-800/60 text-center">
                <a href="/index.php" class="inline-flex items-center justify-center gap-2 text-xs text-gray-400 hover:text-white font-bold bg-gray-900/80 hover:bg-gray-900 px-4 py-2.5 rounded-xl border border-gray-800 transition-all w-full">
                    <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                    <span>Return to TV Portal</span>
                </a>
                <p class="text-[9px] text-gray-600 mt-3 mono">STALKER PRO SECURE OS v1.2</p>
            </div>
        </aside>
        <!-- MAIN VIEWPORT -->
        <main class="flex-1 min-w-0 p-4 sm:p-6 md:p-10 overflow-y-auto">
            <!-- TAB 0: SYSTEM OVERVIEW (DASHBOARD) -->
            <div id="tabContent-overview" class="space-y-8 hidden">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-800/60 pb-6">
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight">System Health & Analytics</h1>
                        <p class="text-sm text-gray-400 mt-1">Real-time performance metrics and core system status.</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <button onclick="clearSystemCache()" class="bg-gray-800 hover:bg-gray-700 text-white px-4 py-2.5 rounded-xl border border-gray-700 font-bold text-xs flex items-center gap-2 transition-all">
                            <i data-lucide="trash-2" class="w-4 h-4 text-red-500"></i>
                            <span>Clear Stalker Cache</span>
                        </button>
                    </div>
                </div>
                <!-- STATS BENTO GRID -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- STAT 1: ACTIVE PORTAL -->
                    <div class="glass-card p-6 rounded-2xl border border-gray-800 flex flex-col justify-between group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500 border border-blue-500/20 group-hover:scale-110 transition-transform">
                                <i data-lucide="globe" class="w-6 h-6"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-blue-500/60">Active Source</span>
                        </div>
                        <div>
                            <div id="stat-activePortal" class="text-xl font-black text-white truncate">LOADING...</div>
                            <div class="text-xs text-gray-500 font-medium mt-1 uppercase tracking-tighter">Current Primary API</div>
                        </div>
                    </div>
                    <!-- STAT 2: TOTAL CHANNELS -->
                    <div class="glass-card p-6 rounded-2xl border border-gray-800 flex flex-col justify-between group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500 border border-emerald-500/20 group-hover:scale-110 transition-transform">
                                <i data-lucide="tv-2" class="w-6 h-6"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-emerald-500/60">Resources</span>
                        </div>
                        <div>
                            <div id="stat-totalChannels" class="text-3xl font-black text-white">0</div>
                            <div class="text-xs text-gray-500 font-medium mt-1 uppercase tracking-tighter">Total Indexed Channels</div>
                        </div>
                    </div>
                    <!-- STAT 3: ACTIVE SESSIONS -->
                    <div class="glass-card p-6 rounded-2xl border border-gray-800 flex flex-col justify-between group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-500 border border-amber-500/20 group-hover:scale-110 transition-transform">
                                <i data-lucide="users" class="w-6 h-6"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-amber-500/60">Live Traffic</span>
                        </div>
                        <div>
                            <div id="stat-activeSessions" class="text-3xl font-black text-white">0</div>
                            <div class="text-xs text-gray-500 font-medium mt-1 uppercase tracking-tighter">Concurrent Streams</div>
                        </div>
                    </div>
                    <!-- STAT 4: SECURITY STATUS -->
                    <div class="glass-card p-6 rounded-2xl border border-gray-800 flex flex-col justify-between group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 rounded-xl bg-red-500/10 flex items-center justify-center text-red-500 border border-red-500/20 group-hover:scale-110 transition-transform">
                                <i data-lucide="shield-check" class="w-6 h-6"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-red-500/60">Firewall</span>
                        </div>
                        <div>
                            <div id="stat-blockedIps" class="text-3xl font-black text-white">0</div>
                            <div class="text-xs text-gray-500 font-medium mt-1 uppercase tracking-tighter">Blacklisted Addresses</div>
                        </div>
                    </div>
                </div>
                <!-- SECONDARY ROW -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- SYSTEM LOGS SNIPPET -->
                    <div class="lg:col-span-2 glass-card rounded-2xl border border-gray-800 overflow-hidden flex flex-col min-h-[300px]">
                        <div class="p-5 border-b border-gray-800/60 bg-gray-900/40 flex items-center justify-between">
                            <h3 class="font-bold text-white flex items-center gap-2 text-sm uppercase tracking-widest">
                                <i data-lucide="scroll-text" class="w-4 h-4 text-blue-400"></i>
                                <span>Recent System Activity</span>
                            </h3>
                            <div class="flex items-center gap-2">
                                <div class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></div>
                                <span class="text-[9px] font-bold text-blue-500 uppercase">Live Log</span>
                            </div>
                        </div>
                        <div class="p-4 bg-black/40 flex-1 font-mono text-[11px] text-gray-400 space-y-1 overflow-y-auto" id="dashboard-logs">
                            <div class="text-blue-500/80">[SYSTEM] Initialization complete...</div>
                            <div class="text-gray-600">[AUTH] Secure session verified for Admin</div>
                            <div class="text-emerald-500/80">[API] Connected to primary portal gateway</div>
                        </div>
                    </div>
                    <!-- QUICK ACTIONS -->
                    <div class="glass-card rounded-2xl border border-gray-800 p-6 flex flex-col justify-between">
                        <h3 class="font-bold text-white mb-6 text-sm uppercase tracking-widest border-b border-gray-800 pb-4">Quick Commands</h3>
                        <div class="space-y-3">
                            <button onclick="switchTab('system'); setTimeout(() => { const el = document.getElementById('siteLockForm'); if(el) el.scrollIntoView({behavior:'smooth'}); }, 100);" class="w-full flex items-center justify-between p-4 rounded-xl bg-gray-900/60 hover:bg-gray-800 transition-all border border-gray-800 group">
                                <div class="flex items-center gap-3">
                                    <i data-lucide="lock" class="w-4 h-4 text-cyan-400"></i>
                                    <span class="text-xs font-bold text-gray-300">Site Lock Passcode Gate</span>
                                </div>
                                <span id="quickLockBadge" class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-gray-800 text-gray-400">OFF</span>
                            </button>
                            <button onclick="switchTab('monitor')" class="w-full flex items-center justify-between p-4 rounded-xl bg-gray-900/60 hover:bg-gray-800 transition-all border border-gray-800 group">
                                <div class="flex items-center gap-3">
                                    <i data-lucide="shield-alert" class="w-4 h-4 text-amber-500"></i>
                                    <span class="text-xs font-bold text-gray-300">Review Security Alerts</span>
                                </div>
                                <i data-lucide="chevron-right" class="w-4 h-4 text-gray-600 group-hover:text-white transition-colors"></i>
                            </button>
                            <button onclick="switchTab('system')" class="w-full flex items-center justify-between p-4 rounded-xl bg-gray-900/60 hover:bg-gray-800 transition-all border border-gray-800 group">
                                <div class="flex items-center gap-3">
                                    <i data-lucide="power" class="w-4 h-4 text-red-500"></i>
                                    <span class="text-xs font-bold text-gray-300">Kill Switch Settings</span>
                                </div>
                                <i data-lucide="chevron-right" class="w-4 h-4 text-gray-600 group-hover:text-white transition-colors"></i>
                            </button>
                            <button onclick="window.location.reload()" class="w-full flex items-center justify-between p-4 rounded-xl bg-gray-900/60 hover:bg-gray-800 transition-all border border-gray-800 group">
                                <div class="flex items-center gap-3">
                                    <i data-lucide="refresh-cw" class="w-4 h-4 text-blue-500"></i>
                                    <span class="text-xs font-bold text-gray-300">Force Global Refresh</span>
                                </div>
                                <i data-lucide="chevron-right" class="w-4 h-4 text-gray-600 group-hover:text-white transition-colors"></i>
                            </button>
                        </div>
                        <div class="mt-6 pt-4 border-t border-gray-800 text-center">
                            <p class="text-[10px] text-gray-600 font-bold uppercase tracking-widest">Stalker Pro Panel v2.5</p>
                        </div>
                    </div>
                </div>
            </div>
            <!-- TAB 4: LIVE ACTIVITY MONITOR -->
            <div id="tabContent-monitor" class="space-y-8 hidden">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-800/60 pb-6">
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight">Live Activity Monitor</h1>
                        <p class="text-sm text-gray-400 mt-1">Real-time stream connections, session tracking and IP firewall management.</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <button onclick="loadActivity()" class="bg-amber-600/10 hover:bg-amber-600/20 text-amber-500 px-4 py-2.5 rounded-xl border border-amber-600/20 font-bold text-xs flex items-center gap-2 transition-all">
                            <i data-lucide="refresh-ccw" class="w-4 h-4"></i>
                            <span>Refresh Stream Logs</span>
                        </button>
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-8">
                    <!-- MASTER POWER SWITCH -->
                    <div id="systemPowerCard" class="glass-card rounded-2xl border border-gray-800 p-8 shadow-2xl transition-all duration-500 overflow-hidden relative group">
                        <div class="absolute top-0 right-0 p-8 opacity-5">
                            <i data-lucide="power" class="w-32 h-32 text-white"></i>
                        </div>
                        <div class="relative flex flex-col md:flex-row items-center justify-between gap-8">
                            <div class="flex items-center gap-6">
                                <div id="powerIconContainer" class="w-16 h-16 rounded-2xl flex items-center justify-center transition-all duration-500 shadow-lg">
                                    <i data-lucide="power" id="powerIcon" class="w-8 h-8"></i>
                                </div>
                                <div>
                                    <h2 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
                                        System Network Power: 
                                        <span id="powerStatusText" class="uppercase tracking-widest text-sm bg-gray-800 px-3 py-1 rounded-full border border-gray-700 ml-2">CHECKING...</span>
                                    </h2>
                                    <p class="text-gray-400 text-sm mt-1 max-w-lg">Instantly kill all public access, stream proxies, and frontend views. Only this panel remains active.</p>
                                </div>
                            </div>
                            <button onclick="toggleSystemPower()" id="powerBtn" 
                                class="px-8 py-4 rounded-2xl font-black text-sm tracking-widest flex items-center gap-3 transition-all active:scale-[0.95] shadow-xl">
                                <i data-lucide="power" class="w-5 h-5"></i>
                                <span id="powerBtnText">INITIALIZING...</span>
                            </button>
                        </div>
                        <!-- System Power Music Settings (Enhanced Music System matching music.html) -->
                        <div id="powerMusicSection" class="mt-8 pt-8 border-t border-gray-800 space-y-6">
                            <div class="flex items-center justify-between flex-wrap gap-4">
                                <div class="flex items-center gap-3">
                                    <div class="p-2.5 rounded-xl bg-teal-500/10 border border-teal-500/20 text-teal-400">
                                        <i data-lucide="music" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                            <span>System Offline Lounge Music</span>
                                            <span class="text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-400 border border-indigo-500/30">JioSaavn Audio Engine</span>
                                        </h3>
                                        <p class="text-xs text-gray-400 mt-1">Configure lounge audio, equalizer sound profiles, and multi-source playlists matching music.html.</p>
                                    </div>
                                </div>
                                <a href="/music.html" target="_blank" class="px-4 py-2 rounded-xl bg-indigo-600/30 hover:bg-indigo-600/50 text-indigo-300 border border-indigo-500/30 text-xs font-bold transition-all flex items-center gap-2">
                                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                                    <span>Open Full Music Hub</span>
                                </a>
                            </div>

                            <!-- Source Tabs & Mode selector -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Music Mode</label>
                                    <select id="powerMusicMode" onchange="syncMusicSettings('power')" class="w-full bg-gray-900/60 border border-gray-800 focus:border-teal-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all">
                                        <option value="query">Specific Search Query</option>
                                        <option value="random">Play Random Chill Songs</option>
                                        <option value="playlist">Play Curated Playlist Tracks</option>
                                    </select>
                                </div>
                                <div class="md:col-span-2 space-y-2">
                                    <div class="flex items-center justify-between">
                                        <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Search Provider / Source</label>
                                        <span id="powerActiveSourceBadge" class="text-[9px] font-mono text-teal-400 bg-teal-500/10 px-2 py-0.5 rounded border border-teal-500/20 uppercase font-bold">JioSaavn</span>
                                    </div>
                                    <div class="grid grid-cols-3 gap-1.5 p-1 bg-black/60 rounded-xl border border-white/5 text-[10px] font-bold">
                                        <button type="button" onclick="setAdminSearchSource('saavn', 'power')" id="btn_src_power_saavn" class="flex-1 py-1.5 rounded-lg text-white bg-teal-600 font-bold transition-all">JioSaavn</button>
                                        <button type="button" onclick="setAdminSearchSource('archive', 'power')" id="btn_src_power_archive" class="flex-1 py-1.5 rounded-lg text-gray-400 hover:text-white transition-all">Archive.org</button>
                                        <button type="button" onclick="setAdminSearchSource('itunes', 'power')" id="btn_src_power_itunes" class="flex-1 py-1.5 rounded-lg text-gray-400 hover:text-white transition-all">iTunes</button>
                                        <button type="button" onclick="setAdminSearchSource('curated', 'power')" id="btn_src_power_curated" class="flex-1 py-1.5 rounded-lg text-gray-400 hover:text-white transition-all">Curated</button>
                                        <button type="button" onclick="setAdminSearchSource('youtube', 'power')" id="btn_src_power_youtube" class="flex-1 py-1.5 rounded-lg text-gray-400 hover:text-white transition-all">YouTube</button>
                                        <button type="button" onclick="setAdminSearchSource('upload', 'power')" id="btn_src_power_upload" class="flex-1 py-1.5 rounded-lg text-gray-400 hover:text-white transition-all">Upload</button>
                                    </div>
                                </div>
                            </div>

                            <!-- Search Input & Quick Tags -->
                            <div class="space-y-2">
                                <div class="flex gap-2">
                                    <input type="file" id="powerAudioUpload" accept="audio/*" class="hidden" onchange="handleAdminAudioUpload(event, 'power')">
                                    <input type="text" id="powerMusicQuery" placeholder="Search millions of songs on JioSaavn..."
                                        class="flex-1 bg-gray-900/60 border border-gray-800 focus:border-teal-500 rounded-xl p-3.5 text-sm text-white outline-none transition-all">
                                    <button type="button" onclick="searchAdminMusic('power')" class="bg-teal-600 hover:bg-teal-500 px-5 rounded-xl font-bold text-xs text-black transition-all flex items-center gap-1.5">
                                        <i data-lucide="search" class="w-4 h-4"></i>
                                        <span>Search</span>
                                    </button>
                                </div>
                                <div id="powerQuickTags" class="flex flex-wrap gap-1.5 pt-1">
                                    <button type="button" onclick="clickAdminTag('Top Hits', 'power')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-400 hover:text-white transition-all border border-white/5">Top Hits</button>
                                    <button type="button" onclick="clickAdminTag('Arijit Singh', 'power')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-400 hover:text-white transition-all border border-white/5">Arijit Singh</button>
                                    <button type="button" onclick="clickAdminTag('A.R. Rahman', 'power')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-400 hover:text-white transition-all border border-white/5">A.R. Rahman</button>
                                    <button type="button" onclick="clickAdminTag('Lofi Beats', 'power')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-400 hover:text-white transition-all border border-white/5">Lofi Beats</button>
                                    <button type="button" onclick="clickAdminTag('Alan Walker', 'power')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-400 hover:text-white transition-all border border-white/5">Alan Walker</button>
                                    <button type="button" onclick="clickAdminTag('Synthwave', 'power')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-400 hover:text-white transition-all border border-white/5">Synthwave</button>
                                </div>
                            </div>

                            <!-- Music Preview Deck & EQ Sound Profiler -->
                            <div class="p-4 rounded-xl bg-black/40 border border-white/5 space-y-4">
                                <div class="flex items-center gap-3">
                                    <button type="button" onclick="toggleAdminMusic('power')" class="w-10 h-10 rounded-full bg-teal-500 hover:bg-teal-400 text-black flex items-center justify-center transition-all cursor-pointer shadow-lg shadow-teal-500/20 flex-shrink-0">
                                        <i data-lucide="play" class="w-5 h-5 fill-black" id="powerPlayIcon"></i>
                                        <i data-lucide="pause" class="w-5 h-5 hidden text-black" id="powerPauseIcon"></i>
                                    </button>
                                    <div class="flex-1 overflow-hidden">
                                        <div id="powerMusicTitle" class="text-sm font-bold text-slate-200 truncate">No Track Loaded</div>
                                        <div id="powerMusicArtist" class="text-[10px] text-slate-500 truncate">Search and select a track to preview</div>
                                    </div>
                                    <!-- Volume Hub -->
                                    <div class="flex items-center gap-2 bg-zinc-900/80 px-3 py-1.5 rounded-xl border border-white/5 flex-shrink-0">
                                        <button type="button" onclick="toggleAdminMute('power')" class="text-slate-400 hover:text-white transition-colors">
                                            <i data-lucide="volume-2" class="w-4 h-4" id="powerVolIcon"></i>
                                        </button>
                                        <input type="range" id="powerVolSlider" min="0" max="1" step="0.05" value="1" oninput="setAdminVolume(this.value, 'power')" class="w-16 accent-teal-500 h-1 rounded-full cursor-pointer bg-white/10">
                                    </div>
                                    <button type="button" onclick="saveMusicOnly()" class="bg-emerald-600 hover:bg-emerald-500 px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-emerald-600/10 flex-shrink-0">Save Settings</button>
                                </div>

                                <!-- Progress Timeline Seeker Bar -->
                                <div class="flex items-center gap-3">
                                    <span id="powerCurTime" class="text-[9px] font-mono text-slate-500 font-bold w-8 text-left">0:00</span>
                                    <div class="flex-1 h-1.5 bg-white/10 rounded-full cursor-pointer relative overflow-hidden group" onclick="seekAdminAudio(event, 'power')">
                                        <div id="powerProgressBar" class="h-full bg-gradient-to-r from-teal-500 to-indigo-500 rounded-full w-0 transition-all duration-100"></div>
                                    </div>
                                    <span id="powerTotDur" class="text-[9px] font-mono text-slate-500 font-bold w-8 text-right">0:00</span>
                                </div>

                                <!-- Sound Profiler Equalizer Deck -->
                                <div class="pt-3 border-t border-white/5 space-y-2">
                                    <div class="flex items-center justify-between">
                                        <span class="text-[9px] font-black text-indigo-400 uppercase tracking-widest flex items-center gap-1">
                                            <i data-lucide="sliders" class="w-3 h-3"></i> Sound Profiler Studio Equalizer
                                        </span>
                                        <div class="flex gap-1 text-[8px] font-bold">
                                            <button type="button" onclick="applyAdminEQ('flat', 'power')" class="px-2 py-0.5 rounded bg-indigo-600 text-white border border-indigo-400">Flat</button>
                                            <button type="button" onclick="applyAdminEQ('bass', 'power')" class="px-2 py-0.5 rounded bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white">Bass Boost</button>
                                            <button type="button" onclick="applyAdminEQ('vocal', 'power')" class="px-2 py-0.5 rounded bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white">Vocal Clear</button>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-3 gap-3 pt-1">
                                        <div class="space-y-1">
                                            <div class="flex justify-between text-[8px] font-bold text-slate-400"><span>BASS (60Hz)</span><span id="powerEqBassVal" class="text-teal-400 font-mono">0dB</span></div>
                                            <input type="range" min="-10" max="10" value="0" oninput="setAdminEQBand('bass', this.value, 'power')" class="w-full accent-teal-500 h-1 bg-white/10 rounded-full cursor-pointer">
                                        </div>
                                        <div class="space-y-1">
                                            <div class="flex justify-between text-[8px] font-bold text-slate-400"><span>MID (1kHz)</span><span id="powerEqMidVal" class="text-indigo-400 font-mono">0dB</span></div>
                                            <input type="range" min="-10" max="10" value="0" oninput="setAdminEQBand('mid', this.value, 'power')" class="w-full accent-indigo-500 h-1 bg-white/10 rounded-full cursor-pointer">
                                        </div>
                                        <div class="space-y-1">
                                            <div class="flex justify-between text-[8px] font-bold text-slate-400"><span>TREBLE (10kHz)</span><span id="powerEqTrebleVal" class="text-pink-400 font-mono">0dB</span></div>
                                            <input type="range" min="-10" max="10" value="0" oninput="setAdminEQBand('treble', this.value, 'power')" class="w-full accent-pink-500 h-1 bg-white/10 rounded-full cursor-pointer">
                                        </div>
                                    </div>
                                </div>

                                <div id="powerMusicResults" class="max-h-48 overflow-y-auto space-y-1 custom-scrollbar hidden bg-zinc-950/50 p-2 rounded-xl border border-white/5 text-xs text-slate-300"></div>

                                <!-- Saved Playlist Queue -->
                                <div class="space-y-2 pt-2 border-t border-white/5">
                                    <div class="flex items-center justify-between">
                                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block">Lounge Playlist Queue</span>
                                        <span class="text-[8px] text-teal-400 font-mono">Auto-Sync Active</span>
                                    </div>
                                    <div id="powerSavedPlaylist" class="max-h-36 overflow-y-auto space-y-1 custom-scrollbar bg-zinc-950/50 p-2 rounded-xl border border-white/5">
                                        <div class="text-slate-500 text-center py-2 text-[10px]">No saved tracks</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- ACTIVE SESSIONS -->
                    <div class="glass-card rounded-2xl border border-gray-800 overflow-hidden shadow-2xl">
                        <div class="p-6 border-b border-gray-800/60 bg-gray-900/40 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                                <h3 class="text-lg font-bold text-white">Active Connections</h3>
                            </div>
                            <span id="activeSessionsCount" class="text-[10px] font-bold bg-green-500/10 text-green-500 px-3 py-1 rounded-full border border-green-500/20">0 ONLINE</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <thead class="bg-gray-900/60 text-[10px] uppercase tracking-widest text-gray-500 font-bold border-b border-gray-800">
                                    <tr>
                                        <th class="px-6 py-4">User IP Address</th>
                                        <th class="px-6 py-4">Watching</th>
                                        <th class="px-6 py-4">Start Time</th>
                                        <th class="px-6 py-4">Device/UA</th>
                                        <th class="px-6 py-4 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="activeSessionsList" class="divide-y divide-gray-800/60">
                                    <tr>
                                        <td colspan="5" class="px-6 py-12 text-center text-gray-500 text-sm">
                                            <div class="flex flex-col items-center gap-3 opacity-50">
                                                <i data-lucide="wifi-off" class="w-8 h-8"></i>
                                                <p>No active stream connections detected.</p>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- BLACKLIST MANAGER -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                        <div class="glass-card rounded-2xl border border-gray-800 overflow-hidden shadow-2xl flex flex-col">
                            <div class="p-6 border-b border-gray-800/60 bg-gray-900/40">
                                <h3 class="text-lg font-bold text-white flex items-center gap-3">
                                    <i data-lucide="shield-alert" class="w-5 h-5 text-red-500"></i>
                                    <span>Firewall: Blocked IP List</span>
                                </h3>
                            </div>
                            <div class="p-6 bg-red-500/5 border-b border-red-500/10 flex flex-col md:flex-row items-center gap-4">
                                <div class="flex-1">
                                    <p class="text-xs text-red-400/80 font-medium">Manually block an IP address.</p>
                                </div>
                                <div class="flex items-center gap-2 w-full md:w-auto">
                                    <input type="text" id="manualBlockIp" placeholder="IP Address" 
                                        class="bg-gray-900 border border-red-500/20 focus:border-red-500 rounded-xl px-4 py-2 text-xs text-white outline-none flex-1 md:w-48">
                                    <button onclick="blockIpManually()" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-xl font-bold text-[10px] transition-all flex items-center gap-2">
                                        <i data-lucide="plus" class="w-3 h-3"></i>
                                        <span>Block</span>
                                    </button>
                                </div>
                            </div>
                            <div class="overflow-x-auto flex-1">
                                <table class="w-full text-left">
                                    <thead class="bg-gray-900/60 text-[10px] uppercase tracking-widest text-gray-500 font-bold border-b border-gray-800">
                                        <tr>
                                            <th class="px-6 py-4">Blocked IP</th>
                                            <th class="px-6 py-4 text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="blacklistList" class="divide-y divide-gray-800/60">
                                        <!-- Content loaded via JS -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- SECURITY INCIDENTS / ALERTS -->
                        <div class="glass-card rounded-2xl border border-gray-800 overflow-hidden shadow-2xl flex flex-col">
                            <div class="p-6 border-b border-gray-800/60 bg-gray-900/40 flex items-center justify-between">
                                <h3 class="text-lg font-bold text-white flex items-center gap-3">
                                    <i data-lucide="bell-ring" class="w-5 h-5 text-amber-500 animate-bounce"></i>
                                    <span>Security Alerts</span>
                                </h3>
                                <button onclick="loadIncidents()" class="p-2 text-gray-500 hover:text-white">
                                    <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                                </button>
                            </div>
                            <div class="overflow-x-auto flex-1 max-h-[400px]">
                                <table class="w-full text-left">
                                    <thead class="bg-gray-900/60 text-[10px] uppercase tracking-widest text-gray-500 font-bold border-b border-gray-800">
                                        <tr>
                                            <th class="px-6 py-4">IP / Attempt</th>
                                            <th class="px-6 py-4">Time</th>
                                            <th class="px-6 py-4 text-right">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="incidentsList" class="divide-y divide-gray-800/60">
                                        <tr>
                                            <td colspan="3" class="px-6 py-8 text-center text-gray-600 text-xs italic">
                                                No recent security violations.
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- TAB 1: PORTAL MANAGER -->
            <div id="tabContent-portals" class="space-y-8 hidden">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-800/60 pb-6">
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight">Portal Manager</h1>
                        <p class="text-sm text-gray-400 mt-1">Manage external Stalker Middleware Portals and register MAC address configs.</p>
                    </div>
                </div>
                <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 my-6">
                    <h4 class="text-sm font-bold text-red-400 flex items-center gap-2 mb-2">
                        <i data-lucide="alert-circle" class="w-4 h-4"></i>
                        Live Errors on Screen
                    </h4>
                    <p class="text-xs text-gray-300 mb-2">Any error prompts encountered during initialization or playback come directly from the target portal server. Common issues include:</p>
                    <ul class="list-disc list-inside text-xs text-gray-400 space-y-1">
                        <li><strong class="text-gray-200">Authorization Expired:</strong> Check your subscription date on the success screen.</li>
                        <li><strong class="text-gray-200">Wrong Device ID:</strong> Portals checking signatures strictly will refuse to stream if the Device ID 1/2 or Serial Number doesn't match the original hardware.</li>
                    </ul>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- PORTAL FORM -->
                    <div class="glass-card rounded-2xl p-6 border border-gray-800 space-y-6">
                        <div>
                            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                <i data-lucide="plus" class="w-5 h-5 text-red-500"></i>
                                <span id="formTitle">Register Portal</span>
                            </h3>
                            <p class="text-xs text-gray-400 mt-1">Add a new external Stalker Portal credential.</p>
                        </div>
                        <form id="portalForm" class="space-y-4">
                            <input type="hidden" id="portalEditId">
                            <div class="mb-4">
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Portal Type</label>
                                <select id="portalType" onchange="togglePortalTypeFields()" class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3.5 text-sm text-white outline-none mt-1 transition-all">
                                    <option value="stalker">Stalker Portal (MAC Address based)</option>
                                    <option value="xtream">Xtream Codes Portal (User/Pass based)</option>
                                </select>
                            </div>
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Portal Name</label>
                                    <input type="text" id="portalName" placeholder="My Premium Portal" required
                                        class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Portal URL</label>
                                    <input type="url" id="portalUrl" placeholder="http://example.com:8080/c/" required
                                        class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all">
                                </div>
                            </div>
                            <!-- Xtream Fields -->
                            <div id="xtreamFields" class="hidden grid grid-cols-1 lg:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Xtream Username</label>
                                    <input type="text" id="portalUsername" placeholder="e.g. User123"
                                        class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all mono">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Xtream Password</label>
                                    <input type="password" id="portalPassword" placeholder="e.g. Pass123"
                                        class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all mono">
                                </div>
                            </div>
                            <!-- Stalker Fields -->
                            <div id="stalkerFields" class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">MAC Address</label>
                                    <input type="text" id="portalMac" placeholder="00:1A:79:XX:XX:XX"
                                        class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all mono">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Serial Number (SN)</label>
                                    <input type="text" id="portalSn" placeholder="Auto-generated if empty"
                                        class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all mono">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Device ID 1</label>
                                    <input type="text" id="portalD1" placeholder="Auto-generated if empty"
                                        class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all mono">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Device ID 2</label>
                                    <input type="text" id="portalD2" placeholder="Auto-generated if empty"
                                        class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all mono">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Signature (Sig)</label>
                                    <input type="text" id="portalSig" placeholder="Optional"
                                        class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all mono">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Hardware / Model</label>
                                    <select id="portalModel" class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all">
                                        <option value="MAG250">MAG 250 (Default)</option>
                                        <option value="MAG254">MAG 254</option>
                                        <option value="MAG270">MAG 270</option>
                                        <option value="MAG322">MAG 322</option>
                                        <option value="MAG410">MAG 410</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Software / Image Version</label>
                                    <input type="text" id="portalImageVersion" placeholder="e.g. 218"
                                        class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all mono">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Auth Token</label>
                                    <input type="text" id="portalToken" placeholder="Leave empty to auto-fetch"
                                        class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all mono">
                                </div>
                            </div>
                            <div class="mb-4">
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">User-Agent</label>
                                <input type="text" id="portalUserAgent" placeholder="Default MAG User-Agent"
                                    class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all mono">
                            </div>
                            <div class="flex gap-2 pt-2">
                                <button type="submit" class="flex-1 bg-red-600 hover:bg-red-700 py-3 rounded-xl font-bold text-xs text-white transition-all flex items-center justify-center gap-2 shadow-md">
                                    <i data-lucide="save" class="w-4 h-4"></i>
                                    <span id="savePortalBtnText">Save Portal</span>
                                </button>
                                <button type="button" id="cancelEditBtn" onclick="resetPortalForm()" class="hidden bg-gray-800 hover:bg-gray-700 px-4 rounded-xl font-bold text-xs text-gray-300 transition-colors">
                                    Cancel
                                </button>
                            </div>
                        </form>
                    </div>
                    <!-- PORTALS LIST -->
                    <div class="lg:col-span-2 glass-card rounded-2xl p-6 border border-gray-800 space-y-4">
                        <div>
                            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                <i data-lucide="database" class="w-5 h-5 text-blue-400"></i>
                                <span>Configured Portals</span>
                            </h3>
                            <p class="text-xs text-gray-400 mt-1">Select and manage saved portals on this instance.</p>
                        </div>
                        <div class="overflow-x-auto w-full">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-gray-800 text-gray-400 text-[10px] font-bold uppercase tracking-wider">
                                        <th class="pb-3 pl-2">Portal Name</th>
                                        <th class="pb-3">URL</th>
                                        <th class="pb-3">MAC</th>
                                        <th class="pb-3 text-right pr-2">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="portalsTableBody" class="divide-y divide-gray-800/50 text-sm">
                                    <!-- Portals list injected dynamically -->
                                    <tr>
                                        <td colspan="4" class="py-8 text-center text-gray-500 font-medium">Loading saved portals...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- TAB 2: M3U LOCAL VAULT -->
            <div id="tabContent-m3u" class="space-y-8 hidden">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-800/60 pb-6">
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight">M3U Local Vault</h1>
                        <p class="text-sm text-gray-400 mt-1">Upload and store playlist files securely in local disk storage, isolated from the public webroot.</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- SECURE UPLOAD ZONE -->
                    <div class="glass-card rounded-2xl p-6 border border-gray-800 space-y-6">
                        <div>
                            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                <i data-lucide="upload-cloud" class="w-5 h-5 text-emerald-500"></i>
                                <span>Secure Upload</span>
                            </h3>
                            <p class="text-xs text-gray-400 mt-1">Strict local sandbox isolation.</p>
                        </div>
                        <form id="m3uUploadForm" class="space-y-4">
                            <div>
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Custom Playlist Name</label>
                                <input type="text" id="m3uName" placeholder="E.g., Sports Playlist" required
                                    class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all">
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Import Method</label>
                                <div class="flex gap-2 mt-1 mb-3">
                                    <button type="button" onclick="setAdminM3UMethod('file')" id="adminMethodFile" class="flex-1 py-2 rounded-xl bg-red-600 text-white text-xs font-bold transition-all border border-red-500">File Upload</button>
                                    <button type="button" onclick="setAdminM3UMethod('url')" id="adminMethodUrl" class="flex-1 py-2 rounded-xl bg-white/5 text-gray-400 text-xs font-bold transition-all border border-gray-800">M3U URL</button>
                                </div>
                            </div>
                            <div id="adminM3uFileGroup">
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">Select File (.m3u, .m3u8)</label>
                                <div id="dropZone" class="border-2 border-dashed border-gray-800 hover:border-emerald-500/50 rounded-2xl p-6 text-center cursor-pointer transition-colors bg-gray-900/40 relative mt-1">
                                    <input type="file" id="m3uFileInput" accept=".m3u,.m3u8" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
                                    <div class="flex flex-col items-center gap-2 pointer-events-none">
                                        <i data-lucide="file-plus" class="w-8 h-8 text-gray-500"></i>
                                        <span id="dropZoneText" class="text-xs text-gray-400 font-bold">Drag file here or click to browse</span>
                                        <span class="text-[10px] text-gray-600 font-bold uppercase tracking-wider">MAX 50MB</span>
                                    </div>
                                </div>
                            </div>
                            <div id="adminM3uUrlGroup" class="hidden">
                                <label class="text-[10px] font-bold text-gray-400 uppercase tracking-widest ml-1">M3U Playlist URL</label>
                                <input type="url" id="m3uUrlInput" placeholder="https://example.com/playlist.m3u"
                                    class="w-full bg-gray-900/60 border border-gray-800 focus:border-red-500 rounded-xl p-3 text-sm text-white outline-none mt-1 transition-all">
                            </div>
                            <div id="uploadStatus" class="hidden p-3 rounded-xl border text-xs font-semibold"></div>
                            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 py-3.5 rounded-xl font-bold text-xs text-white transition-all flex items-center justify-center gap-2 shadow-md">
                                <i data-lucide="shield-check" class="w-4 h-4"></i>
                                <span>Upload to Local Storage</span>
                            </button>
                        </form>
                    </div>
                    <!-- PLAYLISTS VAULT LIST -->
                    <div class="lg:col-span-2 glass-card rounded-2xl p-6 border border-gray-800 space-y-4">
                        <div class="flex flex-wrap justify-between items-center gap-2">
                            <div>
                                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                    <i data-lucide="folder-open" class="w-5 h-5 text-amber-500"></i>
                                    <span>Isolated Playlists Vault</span>
                                </h3>
                                <p class="text-xs text-gray-400 mt-1">These files sit strictly outside the public web server directory.</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <!-- Clear Scanned Data Button (wipes scan results, does not delete M3U files) -->
                                <button onclick="clearScannedDiagnosticsData()" class="text-xs bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 text-amber-300 font-bold px-3 py-2 rounded-xl flex items-center gap-1.5 transition-all" title="Clear scanned diagnostic data without deleting M3U playlist files">
                                    <i data-lucide="eraser" class="w-3.5 h-3.5 text-amber-400"></i>
                                    <span>Clear Scanned Data</span>
                                </button>
                                <!-- Switch back to default portal shortcut -->
                                <button onclick="activatePlaylist('portal')" class="text-xs bg-gray-900 hover:bg-gray-800 border border-gray-800 text-gray-300 font-bold px-3 py-2 rounded-xl flex items-center gap-1.5 transition-colors">
                                    <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-blue-400"></i>
                                    <span>Reset to Portal Mode</span>
                                </button>
                            </div>
                        </div>
                        <div class="overflow-x-auto w-full">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-gray-800 text-gray-400 text-[10px] font-bold uppercase tracking-wider">
                                        <th class="pb-3 pl-2">Playlist Details</th>
                                        <th class="pb-3">Channels Count</th>
                                        <th class="pb-3">Local File Location</th>
                                        <th class="pb-3 text-right pr-2">State / Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="m3uTableBody" class="divide-y divide-gray-800/50 text-sm">
                                    <tr>
                                        <td colspan="4" class="py-8 text-center text-gray-500 font-medium">No playlists uploaded yet.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- TAB 3: SYSTEM MAINTENANCE -->
            <div id="tabContent-system" class="space-y-8 hidden">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-800/60 pb-6">
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight">System Maintenance</h1>
                        <p class="text-sm text-gray-400 mt-1">Control instance status, maintenance gates, and run database/cache sweeps.</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    
                    
                    <!-- BACKGROUND VIDEO CONFIG -->
                    <div class="glass-card rounded-2xl p-6 border border-gray-800 space-y-6 lg:col-span-2">
                        <div>
                            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                <i data-lucide="video" class="w-5 h-5 text-indigo-400"></i>
                                <span>Global Background Video Configuration</span>
                            </h3>
                            <p class="text-xs text-gray-400 mt-1">Configure default background videos (YouTube ID, MP4 URL, or M3U8 HLS) for specific modules.</p>
                        </div>
                        <form id="backgroundConfigForm" class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div class="space-y-2 p-3 bg-gray-900/40 border border-gray-800 rounded-xl">
                                <label class="text-[11px] font-bold text-gray-400 uppercase tracking-widest flex items-center gap-1.5"><i data-lucide="home" class="w-3.5 h-3.5"></i> Index / TV Hub Background</label>
                                <select id="bgIndexType" class="w-full bg-gray-900/80 border border-gray-800 focus:border-indigo-500 rounded-lg px-3 py-2 text-xs text-white outline-none mb-2">
                                    <option value="auto">Auto Detect (Direct URL/YouTube)</option>
                                    <option value="youtube">YouTube (Video ID or URL)</option>
                                    <option value="m3u">M3U / M3U8 Live Stream (HLS)</option>
                                </select>
                                <input type="text" id="bgIndex" placeholder="e.g. jfKfPfyJRdk or https://.../bg.mp4" class="w-full bg-gray-900/80 border border-gray-800 rounded-lg px-4 py-2.5 text-sm text-white focus:ring-1 focus:ring-indigo-500 transition-all outline-none">
                            </div>
                            
                            <div class="space-y-2 p-3 bg-gray-900/40 border border-gray-800 rounded-xl">
                                <label class="text-[11px] font-bold text-gray-400 uppercase tracking-widest flex items-center gap-1.5"><i data-lucide="film" class="w-3.5 h-3.5"></i> Consumet Cinema Background</label>
                                <select id="bgConsumetType" class="w-full bg-gray-900/80 border border-gray-800 focus:border-indigo-500 rounded-lg px-3 py-2 text-xs text-white outline-none mb-2">
                                    <option value="auto">Auto Detect (Direct URL/YouTube)</option>
                                    <option value="youtube">YouTube (Video ID or URL)</option>
                                    <option value="m3u">M3U / M3U8 Live Stream (HLS)</option>
                                </select>
                                
    <div class="flex gap-2 w-full mt-2">
        <input type="text" id="bgConsumet" placeholder="URL or Video ID" class="w-full bg-gray-900/80 border border-gray-800 rounded-lg px-4 py-2.5 text-sm text-white focus:ring-1 focus:ring-indigo-500 transition-all outline-none">
        <button type="button" onclick="document.getElementById('bgConsumetUpload').click()" class="px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold transition-all whitespace-nowrap"><i data-lucide="upload" class="w-4 h-4 inline"></i> Upload</button>
        <input type="file" id="bgConsumetUpload" class="hidden" accept="video/mp4,video/webm,image/jpeg,image/png,image/webp" onchange="handleBgUpload(event, 'bgConsumet')">
    </div>

                            </div>
                            
                            <div class="space-y-2 p-3 bg-gray-900/40 border border-gray-800 rounded-xl">
                                <label class="text-[11px] font-bold text-gray-400 uppercase tracking-widest flex items-center gap-1.5"><i data-lucide="music" class="w-3.5 h-3.5"></i> Music Lounge Background</label>
                                <select id="bgMusicType" class="w-full bg-gray-900/80 border border-gray-800 focus:border-indigo-500 rounded-lg px-3 py-2 text-xs text-white outline-none mb-2">
                                    <option value="auto">Auto Detect (Direct URL/YouTube)</option>
                                    <option value="youtube">YouTube (Video ID or URL)</option>
                                    <option value="m3u">M3U / M3U8 Live Stream (HLS)</option>
                                </select>
                                
    <div class="flex gap-2 w-full mt-2">
